---
import '../styles/global.css';
import Icons from '../components/Icons.astro';

interface Props {
	title?: string;
}

const { title = "Consultar Estado | TechHealth Medical Engineering" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content="Consulte el estado de su reparación con su número de ticket." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Security Hardening: Disable base-uri and limit connections to trusted endpoints -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' http://n8n.lenovo.local; form-action 'self' https://wa.me; media-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none';" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">
	</head>
	<body>
		<Icons />
		<slot />
	</body>
</html>
