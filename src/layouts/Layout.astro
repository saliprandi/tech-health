---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "TechHealth Medical Engineering | Técnicos en Electromedicina – Tucumán" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content="Mantenimiento preventivo y correctivo, diagnóstico y reparación de equipos médicos de alta complejidad en San Miguel de Tucumán. TechHealth Medical Engineering." />
		<meta name="keywords" content="electromedicina tucumán, reparación equipos médicos, mantenimiento equipos hospitalarios, técnico electromedicina tucumán" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href="https://techhealth.com.ar" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://saliprandi.github.io/tech-health/" />
		<meta property="og:title" content="TechHealth Medical Engineering | Cuidamos los equipos que cuidan vidas" />
		<meta property="og:description" content="Especialistas en mantenimiento y reparación de equipos médicos de alta complejidad en Tucumán. Ingeniería clínica y microelectrónica de precisión." />
		<meta property="og:image" content="https://saliprandi.github.io/tech-health/og-image.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://saliprandi.github.io/tech-health/" />
		<meta property="twitter:title" content="TechHealth Medical Engineering" />
		<meta property="twitter:description" content="Especialistas en mantenimiento y reparación de equipos médicos de alta complejidad en Tucumán." />
		<meta property="twitter:image" content="https://saliprandi.github.io/tech-health/og-image.jpg" />
		
		<!-- Google Fonts: Optimized to load only used weights (Inter 300/400/500, Plus Jakarta Sans 700/800)
		     to reduce CSS payload and font file requests. -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>
