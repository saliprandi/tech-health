---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import { CONFIG } from '../data/config';

interface Props {
	title?: string;
}

const { title = "TechHealth Medical Engineering | Técnicos en Electromedicina – Tucumán" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content="Mantenimiento preventivo y correctivo, diagnóstico y reparación de equipos médicos de alta complejidad en San Miguel de Tucumán. TechHealth Medical Engineering." />
		<meta name="keywords" content="electromedicina tucumán, reparación equipos médicos, mantenimiento equipos hospitalarios, técnico electromedicina tucumán" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Security Hardening: Disable base-uri and frame-ancestors to prevent injection and clickjacking attacks -->
		<!-- Security: base-uri 'none' prevents <base> tag injection, frame-ancestors 'none' prevents clickjacking -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self' https://wa.me; media-src 'self'; worker-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests;" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), interest-cohort=()" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="preload" href="/logo-name.svg" as="image" type="image/svg+xml" fetchpriority="high" />
		<link rel="canonical" href="https://techhealth.com.ar/" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://techhealth.com.ar/" />
		<meta property="og:title" content="TechHealth Medical Engineering | Cuidamos los equipos que cuidan vidas" />
		<meta property="og:description" content="Especialistas en mantenimiento y reparación de equipos médicos de alta complejidad en Tucumán. Ingeniería clínica y microelectrónica de precisión." />
		<meta property="og:image" content="https://techhealth.com.ar/og-image.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://techhealth.com.ar/" />
		<meta property="twitter:title" content="TechHealth Medical Engineering" />
		<meta property="twitter:description" content="Especialistas en mantenimiento y reparación de equipos médicos de alta complejidad en Tucumán." />
		<meta property="twitter:image" content="https://techhealth.com.ar/og-image.jpg" />
		
		<!-- Network Optimization -->
		<link rel="preconnect" href="https://wa.me" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

		<!-- JSON-LD Structured Data -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": CONFIG.empresa.nombre + " " + CONFIG.empresa.subtitulo,
			"description": CONFIG.empresa.descripcion,
			"url": "https://techhealth.com.ar/",
			"telephone": "+" + CONFIG.contacto.whatsapp,
			"image": "https://techhealth.com.ar/logo-name.svg",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": CONFIG.contacto.direccion,
				"addressLocality": CONFIG.contacto.ciudad_completa,
				"addressCountry": "AR"
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
					"opens": "09:00",
					"closes": "18:00"
				}
			],
			"sameAs": Object.values(CONFIG.redes).filter(Boolean)
		}).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<Icons />
		<slot />
	</body>
</html>
