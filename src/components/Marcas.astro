---
import { CONFIG } from '../data/config';
---

<section id="marcas" class="bg-white py-14 border-y border-border/40 content-visibility-auto">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h3 class="font-heading font-bold text-navy/40 uppercase tracking-[0.15em] text-[12px]">
        Soporte multimarca especializado
      </h3>
    </div>

    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-y-6 gap-x-4 items-center list-none p-0 m-0" role="list" aria-label="Marcas de equipos médicos soportadas">
      {CONFIG.marcas.map(marca => (
        <li class="flex items-center justify-center px-3 py-2 rounded-lg group hover:bg-slate-50/80 focus-within:bg-slate-50/80 transition-all duration-300">
          <a
            href="#contacto"
            class="font-heading font-extrabold text-[17px] text-navy/50 group-hover:text-navy group-focus-within:text-navy focus-visible:text-navy active:scale-95 transition-all duration-300 text-center leading-tight tracking-tighter outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 rounded-md px-2 py-1"
            aria-label={`Consultar servicio técnico para la marca ${marca}`}
            title={`Consultar servicio técnico para la marca ${marca}`}
          >
            <span class="inline-block transform group-hover:scale-105 group-focus-within:scale-105 transition-transform duration-300">
              {marca}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
