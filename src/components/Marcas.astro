---
import { CONFIG } from '../data/config';
---

<section id="marcas" class="bg-white py-14 border-y border-border/40 content-visibility-auto">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h3 class="font-heading font-bold text-navy/40 uppercase tracking-[0.15em] text-[12px]">
        Soporte multimarca especializado
      </h3>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-y-10 gap-x-4 items-center">
      {CONFIG.marcas.map(marca => (
        <div class="flex items-center justify-center px-4 group" aria-label={`Especialistas en ${marca}`}>
          <span class="font-heading font-extrabold text-[17px] text-navy/50 group-hover:text-navy transition-all duration-500 cursor-default select-none text-center leading-tight tracking-tighter transform group-hover:scale-105">
            {marca}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
