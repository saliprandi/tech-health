<button
  id="back-to-top"
  class="fixed bottom-[100px] right-[28px] z-[190] w-12 h-12 bg-white text-navy border border-border rounded-full flex items-center justify-center shadow-lg opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:bg-blue-pale hover:text-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
  aria-label="Volver arriba"
  title="Volver arriba"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
  </svg>
</button>

<script>
  (function() {
    const btn = document.getElementById('back-to-top');
    const scrollThreshold = 500;

    const handleScroll = () => {
      if (!btn) return;
      const isVisible = window.scrollY > scrollThreshold;

      if (isVisible) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    };

    const scrollToTop = () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

      // Focus management: restore focus to main content anchor or skip link
      const mainContent = document.getElementById('main-content');
      if (mainContent) {
        mainContent.focus({ preventScroll: true });
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    btn?.addEventListener('click', scrollToTop);

    // Initial check
    handleScroll();
  })();
</script>
