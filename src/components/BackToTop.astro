---
/**
 * BackToTop.astro
 * Floating button that appears after scroll threshold to return users to the top.
 */
---

<button
  id="back-to-top"
  class="fixed bottom-[100px] right-[28px] z-[190] w-[48px] h-[48px] bg-white border border-border rounded-full flex items-center justify-center text-navy shadow-lg opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:bg-blue-pale hover:text-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
  aria-label="Volver arriba"
  title="Volver arriba"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <use href="#icon-chevron-up" />
  </svg>
</button>

<script>
  (function() {
    const btn = document.getElementById('back-to-top');
    const mainContent = document.getElementById('main-content');
    const SCROLL_THRESHOLD = 500;

    if (!btn) return;

    const handleScroll = () => {
      if (window.scrollY > SCROLL_THRESHOLD) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    };

    const scrollToTop = () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

      // Programmatic focus restoration for accessibility
      if (mainContent) {
        mainContent.focus({ preventScroll: true });
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    btn.addEventListener('click', scrollToTop);

    // Initial check
    handleScroll();
  })();
</script>
