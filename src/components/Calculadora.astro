---
import { CONFIG } from '../data/config';

const { calculadora, contacto } = CONFIG;
---

<section id="estimador" class="py-20 bg-gray-50 border-t border-border content-visibility-auto">
  <div class="container-custom px-[5%]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block py-1 px-3 bg-blue/10 text-blue font-heading font-semibold text-xs rounded-full uppercase tracking-wider mb-3">
        Planificación Preventiva B2B
      </span>
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold text-navy tracking-tight mb-4">
        {calculadora.titulo}
      </h2>
      <p class="font-body text-base md:text-lg text-text-soft">
        {calculadora.subtitulo}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">
      <!-- Input Panel -->
      <div class="lg:col-span-7 bg-white p-6 md:p-8 rounded-2xl border border-border shadow-sm">
        <h3 class="font-heading text-xl font-bold text-navy mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Seleccione la cantidad de equipos por categoría
        </h3>

        <div class="space-y-6">
          {calculadora.tipos_equipos.map((tipo) => (
            <div class="p-4 bg-navy/5 rounded-xl border border-navy/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <label for={`calc-qty-${tipo.id}`} class="font-heading font-bold text-navy text-sm block">
                  {tipo.nombre}
                </label>
                <p class="font-body text-xs text-text-soft mt-0.5">
                  {tipo.ej}
                </p>
              </div>
              <div class="flex items-center gap-2 self-start sm:self-auto">
                <button
                  type="button"
                  data-calc-btn="decrement"
                  data-target={`calc-qty-${tipo.id}`}
                  class="w-8 h-8 rounded-lg bg-white border border-border text-navy font-bold hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-navy outline-none transition-colors flex items-center justify-center text-base"
                  aria-label={`Reducir cantidad para ${tipo.nombre}`}
                >
                  -
                </button>
                <input
                  type="number"
                  id={`calc-qty-${tipo.id}`}
                  data-calc-input
                  data-freq={tipo.frecuencia_meses}
                  data-nombre={tipo.nombre}
                  min="0"
                  max="100"
                  value="0"
                  class="w-14 text-center font-heading font-bold text-navy bg-white border border-border rounded-lg py-1 text-sm focus-visible:ring-2 focus-visible:ring-navy outline-none"
                />
                <button
                  type="button"
                  data-calc-btn="increment"
                  data-target={`calc-qty-${tipo.id}`}
                  class="w-8 h-8 rounded-lg bg-white border border-border text-navy font-bold hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-navy outline-none transition-colors flex items-center justify-center text-base"
                  aria-label={`Aumentar cantidad para ${tipo.nombre}`}
                >
                  +
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Results / Summary Panel -->
      <div class="lg:col-span-5 bg-navy text-white p-6 md:p-8 rounded-2xl shadow-card flex flex-col justify-between h-full min-h-[380px]">
        <div>
          <span class="text-xs uppercase tracking-wider text-blue-light font-heading font-semibold block mb-2">
            Resumen de Estimación
          </span>
          <h3 class="font-heading text-2xl font-bold text-white mb-6">
            Plan Sugerido
          </h3>

          <div class="space-y-4 mb-8">
            <div class="flex justify-between items-center border-b border-white/10 pb-3">
              <span class="text-white/70 text-sm font-body">Total de equipos:</span>
              <span id="calc-total-equipos" class="font-heading font-bold text-xl text-white">0</span>
            </div>
            <div class="flex justify-between items-center border-b border-white/10 pb-3">
              <span class="text-white/70 text-sm font-body">Frecuencia recomendada:</span>
              <span id="calc-frecuencia" class="font-heading font-bold text-sm text-blue-light text-right">Seleccione equipos</span>
            </div>
            <div class="flex justify-between items-center border-b border-white/10 pb-3">
              <span class="text-white/70 text-sm font-body">Revisiones anuales est.:</span>
              <span id="calc-revisiones-anuales" class="font-heading font-bold text-xl text-white">0</span>
            </div>
          </div>

          <p class="text-xs text-white/60 mb-6 leading-relaxed">
            * Estimación técnica orientativa según recomendaciones de fabricantes y normativas de bioingeniería para instituciones de salud.
          </p>
        </div>

        <div>
          <a
            href={`https://wa.me/${contacto.whatsapp.replace(/\D/g, '')}`}
            id="calc-whatsapp-btn"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-blue hover:bg-blue-dark text-white font-heading font-bold text-sm py-3 px-4 rounded-xl transition-colors outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy shadow-md"
          >
            <svg class="calc-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="calc-btn-text">Solicitar Propuesta Preventiva</span>
            <svg class="calc-btn-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initCalc() {
      const inputs = document.querySelectorAll<HTMLInputElement>('[data-calc-input]');
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-calc-btn]');
      const totalEl = document.getElementById('calc-total-equipos');
      const freqEl = document.getElementById('calc-frecuencia');
      const revsEl = document.getElementById('calc-revisiones-anuales');
      const waBtn = document.getElementById('calc-whatsapp-btn') as HTMLAnchorElement | null;

      if (!inputs.length || !totalEl || !freqEl || !revsEl || !waBtn) return () => {};

      const baseWaHref = waBtn.getAttribute('href') || '';

      function recalculate() {
        let totalCount = 0;
        let minFreqMonths = 12;
        let totalEstimatedVisits = 0;
        const summaryParts: string[] = [];

        inputs.forEach(input => {
          const val = Math.max(0, parseInt(input.value || '0', 10));
          input.value = val.toString();
          const freq = parseInt(input.dataset.freq || '12', 10);
          const nombre = input.dataset.nombre || '';

          if (val > 0) {
            totalCount += val;
            if (freq < minFreqMonths) {
              minFreqMonths = freq;
            }
            const visitsForThisType = val * Math.round(12 / freq);
            totalEstimatedVisits += visitsForThisType;
            summaryParts.push(`${val}x ${nombre}`);
          }
        });

        if (totalEl) totalEl.textContent = totalCount.toString();

        if (totalCount === 0) {
          if (freqEl) freqEl.textContent = 'Seleccione equipos';
          if (revsEl) revsEl.textContent = '0';
          if (waBtn) waBtn.setAttribute('href', baseWaHref);
        } else {
          let freqText = `Cada ${minFreqMonths} meses`;
          if (minFreqMonths === 3) freqText = 'Trimestral (Prioridad Alta)';
          else if (minFreqMonths === 4) freqText = 'Cuatrimestral';
          else if (minFreqMonths === 6) freqText = 'Semestral';

          if (freqEl) freqEl.textContent = freqText;
          if (revsEl) revsEl.textContent = `~${totalEstimatedVisits} serv./año`;

          const msg = `Hola TechHealth, requiero una propuesta de mantenimiento preventivo para nuestra institución. Detalle estimado:\n- ${summaryParts.join('\n- ')}\nTotal de equipos: ${totalCount}`;
          const cleanWa = baseWaHref.split('?')[0];
          if (waBtn) waBtn.setAttribute('href', `${cleanWa}?text=${encodeURIComponent(msg)}`);
        }
      }

      function handleInputChange() {
        recalculate();
      }

      function handleButtonClick(e: MouseEvent) {
        const btn = e.currentTarget as HTMLButtonElement;
        const targetId = btn.dataset.target;
        const action = btn.dataset.calcBtn;
        if (!targetId) return;

        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (!input) return;

        let currentVal = parseInt(input.value || '0', 10);
        if (action === 'increment') {
          currentVal += 1;
        } else if (action === 'decrement' && currentVal > 0) {
          currentVal -= 1;
        }

        input.value = currentVal.toString();
        recalculate();
      }

      inputs.forEach(input => {
        input.addEventListener('input', handleInputChange);
        input.addEventListener('change', handleInputChange);
      });

      buttons.forEach(btn => {
        btn.addEventListener('click', handleButtonClick);
      });

      recalculate();

      return () => {
        inputs.forEach(input => {
          input.removeEventListener('input', handleInputChange);
          input.removeEventListener('change', handleInputChange);
        });
        buttons.forEach(btn => {
          btn.removeEventListener('click', handleButtonClick);
        });
      };
    }

    let cleanup = initCalc();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initCalc();
    });
  })();
</script>
