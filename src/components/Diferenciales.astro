---
import { CONFIG } from '../data/config';
---

<section id="diferenciales" class="bg-off-white section-padding content-visibility-auto">
  <div class="container-custom">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Diferenciales</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
        ¿Por qué confiar en TechHealth?
      </h2>
      <p class="font-body text-[16px] text-text-soft">
        Combinamos precisión técnica de vanguardia con un sólido compromiso profesional para garantizar la continuidad de su servicio de salud.
      </p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 list-none p-0 m-0" role="list" aria-label="Diferenciales de la empresa">
      {CONFIG.diferenciales.map((item) => (
        <li class="group bg-white rounded-card p-8 border border-border shadow-sm hover:shadow-card-hover hover:border-blue/30 hover:-translate-y-1 focus-within:shadow-card-hover focus-within:border-blue/30 focus-within:-translate-y-1 focus-within:ring-2 focus-within:ring-blue focus-within:ring-offset-2 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-blue-pale text-blue flex items-center justify-center mb-6 group-hover:scale-110 group-focus-within:scale-110 group-focus-visible:scale-110 transition-transform">
              <svg class="w-8 h-8 group-hover:animate-heartbeat group-focus-within:animate-heartbeat group-focus-visible:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href={`#icon-${item.icono}`} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-[18px] text-navy mb-3">{item.titulo}</h3>
            <p class="font-body font-light text-[14px] text-text-soft leading-relaxed mb-4">
              {item.descripcion}
            </p>
          </div>
          <a
            href="#contacto"
            class="inline-flex items-center gap-1.5 font-body font-medium text-[13px] text-blue hover:text-navy focus-visible:text-navy active:scale-95 transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm"
            aria-label={`Consultar por ${item.titulo}`}
            title={`Consultar por ${item.titulo}`}
          >
            <span>Consultar especialidad</span>
            <svg class="w-3.5 h-3.5 text-blue group-hover:text-navy group-focus-within:text-navy group-focus-visible:text-navy group-hover:translate-x-0.5 group-focus-within:translate-x-0.5 group-focus-visible:translate-x-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>
