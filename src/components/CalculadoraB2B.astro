---
import { CONFIG } from '../data/config';

const calc = CONFIG.calculadoraB2B;
const cleanWhatsapp = CONFIG.contacto.whatsapp.replace(/\D/g, '');
---

<section id="calculadora" class="bg-off-white section-padding content-visibility-auto scroll-mt-20" data-whatsapp={cleanWhatsapp}>
  <div class="container-custom">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Herramienta B2B</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,42px)] leading-[1.2] text-navy mb-4">
        {calc.titulo}
      </h2>
      <p class="font-body text-[16px] text-text-soft">
        {calc.descripcion}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">
      <!-- Selector de equipos -->
      <div class="lg:col-span-7 bg-white rounded-card p-6 sm:p-8 shadow-card border border-border">
        <h3 class="font-heading font-bold text-[20px] text-navy mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Seleccione su equipamiento
        </h3>

        <form id="calc-form" class="space-y-6" onsubmit="return false;">
          {calc.categorias.map((cat) => (
            <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl bg-off-white border border-border/80 gap-4 group/item hover:border-blue/30 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-blue-pale flex items-center justify-center text-blue flex-shrink-0 group-hover/item:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" aria-hidden="true">
                    <use href={`#icon-${cat.icono}`} />
                  </svg>
                </div>
                <div>
                  <label for={`cat-input-${cat.id}`} class="font-heading font-semibold text-[15px] text-navy block cursor-pointer">
                    {cat.nombre}
                  </label>
                  <span class="text-[12px] font-body text-text-soft">Cantidad aproximada en servicio</span>
                </div>
              </div>

              <!-- Controles de incremento/decremento -->
              <div class="flex items-center gap-2 self-end sm:self-auto">
                <button
                  type="button"
                  data-action="decrement"
                  data-target={cat.id}
                  title={`Reducir ${cat.nombre}`}
                  aria-label={`Reducir ${cat.nombre}`}
                  class="calc-btn w-9 h-9 rounded-lg bg-white border border-border text-navy hover:bg-navy hover:text-white active:scale-95 transition-all flex items-center justify-center font-bold text-[18px] focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 outline-none"
                >
                  -
                </button>
                <input
                  type="number"
                  id={`cat-input-${cat.id}`}
                  data-cat-id={cat.id}
                  data-cat-name={cat.nombre}
                  value={cat.defecto}
                  min={cat.min}
                  max={cat.max}
                  class="calc-input w-16 h-9 text-center bg-white border border-border rounded-lg font-heading font-bold text-navy text-[16px] focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 outline-none"
                  aria-label={`Cantidad de ${cat.nombre}`}
                />
                <button
                  type="button"
                  data-action="increment"
                  data-target={cat.id}
                  title={`Aumentar ${cat.nombre}`}
                  aria-label={`Aumentar ${cat.nombre}`}
                  class="calc-btn w-9 h-9 rounded-lg bg-white border border-border text-navy hover:bg-navy hover:text-white active:scale-95 transition-all flex items-center justify-center font-bold text-[18px] focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 outline-none"
                >
                  +
                </button>
              </div>
            </div>
          ))}
        </form>
      </div>

      <!-- Resumen y Recomendación -->
      <div class="lg:col-span-5 bg-navy text-white rounded-card p-6 sm:p-8 shadow-xl border border-white/10 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue/20 text-blue-light font-heading text-[12px] font-bold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-blue-light animate-pulse"></span>
            Diagnóstico Estimado
          </div>

          <div class="mb-6 pb-6 border-b border-white/10">
            <div class="text-[13px] font-body text-white/70 mb-1">Total de Equipos a Proteger</div>
            <div id="calc-total-equipos" class="font-heading font-extrabold text-[36px] text-white">0 unidades</div>
          </div>

          <div class="space-y-4 mb-8">
            <div>
              <div class="text-[13px] font-body text-white/70 mb-1">Plan Técnico Recomendado</div>
              <div id="calc-plan-nombre" class="font-heading font-bold text-[20px] text-blue-light">Mantenimiento Preventivo Programado</div>
            </div>

            <div>
              <div class="text-[13px] font-body text-white/70 mb-1">Frecuencia de Inspección</div>
              <div id="calc-frecuencia" class="font-body font-medium text-[15px] text-white">Trimestral (4 revisiones al año)</div>
            </div>
          </div>

          <!-- Beneficios incluidos -->
          <div class="mb-8">
            <div class="text-[13px] font-heading font-bold text-white/80 uppercase tracking-wider mb-3">Beneficios Incluidos</div>
            <ul class="space-y-2">
              {calc.beneficios.map((b) => (
                <li class="flex items-start gap-2 text-[13px] font-body text-white/80">
                  <svg class="w-4 h-4 text-blue-light flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Botón directo WhatsApp prellenado -->
        <div>
          <a
            href={`https://wa.me/${cleanWhatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            id="calc-wa-cta"
            title="Solicitar propuesta formal por WhatsApp"
            aria-label="Solicitar propuesta formal por WhatsApp para su parque de equipos"
            class="group w-full inline-flex items-center justify-center gap-2 bg-blue hover:bg-blue-light text-white hover:text-navy font-heading font-bold py-4 px-6 rounded-lg active:scale-95 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy outline-none shadow-md"
          >
            <svg class="w-5 h-5 fill-current group-hover:scale-110 transition-transform" aria-hidden="true">
              <use href="#icon-whatsapp" />
            </svg>
            <span>Solicitar Propuesta Formal</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Live Region para Lectores de Pantalla -->
    <div id="calc-aria-announcement" class="sr-only" aria-live="polite"></div>
  </div>
</section>

<script>
  (function() {
    function initCalc() {
      const sec = document.getElementById('calculadora');
      const inputs = document.querySelectorAll('.calc-input') as NodeListOf<HTMLInputElement>;
      const btns = document.querySelectorAll('.calc-btn') as NodeListOf<HTMLButtonElement>;
      const totalEl = document.getElementById('calc-total-equipos');
      const planEl = document.getElementById('calc-plan-nombre');
      const frecEl = document.getElementById('calc-frecuencia');
      const waBtn = document.getElementById('calc-wa-cta') as HTMLAnchorElement | null;
      const announcement = document.getElementById('calc-aria-announcement');

      if (!sec || !inputs.length || !totalEl || !planEl || !frecEl || !waBtn) return;

      const waNum = sec.getAttribute('data-whatsapp') || '5493815658239';

      const updateCalculation = () => {
        let total = 0;
        const details: string[] = [];

        inputs.forEach((inp) => {
          let val = parseInt(inp.value, 10);
          if (isNaN(val) || val < 0) val = 0;
          const max = parseInt(inp.getAttribute('max') || '100', 10);
          if (val > max) val = max;
          inp.value = val.toString();

          total += val;
          if (val > 0) {
            const catName = inp.getAttribute('data-cat-name') || 'Equipos';
            details.push(`${val} ${catName}`);
          }
        });

        // Actualizar UI
        totalEl.textContent = `${total} ${total === 1 ? 'unidad' : 'unidades'}`;

        let planNombre = 'Plan Básico Muestral';
        let frecuencia = 'Semestral (2 revisiones al año)';

        if (total === 0) {
          planNombre = 'Sin selección de equipos';
          frecuencia = 'Seleccione al menos 1 equipo para ver recomendación';
        } else if (total <= 5) {
          planNombre = 'Plan Preventivo Estándar';
          frecuencia = 'Semestral (2 revisiones integrales al año)';
        } else if (total <= 15) {
          planNombre = 'Plan Preventivo Intensivo B2B';
          frecuencia = 'Trimestral (4 revisiones al año + prioridad)';
        } else {
          planNombre = 'Plan de Ingeniería Clínica Integral';
          frecuencia = 'Mensual / Bimensual + Guardia técnica prioritaria';
        }

        planEl.textContent = planNombre;
        if (frecEl) frecEl.textContent = frecuencia;

        // Actualizar URL WhatsApp pre-llenada
        const summaryText = details.length > 0 ? details.join(', ') : 'Ninguno seleccionado';
        const msg = `Hola TechHealth! Quisiera solicitar una propuesta formal para mi institución. Parque estimado: ${summaryText} (Total: ${total} unidades). Recomendación estimada: ${planNombre}.`;

        waBtn.setAttribute(
          'href',
          `https://wa.me/${waNum}?text=${encodeURIComponent(msg)}`
        );

        if (announcement) {
          announcement.textContent = `Actualizado: Total de ${total} equipos. Plan recomendado: ${planNombre}.`;
        }
      };

      // Action handlers
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          const action = btn.getAttribute('data-action');
          if (!targetId) return;

          const input = document.getElementById(`cat-input-${targetId}`) as HTMLInputElement | null;
          if (!input) return;

          let val = parseInt(input.value, 10);
          if (isNaN(val)) val = 0;

          if (action === 'increment') val += 1;
          else if (action === 'decrement') val = Math.max(0, val - 1);

          input.value = val.toString();
          updateCalculation();
        });

        btn.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            btn.click();
          }
        });
      });

      inputs.forEach((inp) => {
        inp.addEventListener('input', updateCalculation);
      });

      updateCalculation();
    }

    initCalc();
    document.addEventListener('astro:after-swap', initCalc);
  })();
</script>
