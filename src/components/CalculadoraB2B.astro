---
import { CONFIG } from '../data/config';
---

<section id="calculadora" class="py-20 bg-navy text-white scroll-mt-20 relative overflow-hidden" aria-labelledby="calc-heading">
  <!-- Dynamic subtle background glowing accents -->
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-blue/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-light/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-custom px-[5%] relative z-10">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="inline-block py-1 px-3 rounded-full bg-blue/20 text-blue-light text-[13px] font-heading font-semibold uppercase tracking-wider mb-4 border border-blue/30">
        Estimador de Mantenimiento B2B
      </span>
      <h2 id="calc-heading" class="font-heading font-extrabold text-[28px] sm:text-[36px] text-white tracking-tight leading-tight mb-4">
        Calcule la Cobertura Óptima para su Institución de Salud
      </h2>
      <p class="font-body text-[15px] sm:text-[16px] text-text-muted max-w-2xl mx-auto">
        Obtenga una sugerencia personalizada de frecuencia preventiva e insumos recomendados según su parque de equipamiento médico en Tucumán y el NOA.
      </p>
    </div>

    <div class="max-w-4xl mx-auto bg-navy-light/90 border border-border/20 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-2xl">
      <form id="calc-form" class="space-y-8" aria-label="Calculadora de Plan de Mantenimiento" onsubmit="return false;">

        <!-- Tipo de Institución -->
        <div class="group/select flex flex-col gap-2">
          <label for="calc-institucion" class="font-heading font-bold text-[14px] sm:text-[15px] text-gray-200 group-focus-within/select:text-blue-light transition-colors">
            Tipo de Institución Médica
          </label>
          <div class="relative">
            <select
              id="calc-institucion"
              class="w-full bg-navy border border-border/40 rounded-xl px-4 py-3 text-[14px] sm:text-[15px] text-white focus:outline-none focus:ring-2 focus:ring-blue-light focus:border-transparent transition-all appearance-none cursor-pointer pr-10"
              title="Seleccione el tipo de institución de salud"
            >
              {CONFIG.calculadora.tiposInstitucion.map(inst => (
                <option value={inst.id} class="bg-navy text-white">{inst.nombre}</option>
              ))}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-text-muted" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Cantidad por Categoría de Equipo -->
        <div class="space-y-4">
          <h3 class="font-heading font-semibold text-[15px] text-gray-200 border-b border-border/20 pb-2">
            Inventario Estimado por Categoría
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {CONFIG.calculadora.categoriasEquipos.map(cat => (
              <div class="group/field bg-navy/60 border border-border/30 rounded-xl p-4 flex flex-col justify-between hover:border-blue/50 focus-within:border-blue-light focus-within:ring-1 focus-within:ring-blue-light transition-all">
                <label for={`calc-cat-${cat.id}`} class="font-body text-[13px] sm:text-[14px] text-text-muted group-focus-within/field:text-blue-light transition-colors mb-2">
                  {cat.nombre}
                </label>
                <div class="flex items-center gap-3">
                  <input
                    type="number"
                    id={`calc-cat-${cat.id}`}
                    data-cat-id={cat.id}
                    min="0"
                    max="500"
                    value="0"
                    class="calc-input w-full bg-navy border border-border/40 rounded-lg px-3 py-2 text-[14px] text-white text-center focus:outline-none focus:ring-2 focus:ring-blue-light transition-all"
                    title={`Cantidad de equipos para ${cat.nombre}`}
                  />
                  <span class="text-[12px] text-text-muted font-body">unidades</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Resultado Calculado -->
        <div id="calc-result" class="bg-gradient-to-r from-blue/20 via-navy to-blue/10 border border-blue/40 rounded-xl p-6 relative overflow-hidden" aria-live="polite" aria-atomic="true">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="space-y-2 text-center md:text-left">
              <span class="text-[12px] font-heading font-semibold uppercase tracking-wider text-blue-light">
                Recomendación Técnica Estimada
              </span>
              <h4 id="calc-plan-title" class="font-heading font-bold text-[20px] sm:text-[22px] text-white">
                Plan Preventivo Básica
              </h4>
              <p id="calc-plan-desc" class="font-body text-[14px] text-text-muted max-w-lg">
                Frecuencia recomendada: Inspecciones semestrales programadas y soporte técnico prioritario.
              </p>
            </div>

            <!-- WhatsApp Direct Action -->
            <a
              id="calc-whatsapp-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 bg-blue text-white font-heading font-bold text-[14px] py-3.5 px-6 rounded-xl hover:bg-blue-light transition-all duration-300 shadow-lg hover:shadow-blue/25 active:scale-95 outline-none focus-visible:ring-2 focus-visible:ring-blue-light focus-visible:ring-offset-2 focus-visible:ring-offset-navy shrink-0"
              title="Solicitar propuesta personalizada por WhatsApp"
            >
              <svg class="calc-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="calc-btn-text">Solicitar Cotización</span>
              <svg class="w-4 h-4 text-white/80 group-hover:translate-x-1 group-focus-visible:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>

      </form>
    </div>
  </div>

  <div id="calc-announcement" class="sr-only" aria-live="polite"></div>
</section>

<script>
  import { CONFIG } from '../data/config';

  function initCalculadora() {
    const instSelect = document.getElementById('calc-institucion') as HTMLSelectElement | null;
    const inputs = document.querySelectorAll('.calc-input') as NodeListOf<HTMLInputElement>;
    const planTitle = document.getElementById('calc-plan-title');
    const planDesc = document.getElementById('calc-plan-desc');
    const whatsappBtn = document.getElementById('calc-whatsapp-btn') as HTMLAnchorElement | null;
    const announcement = document.getElementById('calc-announcement');

    if (!instSelect || !planTitle || !planDesc || !whatsappBtn) return () => {};

    const updateCalculation = () => {
      const instId = instSelect.value;
      const instInfo = CONFIG.calculadora.tiposInstitucion.find(i => i.id === instId);

      let totalPonderado = 0;
      let totalEquipos = 0;
      const resumenEquipos: string[] = [];

      inputs.forEach(input => {
        const catId = input.getAttribute('data-cat-id');
        const cantidad = parseInt(input.value, 10) || 0;
        const catInfo = CONFIG.calculadora.categoriasEquipos.find(c => c.id === catId);

        if (catInfo && cantidad > 0) {
          totalEquipos += cantidad;
          totalPonderado += cantidad * catInfo.ponderacion;
          resumenEquipos.push(`${cantidad} ${catInfo.nombre.split(' (')[0]}`);
        }
      });

      let plan = "Plan Básico de Inspección";
      let frecuencia = "Visitas semestrales programadas con informe de calibración.";

      if (totalPonderado >= 30) {
        plan = "Plan Integral de Alta Complejidad";
        frecuencia = "Revisiones mensuales, respuesta de emergencia prioritaria 24h e informes continuos de trazabilidad.";
      } else if (totalPonderado >= 12) {
        plan = "Plan Preventivo Trimestral";
        frecuencia = "Inspecciones trimestrales con calibración de parámetros y descuento en repuestos.";
      }

      planTitle.textContent = plan;
      planDesc.textContent = `Sugerencia para ${instInfo?.nombre || 'su institución'}: ${frecuencia}`;

      const textoWs = `Hola TechHealth! Quisiera consultar una propuesta técnica de mantenimiento para ${instInfo?.nombre || 'nuestra institución'}.\n\n` +
        `Detalle estimado de equipos (${totalEquipos} unidades):\n` +
        (resumenEquipos.length > 0 ? resumenEquipos.map(r => `• ${r}`).join('\n') : '• Sin especificar aún') +
        `\n\nPlan sugerido: ${plan}`;

      const cleanPhone = CONFIG.contacto.whatsapp.replace(/\D/g, '');
      const wsUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(textoWs)}`;
      whatsappBtn.setAttribute('href', wsUrl);

      if (announcement) {
        announcement.textContent = `Cálculo actualizado: ${plan} sugerido para ${instInfo?.nombre}.`;
      }
    };

    const handleWhatsappClick = (e: MouseEvent) => {
      e.preventDefault();
      const href = whatsappBtn.getAttribute('href');
      if (!href || href === '#') return;

      // Safe URL verification
      if (/^(javascript|data|vbscript):/i.test(href)) return;

      const span = whatsappBtn.querySelector('.calc-btn-text');
      const spinner = whatsappBtn.querySelector('.calc-spinner');
      const icon = whatsappBtn.querySelector('svg:last-child');

      whatsappBtn.setAttribute('aria-busy', 'true');
      whatsappBtn.setAttribute('aria-disabled', 'true');
      if (span) span.textContent = 'Redirigiendo...';
      if (spinner) spinner.classList.remove('hidden');
      if (icon) icon.classList.add('hidden');
      whatsappBtn.classList.add('opacity-70', 'pointer-events-none');

      const openedWin = window.open(href, '_blank');
      if (openedWin) {
        openedWin.opener = null;
      } else {
        window.location.href = href;
      }

      setTimeout(() => {
        whatsappBtn.removeAttribute('aria-busy');
        whatsappBtn.removeAttribute('aria-disabled');
        if (span) span.textContent = 'Solicitar Cotización';
        if (spinner) spinner.classList.add('hidden');
        if (icon) icon.classList.remove('hidden');
        whatsappBtn.classList.remove('opacity-70', 'pointer-events-none');
      }, 3000);
    };

    instSelect.addEventListener('change', updateCalculation);
    inputs.forEach(input => {
      input.addEventListener('input', updateCalculation);
    });
    whatsappBtn.addEventListener('click', handleWhatsappClick);

    // Initial run
    updateCalculation();

    return () => {
      instSelect.removeEventListener('change', updateCalculation);
      inputs.forEach(input => {
        input.removeEventListener('input', updateCalculation);
      });
      whatsappBtn.removeEventListener('click', handleWhatsappClick);
    };
  }

  let cleanup = initCalculadora();
  document.addEventListener('astro:after-swap', () => {
    if (cleanup) cleanup();
    cleanup = initCalculadora();
  });
</script>
