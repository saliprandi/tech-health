---
import { CONFIG } from '../data/config';

const { calculadoraB2B } = CONFIG;
---

<section id="calculadora" class="py-20 bg-slate-50 border-t border-border scroll-mt-20 relative overflow-hidden" aria-labelledby="calc-heading">
  <div class="container-custom px-[5%] max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue/10 text-blue font-heading font-semibold text-[13px] mb-3">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 002-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Herramienta B2B</span>
      </div>
      <h2 id="calc-heading" class="font-heading font-bold text-3xl md:text-4xl text-navy tracking-tight mb-4">
        {calculadoraB2B.titulo}
      </h2>
      <p class="font-body text-text-soft text-base md:text-lg leading-relaxed">
        {calculadoraB2B.subtitulo}
      </p>
    </div>

    <!-- Interactive Container -->
    <div class="bg-white rounded-2xl border border-border p-6 md:p-8 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Controls Column (Left) -->
        <div class="lg:col-span-7 space-y-6">

          <!-- Step 1: Categoría de Equipamiento -->
          <div>
            <label id="cat-label" class="block font-heading font-bold text-navy text-sm uppercase tracking-wider mb-3">
              1. Seleccione la categoría principal de su equipamiento:
            </label>
            <div role="radiogroup" aria-labelledby="cat-label" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {calculadoraB2B.categorias.map((cat, idx) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={idx === 0 ? "true" : "false"}
                  tabindex="0"
                  data-cat-id={cat.id}
                  class={`calc-cat-btn group/card text-left p-4 rounded-xl border transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 cursor-pointer ${
                    idx === 0
                      ? "border-navy bg-navy/5 shadow-sm"
                      : "border-border hover:border-navy/50 hover:bg-slate-50"
                  }`}
                  title={`Seleccionar categoría: ${cat.nombre}`}
                >
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-heading font-bold text-sm text-navy group-hover/card:text-blue transition-colors">
                      {cat.nombre}
                    </span>
                    <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full border ${cat.badgeColor}`}>
                      {cat.criticidad}
                    </span>
                  </div>
                  <p class="font-body text-xs text-text-soft line-clamp-2">
                    {cat.ejemplos}
                  </p>
                </button>
              ))}
            </div>
          </div>

          <!-- Step 2: Cantidad de Equipos -->
          <div>
            <label id="rango-label" class="block font-heading font-bold text-navy text-sm uppercase tracking-wider mb-3">
              2. Volumen aproximado del parque de equipos:
            </label>
            <div role="radiogroup" aria-labelledby="rango-label" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {calculadoraB2B.rangosEquipos.map((rango, idx) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={idx === 1 ? "true" : "false"}
                  tabindex="0"
                  data-rango-id={rango.id}
                  class={`calc-rango-btn text-left p-3.5 rounded-xl border transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 cursor-pointer ${
                    idx === 1
                      ? "border-navy bg-navy/5 shadow-sm"
                      : "border-border hover:border-navy/50 hover:bg-slate-50"
                  }`}
                  title={`Seleccionar volumen: ${rango.label}`}
                >
                  <span class="block font-heading font-bold text-sm text-navy mb-0.5">
                    {rango.label}
                  </span>
                  <span class="font-body text-xs text-text-soft block leading-tight">
                    {rango.descripcion}
                  </span>
                </button>
              ))}
            </div>
          </div>

        </div>

        <!-- Result Box Column (Right) -->
        <div class="lg:col-span-5 flex flex-col">
          <div class="bg-navy text-white rounded-xl p-6 flex-1 flex flex-col justify-between shadow-md relative overflow-hidden">
            <!-- Background accent SVG -->
            <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none" aria-hidden="true">
              <svg class="w-64 h-64 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" />
              </svg>
            </div>

            <div class="relative z-10">
              <div class="flex items-center gap-2 text-blue-light font-heading text-xs uppercase tracking-wider font-semibold mb-4">
                <svg class="w-4 h-4 text-blue-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Plan de Mantenimiento Recomendado</span>
              </div>

              <!-- Frecuencia -->
              <div class="mb-5">
                <span class="text-white/70 font-body text-xs uppercase tracking-wider block mb-1">
                  Frecuencia de Mantenimiento Preventivo:
                </span>
                <p id="res-frecuencia" class="font-heading font-bold text-xl text-white">
                  Trimestral (4 veces al año)
                </p>
              </div>

              <!-- Recomendaciones Técnicas -->
              <div class="mb-6 bg-white/10 rounded-lg p-4 backdrop-blur-sm border border-white/10">
                <span class="text-blue-light font-heading text-xs font-semibold uppercase tracking-wider block mb-1">
                  Enfoque Técnico Recomendado:
                </span>
                <p id="res-recomendacion" class="font-body text-sm text-slate-100 leading-relaxed">
                  Requiere inspecciones periódicas de seguridad eléctrica, verificación de alarmas y calibración exhaustiva de parámetros vitales.
                </p>
              </div>
            </div>

            <!-- CTA -->
            <div class="relative z-10 pt-4 border-t border-white/10">
              <a
                id="calc-wa-btn"
                href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-center gap-2.5 bg-blue hover:bg-blue-dark text-white font-heading font-bold text-sm py-3.5 px-5 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.98] outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
                title="Solicitar propuesta técnica personalizada por WhatsApp"
              >
                <svg class="calc-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span id="calc-wa-text">Solicitar Propuesta Personalizada</span>
                <svg class="calc-wa-icon w-4 h-4 text-white/80 group-hover:translate-x-1 group-focus-visible:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- Screen Reader Live Region for Announcements -->
    <div id="calc-announcement" class="sr-only" aria-live="polite"></div>
  </div>
</section>

<script>
  import { CONFIG } from '../data/config';

  (function() {
    function initCalc() {
      const catBtns = document.querySelectorAll('.calc-cat-btn');
      const rangoBtns = document.querySelectorAll('.calc-rango-btn');
      const resFrecuencia = document.getElementById('res-frecuencia');
      const resRecomendacion = document.getElementById('res-recomendacion');
      const waBtn = document.getElementById('calc-wa-btn') as HTMLAnchorElement | null;
      const waText = document.getElementById('calc-wa-text');
      const waSpinner = document.querySelector('.calc-spinner');
      const waIcon = document.querySelector('.calc-wa-icon');
      const announcement = document.getElementById('calc-announcement');

      if (!catBtns.length || !rangoBtns.length || !resFrecuencia || !resRecomendacion || !waBtn) return;

      const frecuenciaEl = resFrecuencia;
      const recomendacionEl = resRecomendacion;
      const btnEl = waBtn;

      const categorias = CONFIG.calculadoraB2B.categorias;
      const rangos = CONFIG.calculadoraB2B.rangosEquipos;
      const whatsappNum = CONFIG.contacto.whatsapp.replace(/\D/g, '');

      let activeCatId = categorias[0].id;
      let activeRangoId = rangos[1].id; // Default "6 a 15 equipos"

      function updateCalculation() {
        const selectedCat = categorias.find(c => c.id === activeCatId) || categorias[0];
        const selectedRango = rangos.find(r => r.id === activeRangoId) || rangos[1];

        // Update DOM displays
        frecuenciaEl.textContent = selectedCat.frecuencia;
        recomendacionEl.textContent = selectedCat.recomendacion;

        // Formulate pre-filled WhatsApp message
        const msg = encodeURIComponent(
          `Hola TechHealth, quisiera solicitar una propuesta de mantenimiento preventivo para nuestra institución.\n\n` +
          `• Categoría: ${selectedCat.nombre}\n` +
          `• Cantidad estimada: ${selectedRango.label} (${selectedRango.descripcion})\n` +
          `• Frecuencia recomendada: ${selectedCat.frecuencia}`
        );

        btnEl.href = `https://wa.me/${whatsappNum}?text=${msg}`;

        // Screen reader announcement
        if (announcement) {
          announcement.textContent = `Plan actualizado para ${selectedCat.nombre}, parque de ${selectedRango.label}. Frecuencia recomendada: ${selectedCat.frecuencia}.`;
        }
      }

      function selectCat(catBtn: HTMLButtonElement) {
        catBtns.forEach(btn => {
          btn.setAttribute('aria-checked', 'false');
          btn.classList.remove('border-navy', 'bg-navy/5', 'shadow-sm');
          btn.classList.add('border-border');
        });

        catBtn.setAttribute('aria-checked', 'true');
        catBtn.classList.remove('border-border');
        catBtn.classList.add('border-navy', 'bg-navy/5', 'shadow-sm');

        activeCatId = catBtn.dataset.catId || categorias[0].id;
        updateCalculation();
      }

      function selectRango(rangoBtn: HTMLButtonElement) {
        rangoBtns.forEach(btn => {
          btn.setAttribute('aria-checked', 'false');
          btn.classList.remove('border-navy', 'bg-navy/5', 'shadow-sm');
          btn.classList.add('border-border');
        });

        rangoBtn.setAttribute('aria-checked', 'true');
        rangoBtn.classList.remove('border-border');
        rangoBtn.classList.add('border-navy', 'bg-navy/5', 'shadow-sm');

        activeRangoId = rangoBtn.dataset.rangoId || rangos[1].id;
        updateCalculation();
      }

      catBtns.forEach(btn => {
        btn.addEventListener('click', () => selectCat(btn as HTMLButtonElement));
        btn.addEventListener('keydown', (e: Event) => {
          const kEvent = e as KeyboardEvent;
          if (kEvent.key === 'Enter' || kEvent.key === ' ') {
            e.preventDefault();
            selectCat(btn as HTMLButtonElement);
          }
        });
      });

      rangoBtns.forEach(btn => {
        btn.addEventListener('click', () => selectRango(btn as HTMLButtonElement));
        btn.addEventListener('keydown', (e: Event) => {
          const kEvent = e as KeyboardEvent;
          if (kEvent.key === 'Enter' || kEvent.key === ' ') {
            e.preventDefault();
            selectRango(btn as HTMLButtonElement);
          }
        });
      });

      // Handle WhatsApp CTA click with feedback
      btnEl.addEventListener('click', () => {
        if (!waText || !waSpinner || !waIcon) return;
        waText.textContent = 'Redirigiendo a WhatsApp...';
        waSpinner.classList.remove('hidden');
        waIcon.classList.add('hidden');
        btnEl.setAttribute('aria-busy', 'true');

        if (announcement) {
          announcement.textContent = 'Redirigiendo a WhatsApp para solicitar la propuesta...';
        }

        setTimeout(() => {
          waText.textContent = 'Solicitar Propuesta Personalizada';
          waSpinner.classList.add('hidden');
          waIcon.classList.remove('hidden');
          btnEl.removeAttribute('aria-busy');
        }, 3000);
      });

      // Initial calculation call
      updateCalculation();
    }

    initCalc();
    document.addEventListener('astro:after-swap', initCalc);
  })();
</script>
