---
import { CONFIG } from '../data/config';

const getIconSvg = (iconName: string) => {
  return `<use href="#icon-${iconName}" />`;
};

const modalData = CONFIG.servicios.map(servicio => ({
  titulo: servicio.titulo,
  descripcion: servicio.descripcion,
  items: servicio.items,
  icono: servicio.icono
}));
---

<section id="servicios" class="bg-white section-padding">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-xl">
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Servicios</div>
        <h2 class="font-heading font-extrabold text-[clamp(32px,4vw,44px)] leading-[1.2] text-navy">
          Soluciones técnicas integrales
        </h2>
      </div>
      <p class="font-body text-[16px] text-text-soft max-w-md md:text-right pb-2">
        Aseguramos la máxima disponibilidad y precisión de su equipamiento médico.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
      {CONFIG.servicios.map((servicio, index) => (
        <div
          class="service-card group relative bg-off-white border border-transparent rounded-card p-8 transition-all duration-300 hover:bg-white hover:shadow-card-hover cursor-pointer focus-visible:ring-2 focus-visible:ring-blue"
          data-index={index}
          tabindex="0"
          role="button"
          aria-haspopup="dialog"
          aria-label={`Ver detalles: ${servicio.titulo}`}
        >
          <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-navy to-blue origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
          <div class="w-[52px] h-[52px] rounded-[12px] bg-blue-pale flex items-center justify-center mb-6 text-blue">
            <svg class="w-7 h-7" fill="none" stroke-width="1.5" stroke="currentColor" set:html={getIconSvg(servicio.icono)}></svg>
          </div>
          <h3 class="font-heading font-bold text-[22px] text-navy mb-3">{servicio.titulo}</h3>
          <p class="font-body font-light text-[15px] text-text-soft mb-6">{servicio.descripcion}</p>
          <ul class="flex flex-col gap-3">
            {servicio.items.slice(0, 3).map(item => (
              <li class="flex items-start gap-3 font-body text-[14px] text-text-soft">
                <span class="w-[6px] h-[6px] rounded-full bg-blue-light mt-2 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div id="service-modal-backdrop" class="fixed inset-0 bg-navy-dark/95 backdrop-blur-sm z-[210] opacity-0 pointer-events-none invisible transition-opacity duration-400"></div>
  <div id="service-modal" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[700px] z-[220] opacity-0 pointer-events-none invisible transition-all duration-400 scale-95" role="dialog" aria-modal="true">
    <div class="relative bg-white rounded-card p-10 shadow-2xl w-full max-h-[90vh] overflow-y-auto border border-border">
      <button id="close-modal" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-off-white text-navy hover:bg-navy hover:text-white transition-colors" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-close" /></svg>
      </button>
      <div id="modal-content" class="pt-2 pb-2"></div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ modalData, whatsappNumber: CONFIG.contacto.whatsapp }}>
  (function() {
    let isModalOpen = false;
    const escapeHtml = (u) => typeof u === 'string' ? u.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;") : '';

    const closeModal = () => {
      const b = document.getElementById('service-modal-backdrop');
      const m = document.getElementById('service-modal');
      if (!b || !m) return;
      isModalOpen = false;
      b.classList.add('opacity-0', 'pointer-events-none');
      m.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      document.body.style.overflow = '';
      setTimeout(() => { if (!isModalOpen) { b.classList.add('invisible'); m.classList.add('invisible'); } }, 400);
    };

    const openModal = (i) => {
      const s = modalData[i];
      if (!s) return;
      const c = document.getElementById('modal-content');
      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Interés: ' + s.titulo)}`;
      c.innerHTML = `
        <h3 class="font-heading font-extrabold text-[28px] text-navy mb-4">${escapeHtml(s.titulo)}</h3>
        <p class="font-body font-light text-[17px] text-text-soft mb-8">${escapeHtml(s.descripcion)}</p>
        <ul class="flex flex-col gap-4 mb-10">
          ${s.items.map(item => `<li class="flex items-start gap-4 font-body text-[15px] text-text-soft">${escapeHtml(item)}</li>`).join('')}
        </ul>
        <a href="${waUrl}" id="modal-cta" target="_blank" rel="noopener noreferrer" class="inline-flex bg-navy text-white font-bold py-3 px-8 rounded-lg">WhatsApp</a>
      `;
      const b = document.getElementById('service-modal-backdrop');
      const m = document.getElementById('service-modal');
      b.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      m.classList.remove('opacity-0', 'pointer-events-none', 'invisible', 'scale-95');
      m.classList.add('scale-100', 'opacity-100');
      document.body.style.overflow = 'hidden';
      isModalOpen = true;
    };

    const init = () => {
      document.querySelectorAll('.service-card').forEach(c => {
        c.addEventListener('click', () => openModal(c.dataset.index));
      });
      document.getElementById('service-modal-backdrop')?.addEventListener('click', closeModal);
      document.getElementById('close-modal')?.addEventListener('click', closeModal);
    };

    init();
    document.addEventListener('astro:after-swap', init);
  })();
</script>
