---
import { CONFIG } from '../data/config';

// Optimization: Pass only necessary data to client-side script
const modalData = CONFIG.servicios.map(servicio => ({
  titulo: servicio.titulo,
  descripcion: servicio.descripcion,
  items: servicio.items,
  icono: servicio.icono
}));
---

<section id="servicios" class="bg-white section-padding content-visibility-auto">
  <div class="container-custom">
    <div class="max-w-xl mb-4">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Servicios</div>
      <h2 class="font-heading font-extrabold text-[clamp(32px,4vw,44px)] leading-[1.2] text-navy">
        Soluciones técnicas integrales
      </h2>
    </div>
    <p class="font-body text-[16px] text-text-soft max-w-2xl mb-12">
      Aseguramos la máxima disponibilidad y precisión de su equipamiento médico.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]" data-modal-data={JSON.stringify(modalData)} data-whatsapp={CONFIG.contacto.whatsapp}>
      {CONFIG.servicios.map((servicio, index) => (
        <div
          class="service-card group relative bg-off-white border border-transparent rounded-card p-8 transition-all duration-300 hover:bg-white hover:shadow-card-hover cursor-pointer focus-visible:ring-2 focus-visible:ring-blue"
          data-index={index}
          tabindex="0"
          role="button"
          aria-haspopup="dialog"
          aria-label={`Ver detalles: ${servicio.titulo}`}
        >
          <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-navy to-blue origin-left scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-500 ease-out"></div>

          <div class="w-[52px] h-[52px] rounded-[12px] bg-blue-pale flex items-center justify-center mb-6 text-blue group-hover:scale-110 group-focus-visible:scale-110 transition-transform">
            <svg class="w-7 h-7 group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <use href={`#icon-${servicio.icono}`} />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-[22px] text-navy mb-3">{servicio.titulo}</h3>
          <p class="font-body font-light text-[15px] text-text-soft mb-6">{servicio.descripcion}</p>
          <ul class="flex flex-col gap-3">
            {servicio.items.slice(0, 3).map(item => (
              <li class="flex items-start gap-3 font-body text-[14px] text-text-soft">
                <span class="w-[6px] h-[6px] rounded-full bg-blue-light mt-2 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
          
          <!-- Click Indicator -->
          <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 text-blue bg-blue-pale p-2 rounded-full group-hover:translate-y-[-2px] group-focus-visible:translate-y-[-2px]">
            <svg class="w-5 h-5 fill-none" stroke="currentColor" aria-hidden="true">
              <use href="#icon-expand" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="service-modal-backdrop" class="fixed inset-0 bg-navy-dark/95 backdrop-blur-sm z-[210] opacity-0 pointer-events-none invisible transition-opacity duration-400"></div>
  <div id="service-modal" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[700px] z-[220] opacity-0 pointer-events-none invisible transition-all duration-400 scale-95" role="dialog" aria-modal="true">
    <div class="relative bg-white rounded-card p-10 shadow-2xl w-full max-h-[90vh] overflow-y-auto border border-border">
      <button id="close-modal" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-off-white text-navy hover:bg-navy hover:text-white transition-colors" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-close" /></svg>
      </button>
      <div id="modal-content" class="pt-2 pb-2"></div>
    </div>
  </div>
</section>

<script>
  (function() {
    const escapeHtml = (unsafe: string) => {
      if (typeof unsafe !== 'string') return '';
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;")
        .replace(/\//g, "&#047;")
        .replace(/`/g, "&#096;");
    };

    function initServicios() {
      const grid = document.querySelector('#servicios .grid');
      const cards = document.querySelectorAll('.service-card');
      const backdrop = document.getElementById('service-modal-backdrop');
      const modal = document.getElementById('service-modal');
      const modalContent = document.getElementById('modal-content');
      const closeBtn = document.getElementById('close-modal');

      if (!grid || !cards.length || !backdrop || !modal || !modalContent || !closeBtn) return () => {};

      const modalDataRaw = (grid as HTMLElement).dataset.modalData;
      const whatsappNumber = (grid as HTMLElement).dataset.whatsapp;
      const modalData = modalDataRaw ? JSON.parse(modalDataRaw) : [];

      let isModalOpen = false;
      let lastFocusedElement: HTMLElement | null = null;
      let focusableElements: HTMLElement[] = [];

      const updateFocusableElements = () => {
        focusableElements = Array.from(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
          .filter(el => {
             const tag = el.tagName.toLowerCase();
             return tag !== 'svg' && tag !== 'use' && !el.hasAttribute('disabled');
          }) as HTMLElement[];
      };

      const closeModal = () => {
        if (!isModalOpen) return;
        isModalOpen = false;

        backdrop.classList.add('opacity-0', 'pointer-events-none');
        modal.classList.remove('scale-100', 'opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        document.body.style.overflow = '';

        if (lastFocusedElement) lastFocusedElement.focus();

        setTimeout(() => {
          if (!isModalOpen) {
            modalContent.innerHTML = '';
            backdrop.classList.add('invisible');
            modal.classList.add('invisible');
          }
        }, 400);
      };

      const openModal = (index: number) => {
        const servicio = modalData[index];
        if (!servicio) return;

        lastFocusedElement = document.activeElement as HTMLElement;
        // Defense-in-depth: Ensure number is digits only
        const cleanNumber = (whatsappNumber || '').replace(/\D/g, '');
        const waUrl = `https://wa.me/${cleanNumber}?text=${encodeURIComponent('Hola TechHealth! Me interesa el servicio de: ' + servicio.titulo)}`;

        modalContent.innerHTML = `
          <div class="w-14 h-14 rounded-2xl bg-blue-pale flex items-center justify-center mb-6 text-blue">
            <svg class="w-8 h-8" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><use href="#icon-${escapeHtml(servicio.icono)}" /></svg>
          </div>
          <h3 id="modal-title" class="font-heading font-extrabold text-[28px] text-navy mb-4 leading-tight">${escapeHtml(servicio.titulo)}</h3>
          <p class="font-body font-light text-[17px] text-text-soft mb-8 leading-relaxed">${escapeHtml(servicio.descripcion)}</p>

          <h4 class="font-heading font-bold text-[16px] text-navy mb-4">Detalle de tareas incluidas:</h4>
          <ul class="flex flex-col gap-4 mb-10">
            ${servicio.items.map((item: string) => `<li class="flex items-start gap-4 font-body text-[15px] text-text-soft"><span class="w-[8px] h-[8px] rounded-full bg-blue mt-2 flex-shrink-0"></span>${escapeHtml(item)}</li>`).join('')}
          </ul>
          <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center gap-4">
            <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-navy text-white font-heading font-bold py-3 px-8 rounded-lg hover:bg-navy-dark transition-colors shadow-sm focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2" id="modal-cta">
              <svg class="w-5 h-5 fill-current"><use href="#icon-whatsapp" /></svg>
              <span id="modal-cta-text">Consultar por este servicio</span>
            </a>
            <button type="button" id="modal-close-secondary" class="w-full sm:w-auto text-text-soft font-body font-medium hover:text-navy px-4 py-2 transition-colors focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 rounded-md">Cerrar</button>
          </div>
        `;

        backdrop.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
        modal.classList.remove('opacity-0', 'pointer-events-none', 'invisible', 'scale-95');
        modal.classList.add('scale-100', 'opacity-100');
        document.body.style.overflow = 'hidden';
        isModalOpen = true;

        updateFocusableElements();
        setTimeout(() => {
          (document.getElementById('modal-cta') || closeBtn).focus();
        }, 100);
      };

      const handleCardAction = (e: Event) => {
        const card = e.currentTarget as HTMLElement;
        const index = card.getAttribute('data-index');
        if (index !== null) openModal(parseInt(index));
      };

      const handleModalContentClick = (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target.closest('#modal-close-secondary')) {
          closeModal();
          return;
        }

        const cta = target.closest('#modal-cta') as HTMLAnchorElement;
        const ctaText = document.getElementById('modal-cta-text');
        if (cta && ctaText) {
          e.preventDefault();
          const originalText = ctaText.textContent;
          ctaText.textContent = 'Redirigiendo...';
          cta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

          const href = cta.getAttribute('href');
          if (href) {
            const a = document.createElement('a');
            a.href = href;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }

          setTimeout(() => {
            if (ctaText) ctaText.textContent = originalText;
            if (cta) cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
        }
      };

      const handleGlobalKeydown = (e: KeyboardEvent) => {
        if (!isModalOpen) return;

        if (e.key === 'Escape') {
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          if (focusableElements.length === 0) return;
          const first = focusableElements[0];
          const last = focusableElements[focusableElements.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      };

      cards.forEach(card => {
        card.addEventListener('click', handleCardAction);
        card.addEventListener('keydown', (e) => {
          const ke = e as KeyboardEvent;
          if (ke.key === 'Enter' || ke.key === ' ') {
            e.preventDefault();
            handleCardAction(e);
          }
        });
      });

      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
      modalContent.addEventListener('click', handleModalContentClick as EventListener);
      document.addEventListener('keydown', handleGlobalKeydown);

      return () => {
        cards.forEach(card => {
          card.removeEventListener('click', handleCardAction);
        });
        backdrop.removeEventListener('click', closeModal);
        closeBtn.removeEventListener('click', closeModal);
        modalContent.removeEventListener('click', handleModalContentClick as EventListener);
        document.removeEventListener('keydown', handleGlobalKeydown);
        document.body.style.overflow = '';
      };
    }

    let cleanup = initServicios();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initServicios();
    });
  })();
</script>
