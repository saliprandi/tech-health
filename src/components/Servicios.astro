---
import { CONFIG } from '../data/config';
---

<section id="servicios" class="bg-white section-padding">
  <div class="container-custom">
    
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Servicios</div>
      <h2 class="font-heading font-extrabold text-[clamp(32px,5vw,48px)] leading-[1.1] text-navy tracking-tight mb-6">
        Soluciones integrales en <br class="hidden md:block" />
        <span class="text-blue">ingeniería clínica</span>
      </h2>
      <p class="font-body font-light text-[18px] text-text-soft leading-relaxed max-w-2xl">
        Ofrecemos un servicio técnico especializado orientado a maximizar la vida útil y confiabilidad de su equipamiento médico.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {CONFIG.servicios.map((servicio, index) => (
        <div
          class="service-card group bg-off-white rounded-card p-10 border border-transparent hover:border-blue/10 hover:bg-white hover:shadow-card-hover transition-all duration-500 cursor-pointer relative overflow-hidden"
          data-index={index}
          role="button"
          tabindex="0"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label={`Ver detalles de ${servicio.titulo}`}
        >
          <!-- Decorative element -->
          <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-blue/5 rounded-full blur-2xl group-hover:bg-blue/10 transition-colors"></div>

          <!-- Icon container -->
          <div class="w-14 h-14 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-blue group-hover:text-white transition-all duration-500 text-blue">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5">
              <use href={`#icon-${servicio.icono}`} />
            </svg>
          </div>

          <h3 class="font-heading font-bold text-[22px] text-navy mb-4 leading-tight group-hover:text-blue transition-colors">
            {servicio.titulo}
          </h3>
          
          <p class="font-body font-light text-[15px] text-text-soft leading-relaxed mb-8">
            {servicio.descripcion}
          </p>

          <div class="flex items-center gap-2 font-heading font-bold text-[13px] text-blue uppercase tracking-wider group-hover:gap-4 transition-all">
            Saber más
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Modal Structure -->
  <div id="service-modal-backdrop" class="fixed inset-0 bg-navy/60 backdrop-blur-sm z-[200] opacity-0 pointer-events-none transition-opacity duration-300"></div>

  <div id="service-modal" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[600px] bg-white rounded-card shadow-2xl z-[201] opacity-0 pointer-events-none scale-95 transition-all duration-300 overflow-hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">

    <!-- Close Button -->
    <button id="modal-close" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-off-white flex items-center justify-center text-navy hover:bg-blue hover:text-white transition-all z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue" aria-label="Cerrar modal">
      <svg class="w-5 h-5"><use href="#icon-close" /></svg>
    </button>

    <div class="p-8 md:p-12" id="modal-content">
      <!-- Dynamic content injected here -->
    </div>

    <!-- Footer Action -->
    <div class="bg-off-white p-6 md:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-border">
      <span class="font-body text-[14px] text-text-soft">¿Necesita este servicio?</span>
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-primary py-3 px-6 text-[14px]">
        Consultar ahora
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ services: CONFIG.servicios }}>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.service-card');
    const modal = document.getElementById('service-modal');
    const backdrop = document.getElementById('service-modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const modalContent = document.getElementById('modal-content');

    let isModalOpen = false;
    let triggerElement = null;

    const escapeHtml = (str) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const openModal = (index, trigger) => {
      const s = services[index];
      if (!s || !modalContent) return;

      triggerElement = trigger;
      triggerElement.setAttribute('aria-expanded', 'true');

      modalContent.innerHTML = `
        <div class="w-14 h-14 rounded-2xl bg-blue-pale flex items-center justify-center mb-6 text-blue">
          <svg class="w-8 h-8" fill="none" stroke-width="1.5" stroke="currentColor"><use href="#icon-${escapeHtml(s.icono)}" /></svg>
        </div>
        <h3 id="modal-title" class="font-heading font-extrabold text-[28px] text-navy mb-4 leading-tight">${escapeHtml(s.titulo)}</h3>
        <p class="font-body font-light text-[17px] text-text-soft mb-8 leading-relaxed">${escapeHtml(s.descripcion)}</p>
        <h4 class="font-heading font-bold text-[16px] text-navy mb-4">Detalle de tareas incluidas:</h4>
        <ul class="flex flex-col gap-4">
          ${s.items.map(item => `
            <li class="flex items-start gap-4 font-body text-[15px] text-text-soft">
              <span class="w-[8px] h-[8px] rounded-full bg-blue mt-2 flex-shrink-0"></span>
              ${escapeHtml(item)}
            </li>
          `).join('')}
        </ul>
      `;

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      modal?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      modal?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      isModalOpen = true;

      setTimeout(() => closeBtn?.focus(), 50);
    };

    const closeModal = () => {
      if (!isModalOpen) return;

      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      modal?.classList.remove('scale-100');
      modal?.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      document.body.style.overflow = '';
      isModalOpen = false;

      if (triggerElement) {
        triggerElement.setAttribute('aria-expanded', 'false');
        triggerElement.focus();
        triggerElement = null;
      }
    };

    cards.forEach(card => {
      const idx = card.getAttribute('data-index');
      if (idx === null) return;
      const index = parseInt(idx);

      card.addEventListener('click', () => openModal(index, card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(index, card);
        }
      });
    });

    [backdrop, closeBtn].forEach(el => el?.addEventListener('click', closeModal));

    document.addEventListener('keydown', (e) => {
      if (!isModalOpen || !modal) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'Tab') {
        const focusable = modal.querySelectorAll('button, [href], [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          if (last instanceof HTMLElement) last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          if (first instanceof HTMLElement) first.focus();
        }
      }
    });
  });
</script>
