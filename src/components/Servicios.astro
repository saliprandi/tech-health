---
import { CONFIG } from '../data/config';

// Optimization: Pass only necessary data to client-side script
const modalData = CONFIG.servicios.map(servicio => ({
  titulo: servicio.titulo,
  descripcion: servicio.descripcion,
  items: servicio.items,
  icono: servicio.icono
}));
---

<section id="servicios" class="bg-white section-padding">
  <div class="container-custom">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-xl">
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Servicios</div>
        <h2 class="font-heading font-extrabold text-[clamp(32px,4vw,44px)] leading-[1.2] text-navy">
          Soluciones técnicas integrales
        </h2>
      </div>
      <p class="font-body text-[16px] text-text-soft max-w-md md:text-right pb-2">
        Aseguramos la máxima disponibilidad y precisión de su equipamiento médico a través de servicios especializados.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
      {CONFIG.servicios.map((servicio, index) => (
        <div
          class="service-card group relative bg-off-white border border-transparent rounded-card p-8 transition-all duration-300 hover:bg-white hover:shadow-card-hover focus-within:shadow-card-hover overflow-hidden cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
          data-index={index}
          tabindex="0"
          role="button"
          aria-haspopup="dialog"
          aria-label={`Ver detalles del servicio: ${servicio.titulo}`}
        >
          <!-- Animated Top Bar -->
          <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-navy to-blue origin-left scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-500 ease-out"></div>
          
          <!-- Icon -->
          <div class="w-[52px] h-[52px] rounded-[12px] bg-blue-pale text-blue flex items-center justify-center mb-6 text-blue group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 group-hover:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true" set:html={getIconSvg(servicio.icono)}></svg>
          <div class="w-[52px] h-[52px] rounded-[12px] bg-blue-pale flex items-center justify-center mb-6 text-blue group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 group-hover:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <use href={`#icon-${servicio.icono}`} />
            </svg>
          </div>

          <!-- Content -->
          <h3 class="font-heading font-bold text-[22px] text-navy mb-3">
            {servicio.titulo}
          </h3>
          <p class="font-body font-light text-[15px] text-text-soft mb-6 leading-relaxed">
            {servicio.descripcion}
          </p>

          <!-- List -->
          <ul class="flex flex-col gap-3">
            {servicio.items.slice(0, 3).map(item => (
              <li class="flex items-start gap-3 font-body text-[14px] text-text-soft">
                <span class="w-[6px] h-[6px] rounded-full bg-blue-light mt-2 flex-shrink-0"></span>
                {item}
              </li>
            ))}
            {servicio.items.length > 3 && (
              <li class="font-body text-[14px] text-blue font-medium mt-1">
                Y más...
              </li>
            )}
          </ul>
          
          <!-- Click Indicator -->
          <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 text-blue bg-blue-pale p-2 rounded-full group-hover:translate-y-[-2px] group-focus-visible:translate-y-[-2px]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" aria-hidden="true">
              <use href="#icon-expand" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Maximize Modal -->
  <div id="service-modal-backdrop" class="fixed inset-0 bg-navy-dark/95 backdrop-blur-sm z-[210] opacity-0 pointer-events-none invisible transition-opacity duration-400"></div>

  <div id="service-modal" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[700px] z-[220] opacity-0 pointer-events-none invisible transition-all duration-400 scale-95" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="relative bg-white rounded-card p-10 shadow-2xl w-full max-h-[90vh] overflow-y-auto border border-border">
      <!-- Close Button -->
      <button id="close-modal" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-off-white text-navy hover:bg-navy hover:text-white transition-colors duration-300 z-10 focus-visible:ring-2 focus-visible:ring-blue" aria-label="Cerrar modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" aria-hidden="true">
          <use href="#icon-close" />
        </svg>
      </button>
      
      <!-- Dynamic Content -->
      <div id="modal-content" class="pt-2 pb-2"></div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ modalData, whatsappNumber: CONFIG.contacto.whatsapp }}>
  (function() {
    const escapeHtml = (unsafe) => {
      if (typeof unsafe !== 'string') return '';
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    };

    const initServicios = () => {
    function initServicios() {
      const cards = document.querySelectorAll('.service-card');
      const backdrop = document.getElementById('service-modal-backdrop');
      const modal = document.getElementById('service-modal');
      const modalContent = document.getElementById('modal-content');
      const closeBtn = document.getElementById('close-modal');

      if (!cards.length || !backdrop || !modal || !modalContent || !closeBtn) return () => {};

      const updateFocusableElements = () => {
        focusableElements = Array.from(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
          .filter(el => el.tagName !== 'SVG' && el.tagName !== 'USE' && !el.hasAttribute('disabled'));
      let isModalOpen = false;
      let lastFocusedElement = null;
      let focusableElements = [];

      const escapeHtml = (unsafe) => {
        if (typeof unsafe !== 'string') return '';
        return unsafe.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        return unsafe
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      };

      const closeModal = () => {
        if (!isModalOpen) return;
        isModalOpen = false;

        backdrop.classList.add('opacity-0', 'pointer-events-none');
        modal.classList.remove('scale-100', 'opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        document.body.style.overflow = '';

        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
        if (lastFocusedElement) {
          lastFocusedElement.focus();
        }
        modal.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        modal.classList.remove('scale-100', 'opacity-100');
        document.body.style.overflow = '';

        if (lastFocusedElement) {
          lastFocusedElement.focus();
        }
        if (lastFocusedElement) lastFocusedElement.focus();

        setTimeout(() => {
          if (!isModalOpen) {
            modalContent.innerHTML = '';
            backdrop.classList.add('invisible');
            modal.classList.add('invisible');
          }
        }, 400);
      };

      const updateFocusableElements = () => {
        focusableElements = Array.from(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
          .filter(el => {
             const tag = el.tagName.toLowerCase();
             return tag !== 'svg' && tag !== 'use' && !el.hasAttribute('disabled');
          });
          .filter(el => el.tagName !== 'SVG' && el.tagName !== 'USE' && !el.hasAttribute('disabled'));
      };

      const openModal = (index) => {
        const servicio = modalData[index];
        if (!servicio) return;

        lastFocusedElement = document.activeElement;
        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola TechHealth! Me interesa el servicio de: ' + servicio.titulo)}`;

        modalContent.innerHTML = `
          <div class="w-14 h-14 rounded-2xl bg-blue-pale flex items-center justify-center mb-6 text-blue">
            <svg class="w-8 h-8" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><use href="#icon-${escapeHtml(servicio.icono)}" /></svg>
            <svg class="w-8 h-8" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <use href="#icon-${escapeHtml(servicio.icono)}" />
            </svg>
          </div>
          <h3 id="modal-title" class="font-heading font-extrabold text-[28px] text-navy mb-4 leading-tight">${escapeHtml(servicio.titulo)}</h3>
          <p class="font-body font-light text-[17px] text-text-soft mb-8 leading-relaxed">${escapeHtml(servicio.descripcion)}</p>

          <h4 class="font-heading font-bold text-[16px] text-navy mb-4">Detalle de tareas incluidas:</h4>
          <ul class="flex flex-col gap-4 mb-10">
            ${servicio.items.map(item => `<li class="flex items-start gap-4 font-body text-[15px] text-text-soft"><span class="w-[8px] h-[8px] rounded-full bg-blue mt-2 flex-shrink-0"></span>${escapeHtml(item)}</li>`).join('')}
          </ul>
          <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center gap-4">
            <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-navy text-white font-heading font-bold py-3 px-8 rounded-lg hover:bg-navy-dark transition-colors shadow-sm focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2" id="modal-cta">
              <svg class="w-5 h-5 fill-current"><use href="#icon-whatsapp" /></svg>
              <span id="modal-cta-text">Consultar por este servicio</span>
            </a>
            <button type="button" id="modal-close-secondary" class="w-full sm:w-auto text-text-soft font-body font-medium hover:text-navy px-4 py-2 transition-colors focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 rounded-md">Cerrar</button>
          </div>
        `;

        backdrop.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
        modal.classList.remove('opacity-0', 'pointer-events-none', 'invisible', 'scale-95');
        modal.classList.add('scale-100', 'opacity-100');
        document.body.style.overflow = 'hidden';
        isModalOpen = true;

        updateFocusableElements();
        setTimeout(() => {
          (document.getElementById('modal-cta') || closeBtn).focus();
        }, 100);
      };

        updateFocusableElements();
        setTimeout(() => { (document.getElementById('modal-cta') || closeBtn).focus(); }, 100);
      };

      const handleCardAction = (e) => {
        const card = e.currentTarget;
        const index = card.getAttribute('data-index');
        const index = e.currentTarget.getAttribute('data-index');
        if (index !== null) openModal(parseInt(index));
      };

      cards.forEach(card => {
        card.addEventListener('click', handleCardAction);
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleCardAction(e);
      const handleKeydown = (e) => {
        if (!isModalOpen) return;

        if (e.key === 'Escape') {
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          if (focusableElements.length === 0) return;
          const first = focusableElements[0];
          const last = focusableElements[focusableElements.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      };

      cards.forEach(card => {
        card.addEventListener('click', () => openModal(parseInt(card.getAttribute('data-index') || '0')));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(parseInt(card.getAttribute('data-index') || '0'));
          }
        });
      });

      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);

      modalContent.addEventListener('click', (e) => {
        if (e.target.closest('#modal-close-secondary')) {
          closeModal();
          return;
        }
        const target = e.target;
        if (!target || !(target instanceof HTMLElement)) return;

        if (target.closest('#modal-close-secondary')) {
          closeModal();
        }

        const cta = target.closest('#modal-cta');
      const handleCardClick = (e) => {
        const index = e.currentTarget.getAttribute('data-index');
        if (index !== null) openModal(parseInt(index));
      };

      const handleCardKeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleCardAction(e);
        }
      };

      const handleModalContentClick = (e) => {
        if (e.target.closest('#modal-close-secondary')) closeModal();

      const handleGlobalKeydown = (e) => {
        if (!isModalOpen) return;

        if (e.key === 'Escape') {
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          if (focusableElements.length === 0) return;
          const first = focusableElements[0];
          const last = focusableElements[focusableElements.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      };

      const handleModalClick = (e) => {
        if (e.target.closest('#modal-close-secondary')) {
          closeModal();
          return;
        }
          const index = e.currentTarget.getAttribute('data-index');
          if (index !== null) openModal(parseInt(index));
        }
      };

      const handleModalContentClick = (e) => {
        if (e.target.closest('#modal-close-secondary')) {
          closeModal();
          return;
        }
        if (e.target.closest('#modal-close-secondary')) closeModal();

        const cta = e.target.closest('#modal-cta');
        const ctaText = document.getElementById('modal-cta-text');
        if (cta && ctaText) {
          const originalText = ctaText.textContent;
          ctaText.textContent = 'Redirigiendo...';
          cta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          setTimeout(() => {
            ctaText.textContent = originalText;
            cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
            if (ctaText) ctaText.textContent = originalText;
            if (cta) cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
        }
      };

      const handleGlobalKeydown = (e) => {
        if (!isModalOpen) return;
      cards.forEach(card => {
        card.addEventListener('click', handleCardAction);
        card.addEventListener('keydown', handleCardKeydown);
      });

      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
      modalContent.addEventListener('click', handleModalClick);
      document.addEventListener('keydown', handleGlobalKeydown);

      });

      document.addEventListener('keydown', handleKeydown);

      return () => {
        backdrop.removeEventListener('click', closeModal);
        closeBtn.removeEventListener('click', closeModal);
        document.removeEventListener('keydown', handleKeydown);
      };

      const handleKeydown = (e) => {
        if (!isModalOpen) return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'Tab') {
          const first = focusableElements[0];
          const last = focusableElements[focusableElements.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) { e.preventDefault(); last.focus(); }
          } else {
            if (document.activeElement === last) { e.preventDefault(); first.focus(); }
          }
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });

      cards.forEach(card => {
        card.addEventListener('click', handleCardClick);
        card.addEventListener('click', handleCardAction);
        card.addEventListener('keydown', handleCardKeydown);
      });

      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
      modalContent.addEventListener('click', handleModalContentClick);
      document.addEventListener('keydown', handleGlobalKeydown);

      return () => {
        cards.forEach(card => {

      return () => {
        backdrop.removeEventListener('click', closeModal);
        closeBtn.removeEventListener('click', closeModal);
        document.removeEventListener('keydown', handleKeydown);
      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
      modalContent.addEventListener('click', handleModalContentClick);
      document.addEventListener('keydown', handleGlobalKeydown);

      return () => {
        cards.forEach(card => {
          card.removeEventListener('click', handleCardAction);
        });
        backdrop.removeEventListener('click', closeModal);
        closeBtn.removeEventListener('click', closeModal);
        document.removeEventListener('keydown', handleKeydown);
          card.removeEventListener('click', handleCardClick);
          card.removeEventListener('keydown', handleCardKeydown);
        });
        backdrop.removeEventListener('click', closeModal);
        closeBtn.removeEventListener('click', closeModal);
        modalContent.removeEventListener('click', handleModalClick);
        document.removeEventListener('keydown', handleGlobalKeydown);
        document.body.style.overflow = '';
      };
    };

    let cleanupServicios = initServicios();
    let cleanup;
    cleanup = initServicios();
    }

    let cleanupServicios = initServicios();
