---
import { CONFIG } from '../data/config';

// Helper to return the correct icon ID based on name
const getIconId = (iconName: string) => {
  return `#icon-${iconName}`;
};

// Optimization: Only pass the minimal data needed for the client-side modal
// to reduce the HTML payload size.
const modalData = CONFIG.servicios.map(s => ({
  titulo: s.titulo,
  descripcion: s.descripcion,
  items: s.items,
  icono: s.icono
}));
---

<section id="servicios" class="bg-white section-padding">
  <div class="container-custom">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-xl">
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Servicios</div>
        <h2 class="font-heading font-extrabold text-[clamp(32px,4vw,44px)] leading-[1.2] text-navy">
          Soluciones técnicas integrales
        </h2>
      </div>
      <p class="font-body text-[16px] text-text-soft max-w-md md:text-right pb-2">
        Aseguramos la máxima disponibilidad y precisión de su equipamiento médico a través de servicios especializados.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
      {CONFIG.servicios.map((servicio, index) => (
        <div
          class="service-card group relative bg-off-white border border-transparent hover:border-border rounded-card p-8 transition-all duration-300 hover:bg-white hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 cursor-pointer overflow-hidden"
          data-index={index}
          role="button"
          tabindex="0"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label={`Ver detalles de ${servicio.titulo}`}
        >
          
          <!-- Animated Top Bar -->
          <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-navy to-blue origin-left scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-500 ease-out"></div>
          
          <!-- Icon -->
          <div class="w-[52px] h-[52px] rounded-[12px] bg-blue-pale flex items-center justify-center mb-6 text-blue">
            <svg class="w-7 h-7" fill="none" stroke-width="1.5" stroke="currentColor">
              <use href={getIconId(servicio.icono)} />
            </svg>
          </div>

          <!-- Content -->
          <h3 class="font-heading font-bold text-[22px] text-navy mb-3">
            {servicio.titulo}
          </h3>
          <p class="font-body font-light text-[15px] text-text-soft mb-6 leading-relaxed">
            {servicio.descripcion}
          </p>

          <!-- List -->
          <ul class="flex flex-col gap-3">
            {servicio.items.map(item => (
              <li class="flex items-start gap-3 font-body text-[14px] text-text-soft">
                <span class="w-[6px] h-[6px] rounded-full bg-blue-light mt-2 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
          
          <!-- Click Indicator -->
          <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 text-blue bg-blue-pale p-2 rounded-full">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
              <use href="#icon-maximize" />
            </svg>
          </div>

        </div>
      ))}
    </div>

  </div>

  <!-- Modal Backdrop -->
  <div id="service-modal-backdrop" class="fixed inset-0 bg-navy-dark/95 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-400"></div>

  <!-- Modal -->
  <div
    id="service-modal"
    class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[700px] z-[101] opacity-0 pointer-events-none transition-all duration-400 scale-95"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="relative bg-white rounded-card p-10 shadow-2xl w-full max-h-[90vh] overflow-y-auto border border-border">
      <!-- Close Button -->
      <button id="close-modal" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-off-white text-navy hover:bg-navy hover:text-white transition-colors duration-300 z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor">
          <use href="#icon-close" />
        </svg>
      </button>
      
      <!-- Dynamic Content -->
      <div id="modal-content" class="pt-2 pb-2"></div>
    </div>
  </div>
</section>

<script define:vars={{ modalData }}>
  (function() {
    const services = modalData;
    
    let isModalOpen = false;
    let triggerElement = null;

    /**
     * Sanitizes a string to prevent XSS vulnerabilities when using innerHTML.
     */
    const escapeHtml = (unsafe) => {
      if (typeof unsafe !== 'string') return '';
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    };

    const openModal = (index, element) => {
      const servicio = services[index];
      if (!servicio) return;

      const modal = document.getElementById('service-modal');
      const backdrop = document.getElementById('service-modal-backdrop');
      const modalContent = document.getElementById('modal-content');
      const closeBtn = document.getElementById('close-modal');

      if (!modal || !backdrop || !modalContent || !closeBtn) return;

      triggerElement = element;
      triggerElement.setAttribute('aria-expanded', 'true');

      // Populate content with sanitized data
      modalContent.innerHTML = `
        <div class="w-14 h-14 rounded-2xl bg-blue-pale flex items-center justify-center mb-6 text-blue">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <use href="#icon-${escapeHtml(servicio.icono)}" />
          </svg>
        </div>
        <h3 id="modal-title" class="font-heading font-extrabold text-[28px] text-navy mb-4 leading-tight">${escapeHtml(servicio.titulo)}</h3>
        <p class="font-body font-light text-[17px] text-text-soft mb-8 leading-relaxed">${escapeHtml(servicio.descripcion)}</p>
        
        <h4 class="font-heading font-bold text-[16px] text-navy mb-4">Detalle de tareas incluidas:</h4>
        <ul class="flex flex-col gap-4">
          ${servicio.items.map(item => `
            <li class="flex items-start gap-4 font-body text-[15px] text-text-soft">
              <span class="w-[8px] h-[8px] rounded-full bg-blue mt-2 flex-shrink-0"></span>
              ${escapeHtml(item)}
            </li>
          `).join('')}
        </ul>
      `;

      // Show modal
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      modal.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      isModalOpen = true;

      // Focus management: focus the close button
      setTimeout(() => {
        closeBtn.focus();
      }, 50);
    };

    const closeModal = () => {
      if (!isModalOpen) return;

      const modal = document.getElementById('service-modal');
      const backdrop = document.getElementById('service-modal-backdrop');
      const modalContent = document.getElementById('modal-content');

      if (!modal || !backdrop || !modalContent) return;

      backdrop.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('scale-100');
      modal.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      document.body.style.overflow = '';
      isModalOpen = false;

      // Restore focus and ARIA state
      if (triggerElement) {
        triggerElement.setAttribute('aria-expanded', 'false');
        triggerElement.focus();
        triggerElement = null;
      }

      // Clear content after animation
      setTimeout(() => {
        if (!isModalOpen) modalContent.innerHTML = '';
      }, 400);
    };

    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.service-card');
      const backdrop = document.getElementById('service-modal-backdrop');
      const closeBtn = document.getElementById('close-modal');
      const modal = document.getElementById('service-modal');

      if (!backdrop || !closeBtn || !modal) return;

      cards.forEach(card => {
        const index = card.getAttribute('data-index');
        if (index === null) return;

        const handleOpen = () => openModal(parseInt(index), card);

        card.addEventListener('click', handleOpen);
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleOpen();
          }
        });
      });

      backdrop.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);

      // Global key listeners
      document.addEventListener('keydown', (e) => {
        if (!isModalOpen) return;

        if (e.key === 'Escape') {
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          const focusableElements = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (focusableElements.length === 0) return;

          const firstElement = focusableElements[0];
          const lastElement = focusableElements[focusableElements.length - 1];

          if (e.shiftKey) { // Shift + Tab
            if (document.activeElement === firstElement) {
              e.preventDefault();
              lastElement.focus();
            }
          } else { // Tab
            if (document.activeElement === lastElement) {
              e.preventDefault();
              firstElement.focus();
            }
          }
        }
      });
    });
  })();
</script>
