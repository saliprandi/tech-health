---
import { CONFIG } from '../data/config';

const { calculadora_downtime, contacto } = CONFIG;
---

<section id="calculadora-downtime" class="scroll-mt-20 py-20 bg-navy text-white relative overflow-hidden" aria-labelledby="calc-heading">
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 opacity-5 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-blue blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-blue-light blur-3xl"></div>
  </div>

  <div class="container-custom relative z-10 px-[5%]">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block text-blue-light text-sm font-semibold tracking-wider uppercase mb-3 bg-white/10 px-3 py-1 rounded-full border border-white/10">
        Herramienta de Diagnóstico B2B
      </span>
      <h2 id="calc-heading" class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight">
        {calculadora_downtime.titulo}
      </h2>
      <p class="mt-4 font-body text-base sm:text-lg text-text-muted max-w-2xl mx-auto">
        {calculadora_downtime.subtitulo}
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="max-w-4xl mx-auto bg-navy-dark/90 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-10 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- Controls Column -->
        <div class="lg:col-span-7 space-y-6">

          <!-- Select Equipo -->
          <div class="group/field space-y-2">
            <label for="calc-equipo" class="block text-sm font-medium text-gray-200 group-focus-within/field:text-blue-light transition-colors">
              Seleccione el tipo de equipo inactivo
            </label>
            <div class="relative">
              <select
                id="calc-equipo"
                class="w-full bg-navy border border-white/20 rounded-xl px-4 py-3.5 text-white font-body focus:outline-none focus:ring-2 focus:ring-blue-light focus:border-blue-light transition-all appearance-none cursor-pointer pr-10 text-sm sm:text-base"
                aria-describedby="calc-equipo-desc"
              >
                {calculadora_downtime.equipos.map(eq => (
                  <option value={eq.id} data-costo={eq.costo_estudio_promedio} data-estudios={eq.estudios_diarios_default} class="bg-navy text-white">
                    {eq.nombre}
                  </option>
                ))}
              </select>
              <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-white/60" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <p id="calc-equipo-desc" class="text-xs text-text-muted">
              Seleccione el tipo de equipamiento de electromedicina que presenta la falla.
            </p>
          </div>

          <!-- Slider Días Inactivo -->
          <div class="group/field space-y-2">
            <div class="flex justify-between items-center">
              <label for="calc-dias" class="text-sm font-medium text-gray-200 group-focus-within/field:text-blue-light transition-colors">
                Días acumulados fuera de servicio
              </label>
              <span id="calc-dias-val" class="font-heading font-bold text-blue-light text-lg">
                3 días
              </span>
            </div>
            <input
              type="range"
              id="calc-dias"
              min="1"
              max="30"
              value="3"
              class="w-full h-2.5 bg-navy border border-white/10 rounded-lg appearance-none cursor-pointer accent-blue-light focus:outline-none focus:ring-2 focus:ring-blue-light"
              aria-describedby="calc-dias-desc"
            />
            <div class="flex justify-between text-xs text-text-muted" aria-hidden="true">
              <span>1 día</span>
              <span>15 días</span>
              <span>30 días</span>
            </div>
            <p id="calc-dias-desc" class="text-xs text-text-muted">
              Ajuste los días que el equipamiento lleva detenido o demorado.
            </p>
          </div>

          <!-- Studies / Patient Capacity per day -->
          <div class="group/field space-y-2">
            <div class="flex justify-between items-center">
              <label for="calc-estudios" class="text-sm font-medium text-gray-200 group-focus-within/field:text-blue-light transition-colors">
                Estudios / pacientes diarios estimados
              </label>
              <span id="calc-estudios-val" class="font-heading font-bold text-blue-light text-lg">
                12 / día
              </span>
            </div>
            <input
              type="range"
              id="calc-estudios"
              min="1"
              max="50"
              value="12"
              class="w-full h-2.5 bg-navy border border-white/10 rounded-lg appearance-none cursor-pointer accent-blue-light focus:outline-none focus:ring-2 focus:ring-blue-light"
              aria-describedby="calc-estudios-desc"
            />
            <p id="calc-estudios-desc" class="text-xs text-text-muted">
              Capacidad aproximada de prácticas o pacientes atendidos por jornada laboral.
            </p>
          </div>

        </div>

        <!-- Result Display Column -->
        <div class="lg:col-span-5 bg-navy border border-white/15 rounded-xl p-6 sm:p-8 flex flex-col justify-between h-full space-y-6">
          <div>
            <span class="text-xs font-semibold text-text-muted uppercase tracking-wider block mb-2">
              Impacto Económico Estimado
            </span>
            <div id="calc-resultado-monto" class="font-heading font-black text-3xl sm:text-4xl text-blue-light tracking-tight">
              $900.000 ARS
            </div>
            <p class="text-xs text-text-muted mt-2">
              * Estimación basada en promedios de productividad de instituciones de salud en la región NOA.
            </p>

            <hr class="border-white/10 my-6" />

            <div class="space-y-3 text-sm">
              <div class="flex justify-between text-gray-300">
                <span>Estudios no realizados:</span>
                <span id="calc-total-estudios" class="font-bold text-white">36 estudios</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Tiempo fuera de servicio:</span>
                <span id="calc-total-dias" class="font-bold text-white">3 días hábiles</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Garantía de reparación:</span>
                <span class="font-bold text-emerald-400">90 días garantizados</span>
              </div>
            </div>
          </div>

          <!-- Live Region Announcement for Screen Readers -->
          <div id="calc-live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>

          <!-- WhatsApp Action -->
          <a
            id="calc-wa-btn"
            href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent("Hola TechHealth, requiero asistencia técnica urgente para un equipo inactivo.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 w-full bg-blue text-white font-heading font-bold text-base py-4 px-6 rounded-xl hover:bg-blue-light hover:text-navy transition-all duration-300 shadow-lg hover:shadow-blue/20 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-light focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark"
          >
            <span>Solicitar Reparación Urgente</span>
            <svg class="w-5 h-5 text-white group-hover:text-navy group-hover:translate-x-1 group-focus-visible:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ whatsappPhone: contacto.whatsapp }}>
  (function() {
    function initCalculadora() {
      const equipoSelect = document.getElementById('calc-equipo');
      const diasInput = document.getElementById('calc-dias');
      const diasVal = document.getElementById('calc-dias-val');
      const estudiosInput = document.getElementById('calc-estudios');
      const estudiosVal = document.getElementById('calc-estudios-val');

      const resultadoMonto = document.getElementById('calc-resultado-monto');
      const totalEstudios = document.getElementById('calc-total-estudios');
      const totalDias = document.getElementById('calc-total-dias');
      const waBtn = document.getElementById('calc-wa-btn');
      const liveRegion = document.getElementById('calc-live-region');

      if (!equipoSelect || !diasInput || !estudiosInput || !resultadoMonto || !totalEstudios || !totalDias || !waBtn) {
        return;
      }

      function calcular() {
        const selectedOpt = equipoSelect.options[equipoSelect.selectedIndex];
        if (!selectedOpt) return;

        const costoPromedio = parseInt(selectedOpt.dataset.costo || '20000', 10);
        const dias = parseInt(diasInput.value, 10);
        const estudiosDiarios = parseInt(estudiosInput.value, 10);

        const totalPracticas = dias * estudiosDiarios;
        const totalPerdida = totalPracticas * costoPromedio;

        const equipoNombre = selectedOpt.text.trim();

        // Update labels
        if (diasVal) diasVal.textContent = dias === 1 ? '1 día' : `${dias} días`;
        if (estudiosVal) estudiosVal.textContent = `${estudiosDiarios} / día`;

        // Format ARS currency
        const montoFormateado = new Intl.NumberFormat('es-AR', {
          style: 'currency',
          currency: 'ARS',
          maximumFractionDigits: 0
        }).format(totalPerdida);

        if (resultadoMonto) resultadoMonto.textContent = montoFormateado;
        if (totalEstudios) totalEstudios.textContent = `${totalPracticas} estudios`;
        if (totalDias) totalDias.textContent = dias === 1 ? '1 día hábil' : `${dias} días hábiles`;

        // Update WhatsApp CTA Link safely
        const mensaje = `Hola TechHealth, requiero asistencia técnica urgente para un equipo inactivo:\n- Equipo: ${equipoNombre}\n- Días fuera de servicio: ${dias}\n- Estudios/pacientes diarios: ${estudiosDiarios}\n- Impacto estimado: ${montoFormateado}\nPor favor contáctenme para coordinar diagnóstico.`;
        waBtn.setAttribute('href', `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(mensaje)}`);

        // Announce to Screen Readers
        if (liveRegion) {
          liveRegion.textContent = `Impacto económico estimado actualizado: ${montoFormateado} por ${totalPracticas} estudios en ${dias} días para ${equipoNombre}.`;
        }
      }

      equipoSelect.addEventListener('change', function() {
        const opt = equipoSelect.options[equipoSelect.selectedIndex];
        if (opt && opt.dataset.estudios) {
          estudiosInput.value = opt.dataset.estudios;
        }
        calcular();
      });

      diasInput.addEventListener('input', calcular);
      estudiosInput.addEventListener('input', calcular);

      // Initial calculation
      calcular();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalculadora);
    } else {
      initCalculadora();
    }

    document.addEventListener('astro:after-swap', initCalculadora);
  })();
</script>
