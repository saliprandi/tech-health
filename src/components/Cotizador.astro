---
import { CONFIG } from '../data/config';

const { cotizador, contacto } = CONFIG;
const cleanPhone = contacto.whatsapp.replace(/\D/g, '');
---

<section id="cotizador" class="py-20 md:py-28 bg-slate-50 relative overflow-hidden scroll-mt-16">
  <!-- Subtle decorative background gradients -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-blue/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-navy/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-custom px-[5%] relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue/10 text-navy font-heading text-xs font-bold uppercase tracking-wider mb-4 border border-blue/20">
        <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" aria-hidden="true">
          <use href="#icon-circuit" />
        </svg>
        Presupuesto Estimado B2B
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy tracking-tight mb-4">
        {cotizador.titulo}
      </h2>
      <p class="font-body text-base sm:text-lg text-text-soft leading-relaxed">
        {cotizador.subtitulo}
      </p>
    </div>

    <!-- Estimator Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Interactive Selectors (8 cols on LG) -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 border border-border shadow-card space-y-8">

        <!-- Step 1: Institution Type -->
        <div>
          <label class="block font-heading font-bold text-navy text-lg mb-3 flex items-center justify-between">
            <span>1. Tipo de Institución Médica</span>
            <span class="text-xs font-normal text-text-soft bg-slate-100 px-2.5 py-1 rounded-full">Paso 1 de 3</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Tipo de institución médica">
            {cotizador.instituciones.map((inst, idx) => (
              <label
                class="cotizador-option group relative flex flex-col p-4 rounded-xl border-2 border-border bg-slate-50/50 hover:bg-blue/5 hover:border-blue cursor-pointer transition-all duration-200 outline-none focus-within:ring-2 focus-within:ring-blue focus-within:border-blue"
              >
                <input
                  type="radio"
                  name="institucion"
                  value={inst.id}
                  data-label={inst.label}
                  class="sr-only cotizador-radio-inst"
                  checked={idx === 0}
                />
                <span class="flex items-center justify-between w-full mb-1">
                  <span class="font-heading font-semibold text-navy group-hover:text-blue transition-colors">{inst.label}</span>
                  <span class="radio-indicator w-4 h-4 rounded-full border-2 border-border group-hover:border-blue flex items-center justify-center transition-colors">
                    <span class="radio-dot w-2 h-2 rounded-full bg-blue opacity-0 transition-opacity"></span>
                  </span>
                </span>
                <span class="font-body text-xs text-text-soft">{inst.descripcion}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 2: Service Type -->
        <div>
          <label class="block font-heading font-bold text-navy text-lg mb-3 flex items-center justify-between">
            <span>2. Servicio Principal Requerido</span>
            <span class="text-xs font-normal text-text-soft bg-slate-100 px-2.5 py-1 rounded-full">Paso 2 de 3</span>
          </label>
          <div class="space-y-3" role="radiogroup" aria-label="Servicio principal requerido">
            {cotizador.servicios.map((srv, idx) => (
              <label
                class="cotizador-option group relative flex items-start p-4 rounded-xl border-2 border-border bg-slate-50/50 hover:bg-blue/5 hover:border-blue cursor-pointer transition-all duration-200 outline-none focus-within:ring-2 focus-within:ring-blue focus-within:border-blue"
              >
                <input
                  type="radio"
                  name="servicio"
                  value={srv.id}
                  data-label={srv.label}
                  class="sr-only cotizador-radio-srv"
                  checked={idx === 0}
                />
                <span class="radio-indicator w-4 h-4 rounded-full border-2 border-border group-hover:border-blue flex items-center justify-center mt-0.5 mr-3 shrink-0 transition-colors">
                  <span class="radio-dot w-2 h-2 rounded-full bg-blue opacity-0 transition-opacity"></span>
                </span>
                <span class="flex-1">
                  <span class="block font-heading font-semibold text-navy group-hover:text-blue transition-colors mb-0.5">{srv.label}</span>
                  <span class="block font-body text-xs text-text-soft">{srv.detalle}</span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 3: Equipment Count -->
        <div>
          <label class="block font-heading font-bold text-navy text-lg mb-3 flex items-center justify-between">
            <span>3. Cantidad Aprox. de Equipos</span>
            <span class="text-xs font-normal text-text-soft bg-slate-100 px-2.5 py-1 rounded-full">Paso 3 de 3</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" role="radiogroup" aria-label="Cantidad aproximada de equipos">
            {cotizador.rangosEquipos.map((rango, idx) => (
              <label
                class="cotizador-option group relative flex flex-col items-center justify-center p-4 rounded-xl border-2 border-border bg-slate-50/50 hover:bg-blue/5 hover:border-blue cursor-pointer transition-all duration-200 text-center outline-none focus-within:ring-2 focus-within:ring-blue focus-within:border-blue"
              >
                <input
                  type="radio"
                  name="equipos"
                  value={rango.id}
                  data-label={rango.label}
                  class="sr-only cotizador-radio-eq"
                  checked={idx === 1}
                />
                <span class="font-heading font-bold text-navy text-base group-hover:text-blue transition-colors mb-1">{rango.label}</span>
                <span class="inline-block text-[11px] font-semibold text-blue bg-blue/10 px-2 py-0.5 rounded-full">{rango.badge}</span>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- Live Summary & Action Card (5 cols on LG) -->
      <div class="lg:col-span-5 bg-navy text-white rounded-2xl p-6 sm:p-8 shadow-card-hover flex flex-col justify-between border border-navy-light/20 relative overflow-hidden">

        <!-- Background accent -->
        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-blue/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

        <div>
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
            <h3 class="font-heading font-bold text-xl text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-light" fill="none" stroke="currentColor" aria-hidden="true">
                <use href="#icon-file-text" />
              </svg>
              Resumen de Estimación
            </h3>
            <span class="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold px-2.5 py-1 rounded-full">
              Sin compromiso
            </span>
          </div>

          <!-- Dynamic Selections Box -->
          <div class="space-y-4 mb-8">
            <div class="bg-white/5 rounded-xl p-3.5 border border-white/10">
              <span class="block text-xs text-text-muted mb-1 font-body">Institución Seleccionada</span>
              <span id="summary-institucion" class="font-heading font-semibold text-white text-base">Hospital / Sanatorio</span>
            </div>

            <div class="bg-white/5 rounded-xl p-3.5 border border-white/10">
              <span class="block text-xs text-text-muted mb-1 font-body">Servicio Solicitado</span>
              <span id="summary-servicio" class="font-heading font-semibold text-white text-base">Mantenimiento Preventivo Programado</span>
            </div>

            <div class="bg-white/5 rounded-xl p-3.5 border border-white/10">
              <span class="block text-xs text-text-muted mb-1 font-body">Volumen de Equipamiento</span>
              <span id="summary-equipos" class="font-heading font-semibold text-blue-light text-base">4 a 10 equipos (Descuento por lote)</span>
            </div>
          </div>

          <!-- Key B2B Benefits -->
          <div class="bg-white/10 rounded-xl p-4 mb-8 space-y-2 border border-white/10">
            <span class="text-xs font-bold text-blue-light uppercase tracking-wider block mb-1">Incluido en su propuesta:</span>
            <ul class="text-xs text-text-light space-y-1.5 font-body">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-check" />
                </svg>
                <span>Informe técnico homologado para auditorías de salud</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-check" />
                </svg>
                <span>Garantía escrita de 90 días sobre repuestos e intervención</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-check" />
                </svg>
                <span>Diagnóstico in-situ o retiro sin costo en Tucumán</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Action Button -->
        <div>
          <a
            id="cotizador-submit-wa"
            href={`https://wa.me/${cleanPhone}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-bold text-sm py-3.5 px-6 rounded-xl transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy group"
          >
            <svg id="cotizador-wa-spinner" class="hidden w-5 h-5 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <svg id="cotizador-wa-icon" class="w-5 h-5 fill-current shrink-0" aria-hidden="true">
              <use href="#icon-whatsapp" />
            </svg>
            <span id="cotizador-wa-btn-text">Solicitar Cotización Formal en WhatsApp</span>
          </a>

          <p class="text-center text-[11px] text-text-muted mt-3">
            Atención directa B2B · Sin intermediarios ni demoras
          </p>
        </div>

      </div>

    </div>

  </div>

  <!-- Accessibility Announcement Region for Screen Readers -->
  <div id="cotizador-announcement" class="sr-only" aria-live="polite"></div>
</section>

<style>
  .cotizador-option:has(input:checked) {
    @apply border-blue bg-blue/10 shadow-sm;
  }

  .cotizador-option:has(input:checked) .radio-indicator {
    @apply border-blue;
  }

  .cotizador-option:has(input:checked) .radio-dot {
    @apply opacity-100;
  }
</style>

<script>
  (function() {
    function initCotizador() {
      const container = document.getElementById('cotizador');
      if (!container) return () => {};

      const radioInsts = container.querySelectorAll('.cotizador-radio-inst') as NodeListOf<HTMLInputElement>;
      const radioSrvs = container.querySelectorAll('.cotizador-radio-srv') as NodeListOf<HTMLInputElement>;
      const radioEqs = container.querySelectorAll('.cotizador-radio-eq') as NodeListOf<HTMLInputElement>;

      const summaryInst = document.getElementById('summary-institucion');
      const summarySrv = document.getElementById('summary-servicio');
      const summaryEq = document.getElementById('summary-equipos');

      const btnSubmitWa = document.getElementById('cotizador-submit-wa') as HTMLAnchorElement | null;
      const btnText = document.getElementById('cotizador-wa-btn-text');
      const spinner = document.getElementById('cotizador-wa-spinner');
      const icon = document.getElementById('cotizador-wa-icon');
      const announcement = document.getElementById('cotizador-announcement');

      let cleanPhone = "5493815658239";
      if (btnSubmitWa) {
        const match = btnSubmitWa.href.match(/wa\.me\/(\d+)/);
        if (match) cleanPhone = match[1];
      }

      function updateSummary() {
        const selectedInst = Array.from(radioInsts).find(r => r.checked);
        const selectedSrv = Array.from(radioSrvs).find(r => r.checked);
        const selectedEq = Array.from(radioEqs).find(r => r.checked);

        const instLabel = selectedInst?.dataset.label || "Hospital / Sanatorio";
        const srvLabel = selectedSrv?.dataset.label || "Mantenimiento Preventivo Programado";
        const eqLabel = selectedEq?.dataset.label || "4 a 10 equipos";

        if (summaryInst) summaryInst.textContent = instLabel;
        if (summarySrv) summarySrv.textContent = srvLabel;
        if (summaryEq) summaryEq.textContent = eqLabel;

        // Build pre-filled WhatsApp message
        const messageText = `Hola TechHealth, quisiera solicitar una cotización formal para mi institución:\n- *Institución*: ${instLabel}\n- *Servicio*: ${srvLabel}\n- *Cantidad de Equipos*: ${eqLabel}\nQuedo a la espera de su respuesta. Gracias.`;
        const encodedMsg = encodeURIComponent(messageText);

        if (btnSubmitWa) {
          btnSubmitWa.href = `https://wa.me/${cleanPhone}?text=${encodedMsg}`;
        }

        if (announcement) {
          announcement.textContent = `Selección actualizada: ${instLabel}, ${srvLabel}, ${eqLabel}`;
        }
      }

      const handleChange = () => updateSummary();

      radioInsts.forEach(r => r.addEventListener('change', handleChange));
      radioSrvs.forEach(r => r.addEventListener('change', handleChange));
      radioEqs.forEach(r => r.addEventListener('change', handleChange));

      function handleCtaClick(e: MouseEvent) {
        e.preventDefault();
        if (!btnSubmitWa || !btnText || !spinner || !icon) return;

        btnText.textContent = "Redirigiendo a WhatsApp...";
        spinner.classList.remove('hidden');
        icon.classList.add('hidden');
        btnSubmitWa.classList.add('opacity-80', 'pointer-events-none');

        if (announcement) {
          announcement.textContent = "Redirigiendo a WhatsApp con el detalle de cotización estimado...";
        }

        const targetUrl = btnSubmitWa.href;
        const openedWin = window.open(targetUrl, '_blank', 'noopener,noreferrer');
        if (!openedWin) {
          window.location.href = targetUrl;
        }

        setTimeout(() => {
          btnText.textContent = "Solicitar Cotización Formal en WhatsApp";
          spinner.classList.add('hidden');
          icon.classList.remove('hidden');
          btnSubmitWa.classList.remove('opacity-80', 'pointer-events-none');
          if (announcement) announcement.textContent = "";
        }, 3000);
      }

      btnSubmitWa?.addEventListener('click', handleCtaClick as EventListener);

      // Initial calculation
      updateSummary();

      return () => {
        radioInsts.forEach(r => r.removeEventListener('change', handleChange));
        radioSrvs.forEach(r => r.removeEventListener('change', handleChange));
        radioEqs.forEach(r => r.removeEventListener('change', handleChange));
        btnSubmitWa?.removeEventListener('click', handleCtaClick as EventListener);
      };
    }

    let cleanup = initCotizador();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initCotizador();
    });
  })();
</script>
