---
import { CONFIG } from '../data/config';

const { cotizador } = CONFIG;
---

<section id="cotizador" class="py-20 bg-gradient-to-b from-navy via-[#0d2248] to-navy text-white scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-accent-blue/10 text-accent-blue border border-accent-blue/20 mb-4">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        {cotizador.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-heading">
        {cotizador.titulo}
      </h2>
      <p class="mt-4 text-lg text-white/70">
        {cotizador.subtitulo}
      </p>
    </div>

    <!-- Contenedor Principal del Cotizador -->
    <div class="bg-navy-light/60 backdrop-blur-md rounded-2xl p-6 sm:p-8 border border-white/10 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Opciones Interactivas (Izquierda - 7 columnas) -->
        <div class="lg:col-span-7 space-y-8">

          <!-- Paso 1: Tipo de Institución -->
          <div>
            <label class="block text-sm font-semibold uppercase tracking-wider text-accent-blue mb-3">
              1. Tipo de Institución Médica
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" role="radiogroup" aria-label="Tipo de institución médica">
              {cotizador.tiposInstitucion.map((inst, idx) => (
                <button
                  type="button"
                  data-inst={inst.id}
                  data-inst-nombre={inst.nombre}
                  aria-checked={idx === 0 ? "true" : "false"}
                  role="radio"
                  class={`btn-inst text-left p-4 rounded-xl border transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy ${
                    idx === 0
                      ? 'bg-accent-blue/20 border-accent-blue text-white'
                      : 'bg-white/5 border-white/10 text-white/80 hover:bg-white/10 hover:border-white/20'
                  }`}
                >
                  <span class="block text-sm font-semibold mb-1">{inst.nombre}</span>
                  <span class="block text-xs text-white/60 line-clamp-2">{inst.desc}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Paso 2: Cantidad de Equipos -->
          <div>
            <label class="block text-sm font-semibold uppercase tracking-wider text-accent-blue mb-3">
              2. Tamaño de la Flota (Cantidad de Equipos)
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" role="radiogroup" aria-label="Cantidad de equipos médicos">
              {cotizador.rangosEquipos.map((rango, idx) => (
                <button
                  type="button"
                  data-rango={rango.id}
                  data-rango-label={rango.label}
                  data-rango-estimacion={rango.estimacion}
                  aria-checked={idx === 1 ? "true" : "false"}
                  role="radio"
                  class={`btn-rango py-3 px-4 text-center rounded-xl border font-medium text-sm transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy ${
                    idx === 1
                      ? 'bg-accent-blue/20 border-accent-blue text-white font-semibold'
                      : 'bg-white/5 border-white/10 text-white/80 hover:bg-white/10 hover:border-white/20'
                  }`}
                >
                  {rango.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Paso 3: Modalidad del Servicio -->
          <div>
            <label class="block text-sm font-semibold uppercase tracking-wider text-accent-blue mb-3">
              3. Modalidad de Mantenimiento Deseada
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Modalidad de mantenimiento">
              {cotizador.modalidades.map((mod, idx) => (
                <button
                  type="button"
                  data-modalidad={mod.id}
                  data-modalidad-nombre={mod.nombre}
                  aria-checked={idx === 0 ? "true" : "false"}
                  role="radio"
                  class={`btn-modalidad text-left p-4 rounded-xl border transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy ${
                    idx === 0
                      ? 'bg-accent-blue/20 border-accent-blue text-white'
                      : 'bg-white/5 border-white/10 text-white/80 hover:bg-white/10 hover:border-white/20'
                  }`}
                >
                  <span class="block text-sm font-semibold mb-2">{mod.nombre}</span>
                  <ul class="space-y-1 text-xs text-white/70">
                    {mod.detalles.slice(0, 2).map((item) => (
                      <li class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-accent-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </button>
              ))}
            </div>
          </div>

        </div>

        <!-- Resumen y Estimación (Derecha - 5 columnas) -->
        <div class="lg:col-span-5 bg-navy/80 rounded-xl p-6 border border-white/10 flex flex-col justify-between h-full shadow-inner">
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
              <span class="text-xs font-semibold uppercase tracking-wider text-white/60">Resumen de Propuesta</span>
              <span class="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-medium">
                Sin Compromiso
              </span>
            </div>

            <!-- Región en vivo para accesibilidad de cambios -->
            <div aria-live="polite" aria-atomic="true" class="sr-only" id="cotizador-a11y-live"></div>

            <div class="my-6 space-y-4">
              <div>
                <span class="text-xs text-white/50 block">Institución Seleccionada:</span>
                <span id="display-inst" class="text-base font-semibold text-white">
                  {cotizador.tiposInstitucion[0].nombre}
                </span>
              </div>

              <div>
                <span class="text-xs text-white/50 block">Volumen de Equipamiento:</span>
                <span id="display-rango" class="text-base font-semibold text-white">
                  {cotizador.rangosEquipos[1].label}
                </span>
              </div>

              <div>
                <span class="text-xs text-white/50 block">Modalidad de Servicio:</span>
                <span id="display-modalidad" class="text-base font-semibold text-white">
                  {cotizador.modalidades[0].nombre}
                </span>
              </div>

              <div class="pt-4 border-t border-white/10">
                <span class="text-xs text-white/60 block mb-1">Estimación Referencial:</span>
                <span id="display-estimacion" class="text-2xl font-bold text-accent-blue tracking-tight">
                  {cotizador.rangosEquipos[1].estimacion}
                </span>
                <p class="text-xs text-white/50 mt-1">
                  *Sujeto a relevamiento técnico in-situ e inventario de modelos.
                </p>
              </div>
            </div>
          </div>

          <!-- CTA a WhatsApp -->
          <div class="pt-4 border-t border-white/10">
            <a
              id="btn-cotizar-wa"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center justify-center w-full gap-2 px-6 py-3.5 bg-accent-blue hover:bg-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-accent-blue/25 transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
            >
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.119.554 4.11 1.528 5.845L0 24l6.326-1.492C8.01 23.456 9.945 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.84 0-3.562-.489-5.06-1.34l-.363-.207-3.757.886.91-3.663-.228-.37A9.957 9.957 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
              </svg>
              <span id="btn-cotizar-text">Solicitar Propuesta por WhatsApp</span>
            </a>
            <span class="block text-center text-xs text-white/40 mt-2">
              Respuesta técnica garantizada en menos de 24 horas.
            </span>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<script>
  import { CONFIG } from '../data/config';

  function initCotizador() {
    const cotizadorSection = document.getElementById('cotizador');
    if (!cotizadorSection) return;

    const btnInsts = cotizadorSection.querySelectorAll<HTMLButtonElement>('.btn-inst');
    const btnRangos = cotizadorSection.querySelectorAll<HTMLButtonElement>('.btn-rango');
    const btnModalidades = cotizadorSection.querySelectorAll<HTMLButtonElement>('.btn-modalidad');

    const displayInst = cotizadorSection.querySelector<HTMLElement>('#display-inst');
    const displayRango = cotizadorSection.querySelector<HTMLElement>('#display-rango');
    const displayModalidad = cotizadorSection.querySelector<HTMLElement>('#display-modalidad');
    const displayEstimacion = cotizadorSection.querySelector<HTMLElement>('#display-estimacion');
    const btnCotizarWa = cotizadorSection.querySelector<HTMLAnchorElement>('#btn-cotizar-wa');
    const btnCotizarText = cotizadorSection.querySelector<HTMLElement>('#btn-cotizar-text');
    const liveRegion = cotizadorSection.querySelector<HTMLElement>('#cotizador-a11y-live');

    let state = {
      instNombre: CONFIG.cotizador.tiposInstitucion[0].nombre,
      rangoLabel: CONFIG.cotizador.rangosEquipos[1].label,
      rangoEstimacion: CONFIG.cotizador.rangosEquipos[1].estimacion,
      modalidadNombre: CONFIG.cotizador.modalidades[0].nombre,
    };

    function updateUI() {
      if (displayInst) displayInst.textContent = state.instNombre;
      if (displayRango) displayRango.textContent = state.rangoLabel;
      if (displayModalidad) displayModalidad.textContent = state.modalidadNombre;
      if (displayEstimacion) displayEstimacion.textContent = state.rangoEstimacion;

      // Anunciar cambio a lectores de pantalla
      if (liveRegion) {
        liveRegion.textContent = `Seleccionado: ${state.instNombre}, ${state.rangoLabel}, ${state.modalidadNombre}. Estimación: ${state.rangoEstimacion}`;
      }

      // Generar link de WhatsApp
      const waNum = CONFIG.contacto.whatsapp.replace(/\D/g, '');
      const mensaje = `Hola TechHealth, me gustaría solicitar una propuesta formal para:\n` +
        `• Institución: ${state.instNombre}\n` +
        `• Equipamiento: ${state.rangoLabel}\n` +
        `• Modalidad: ${state.modalidadNombre}\n` +
        `• Estimador: ${state.rangoEstimacion}\n\n` +
        `Agradezco la coordinación de una evaluación.`;

      const encodedMsg = encodeURIComponent(mensaje);
      if (btnCotizarWa) {
        btnCotizarWa.href = `https://wa.me/${waNum}?text=${encodedMsg}`;
      }
    }

    // Event listeners para Tipo de Institución
    btnInsts.forEach((btn) => {
      btn.addEventListener('click', () => {
        btnInsts.forEach((b) => {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('bg-accent-blue/20', 'border-accent-blue');
          b.classList.add('bg-white/5', 'border-white/10');
        });

        btn.setAttribute('aria-checked', 'true');
        btn.classList.remove('bg-white/5', 'border-white/10');
        btn.classList.add('bg-accent-blue/20', 'border-accent-blue');

        state.instNombre = btn.getAttribute('data-inst-nombre') || '';
        updateUI();
      });
    });

    // Event listeners para Rango de Equipos
    btnRangos.forEach((btn) => {
      btn.addEventListener('click', () => {
        btnRangos.forEach((b) => {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('bg-accent-blue/20', 'border-accent-blue', 'font-semibold');
          b.classList.add('bg-white/5', 'border-white/10');
        });

        btn.setAttribute('aria-checked', 'true');
        btn.classList.remove('bg-white/5', 'border-white/10');
        btn.classList.add('bg-accent-blue/20', 'border-accent-blue', 'font-semibold');

        state.rangoLabel = btn.getAttribute('data-rango-label') || '';
        state.rangoEstimacion = btn.getAttribute('data-rango-estimacion') || '';
        updateUI();
      });
    });

    // Event listeners para Modalidad
    btnModalidades.forEach((btn) => {
      btn.addEventListener('click', () => {
        btnModalidades.forEach((b) => {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('bg-accent-blue/20', 'border-accent-blue');
          b.classList.add('bg-white/5', 'border-white/10');
        });

        btn.setAttribute('aria-checked', 'true');
        btn.classList.remove('bg-white/5', 'border-white/10');
        btn.classList.add('bg-accent-blue/20', 'border-accent-blue');

        state.modalidadNombre = btn.getAttribute('data-modalidad-nombre') || '';
        updateUI();
      });
    });

    // Feedback visual en el botón de WhatsApp al hacer clic
    if (btnCotizarWa && btnCotizarText) {
      btnCotizarWa.addEventListener('click', () => {
        const originalText = btnCotizarText.textContent;
        btnCotizarText.textContent = 'Abriendo WhatsApp...';
        setTimeout(() => {
          if (btnCotizarText) btnCotizarText.textContent = originalText;
        }, 3000);
      });
    }

    // Inicializar UI al cargar
    updateUI();
  }

  // Soporte para carga inicial y transiciones de vista Astro
  document.addEventListener('DOMContentLoaded', initCotizador);
  document.addEventListener('astro:page-load', initCotizador);
</script>
