---
import { CONFIG } from '../data/config';

const { cotizador, contacto } = CONFIG;
---

<section id="cotizador" class="bg-off-white section-padding content-visibility-auto">
  <div class="container-custom">

    <!-- Encabezado de la sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Cotizador B2B</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,40px)] leading-[1.2] text-navy mb-4">
        Estime su Plan de Mantenimiento Preventivo
      </h2>
      <p class="font-body text-[16px] text-text-soft">
        Diseñado para clínicas, sanatorios y consultorios. Seleccione la escala de su institución para calcular el esquema preventivo sugerido.
      </p>
    </div>

    <!-- Tarjeta Principal del Cotizador -->
    <div class="bg-white rounded-card border border-border p-6 md:p-10 shadow-lg max-w-4xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Selector de parámetros (Columna izquierda) -->
        <div class="lg:col-span-7 flex flex-col gap-6">

          <!-- Tipo de centro médico -->
          <div>
            <label id="label-tipo-centro" class="block font-heading font-bold text-[14px] text-navy mb-3">
              1. Tipo de establecimiento de salud:
            </label>
            <div role="radiogroup" aria-labelledby="label-tipo-centro" class="grid grid-cols-1 gap-2.5">
              {cotizador.tipos_centro.map((tc, index) => (
                <label class="group flex items-center justify-between p-3.5 rounded-[10px] border border-border hover:border-blue/50 focus-within:border-blue bg-white cursor-pointer transition-all duration-200">
                  <div class="flex items-center gap-3">
                    <input
                      type="radio"
                      name="tipo_centro"
                      value={tc.id}
                      data-nombre={tc.nombre}
                      checked={index === 0}
                      class="w-4 h-4 text-blue border-gray-300 focus:ring-blue focus:ring-offset-0"
                    />
                    <span class="font-body font-medium text-[14px] text-navy group-hover:text-blue transition-colors">
                      {tc.nombre}
                    </span>
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Rango de equipos -->
          <div>
            <label id="label-rango-equipos" class="block font-heading font-bold text-[14px] text-navy mb-3">
              2. Cantidad de equipos médicos a cubrir:
            </label>
            <div role="radiogroup" aria-labelledby="label-rango-equipos" class="grid grid-cols-2 gap-2.5">
              {cotizador.rangos_equipos.map((re, index) => (
                <label class="group flex flex-col p-3.5 rounded-[10px] border border-border hover:border-blue/50 focus-within:border-blue bg-white cursor-pointer transition-all duration-200">
                  <div class="flex items-center gap-2 mb-1">
                    <input
                      type="radio"
                      name="rango_equipos"
                      value={re.id}
                      data-base={re.base}
                      data-visitas={re.visitas}
                      data-respuesta={re.tiempoRespuesta}
                      data-label={re.label}
                      checked={index === 0}
                      class="w-4 h-4 text-blue border-gray-300 focus:ring-blue focus:ring-offset-0"
                    />
                    <span class="font-heading font-bold text-[14px] text-navy group-hover:text-blue transition-colors">
                      {re.label}
                    </span>
                  </div>
                  <span class="font-body text-[12px] text-text-soft pl-6">
                    Plan: {re.base}
                  </span>
                </label>
              ))}
            </div>
          </div>

        </div>

        <!-- Resumen del Plan Sugerido (Columna derecha) -->
        <div class="lg:col-span-5 bg-navy rounded-card p-6 md:p-8 text-white flex flex-col justify-between h-full border border-navy-dark shadow-hero-card">
          <div>
            <div class="font-heading font-bold text-blue-light tracking-wide uppercase text-[11px] mb-2">
              Plan Sugerido
            </div>
            <h3 id="plan-sugerido-titulo" class="font-heading font-extrabold text-[24px] text-white mb-2">
              Abono Esencial
            </h3>
            <p id="plan-sugerido-sub" class="font-body text-[13px] text-white/70 mb-6 border-b border-white/10 pb-4">
              Cobertura preventiva ajustada para Consultorio / Centro Médico Pequeño.
            </p>

            <!-- Características -->
            <div class="flex flex-col gap-3.5 mb-6">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-full bg-white/10 text-blue-light flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <div class="font-body text-[11px] text-white/50 uppercase tracking-wider">Frecuencia de visitas</div>
                  <div id="plan-visitas" class="font-heading font-bold text-[14px] text-white">1 visita semestral</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-full bg-white/10 text-blue-light flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <div class="font-body text-[11px] text-white/50 uppercase tracking-wider">Respuesta ante contingencias</div>
                  <div id="plan-respuesta" class="font-heading font-bold text-[14px] text-white">48hs</div>
                </div>
              </div>
            </div>

            <!-- Beneficios incluidos -->
            <div class="mb-6">
              <div class="font-heading font-bold text-[12px] text-white/80 uppercase tracking-wider mb-2">Incluido en el abono:</div>
              <ul class="flex flex-col gap-2 role-list" role="list">
                {cotizador.beneficios_base.map(beneficio => (
                  <li class="flex items-start gap-2 font-body text-[12px] text-white/80">
                    <svg class="w-3.5 h-3.5 text-blue-light mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{beneficio}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Acción -->
          <div>
            <a
              id="cotizador-wa-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="group w-full bg-white text-navy font-heading font-bold py-3.5 px-4 rounded-[8px] transition-all hover:bg-white/90 active:scale-[0.98] flex items-center justify-center gap-2 outline-none focus-visible:ring-2 focus-visible:ring-blue-light"
              data-wa={contacto.whatsapp}
            >
              <svg class="w-5 h-5 fill-current text-navy group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" aria-hidden="true">
                <use href="#icon-whatsapp" />
              </svg>
              <span id="cotizador-wa-text" class="text-[14px]">Solicitar propuesta formal</span>
              <svg class="w-4 h-4 text-navy group-hover:translate-x-1 group-focus-visible:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <div id="cotizador-announcement" class="sr-only" aria-live="polite"></div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    function initCotizador() {
      const radiosTipo = document.querySelectorAll<HTMLInputElement>('input[name="tipo_centro"]');
      const radiosRango = document.querySelectorAll<HTMLInputElement>('input[name="rango_equipos"]');
      const planTitulo = document.getElementById('plan-sugerido-titulo');
      const planSub = document.getElementById('plan-sugerido-sub');
      const planVisitas = document.getElementById('plan-visitas');
      const planRespuesta = document.getElementById('plan-respuesta');
      const waBtn = document.getElementById('cotizador-wa-btn') as HTMLAnchorElement | null;
      const waText = document.getElementById('cotizador-wa-text');
      const announcement = document.getElementById('cotizador-announcement');

      if (!radiosTipo.length || !radiosRango.length || !waBtn) return () => {};

      const cleanWaNum = (waBtn.dataset.wa || '').replace(/\D/g, '');

      const actualizarCotizacion = () => {
        const centroSel = Array.from(radiosTipo).find(r => r.checked);
        const rangoSel = Array.from(radiosRango).find(r => r.checked);

        if (!centroSel || !rangoSel) return;

        const nombreCentro = centroSel.dataset.nombre || 'Establecimiento';
        const planBase = rangoSel.dataset.base || 'Esencial';
        const visitas = rangoSel.dataset.visitas || 'Programadas';
        const respuesta = rangoSel.dataset.respuesta || 'Prioritaria';
        const rangoLabel = rangoSel.dataset.label || '';

        if (planTitulo) planTitulo.textContent = `Abono ${planBase}`;
        if (planSub) planSub.textContent = `Cobertura preventiva ajustada para ${nombreCentro} (${rangoLabel}).`;
        if (planVisitas) planVisitas.textContent = visitas;
        if (planRespuesta) planRespuesta.textContent = respuesta;

        const msg = `Hola TechHealth! Quisiera solicitar una propuesta formal para un Abono ${planBase} de Mantenimiento Preventivo.\n\n*Tipo de establecimiento:* ${nombreCentro}\n*Equipos a cubrir:* ${rangoLabel}\n*Frecuencia sugerida:* ${visitas}\n*Respuesta requerida:* ${respuesta}`;

        const waUrl = `https://wa.me/${cleanWaNum}?text=${encodeURIComponent(msg)}`;
        waBtn.setAttribute('href', waUrl);
      };

      radiosTipo.forEach(r => r.addEventListener('change', actualizarCotizacion));
      radiosRango.forEach(r => r.addEventListener('change', actualizarCotizacion));

      waBtn.addEventListener('click', (e) => {
        const href = waBtn.getAttribute('href');
        if (!href || href === '#' || !href.startsWith('https://wa.me/')) {
          e.preventDefault();
          return;
        }

        e.preventDefault();
        if (waText) {
          const originalText = waText.textContent;
          waText.textContent = 'Redirigiendo...';
          if (announcement) announcement.textContent = 'Redirigiendo a WhatsApp para enviar su solicitud de abono...';
          waBtn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

          const openedWin = window.open(href, '_blank');
          if (openedWin) {
            openedWin.opener = null;
          } else {
            window.location.href = href;
          }

          setTimeout(() => {
            if (waText) waText.textContent = originalText;
            if (announcement) announcement.textContent = '';
            waBtn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
        }
      });

      actualizarCotizacion();

      return () => {
        radiosTipo.forEach(r => r.removeEventListener('change', actualizarCotizacion));
        radiosRango.forEach(r => r.removeEventListener('change', actualizarCotizacion));
      };
    }

    let cleanup = initCotizador();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initCotizador();
    });
  })();
</script>
