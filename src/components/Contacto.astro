---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px]">
      <div>
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] text-navy mb-4">Estamos aquí para ayudarle</h2>
        <div class="flex flex-col gap-6">
          <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-phone" /></svg>

          <!-- WhatsApp -->
          <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5 group-hover:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-phone" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
            </div>
          </a>
          <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-map-pin" /></svg>
            </div>
            <div class="flex-grow">
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
              <div id="address-text" class="font-body text-[14px] text-text-soft">{CONFIG.contacto.direccion}, {CONFIG.contacto.ciudad_completa}</div>
              <div class="flex items-center gap-4 mt-2">
                <button id="copy-address" class="flex items-center gap-1.5 font-body font-medium text-[12px] text-text-soft hover:text-blue transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor"><use id="copy-icon-use" href="#icon-copy" /></svg>
                  <span id="copy-text">Copiar</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="bg-navy rounded-card p-8 md:p-11 shadow-hero-card">
          <form id="contact-form" class="flex flex-col gap-5" data-whatsapp={CONFIG.contacto.whatsapp}>
            <input type="text" id="f-nombre" name="nombre" required placeholder="Nombre completo" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full" />
            <input type="tel" id="f-tel" name="telefono" required placeholder="Teléfono / WhatsApp" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full" />
            <div class="relative">
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" placeholder="Mensaje..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full resize-none"></textarea>
              <div id="char-counter" class="absolute bottom-3 right-3 text-[10px] text-white/40 font-body">0 / 500</div>
            </div>
            <button type="submit" id="f-submit" class="w-full bg-white text-navy font-heading font-bold py-4 rounded-[8px] transition-all hover:bg-white/90 active:scale-[0.98]">Enviar por WhatsApp</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initContacto() {
    const f = document.getElementById('contact-form') as HTMLFormElement | null;
    const desc = document.getElementById('f-desc') as HTMLTextAreaElement | null;
    const counter = document.getElementById('char-counter');
    if (!f) return;
    const w = f.dataset.whatsapp;

    const onInput = () => {
      if (desc && counter) {
        counter.textContent = `${desc.value.length} / 500`;
      }
    };

    const handleSub = (e: Event) => {
      e.preventDefault();
      const n = (document.getElementById('f-nombre') as HTMLInputElement).value;
      const t = (document.getElementById('f-tel') as HTMLInputElement).value;
      const m = (document.getElementById('f-desc') as HTMLTextAreaElement).value;
      window.open(`https://wa.me/${w}?text=${encodeURIComponent('Nombre: ' + n + '\nTel: ' + t + '\nMsg: ' + m)}`, '_blank', 'noopener,noreferrer');
    };

    f.addEventListener('submit', handleSub);
    desc?.addEventListener('input', onInput);

    const cp = document.getElementById('copy-address');
    const onCp = () => {
      navigator.clipboard.writeText(document.getElementById('address-text')?.textContent || '').then(() => {
        const ct = document.getElementById('copy-text');
        if (ct) {
          const old = ct.textContent;
          ct.textContent = '¡Copiado!';
          setTimeout(() => { if (ct) ct.textContent = old; }, 2000);
        }
      });
    };
    cp?.addEventListener('click', onCp);

    return () => {
      f.removeEventListener('submit', handleSub);
      desc?.removeEventListener('input', onInput);
      cp?.removeEventListener('click', onCp);
    };
  }

  let cleanC = initContacto();
  document.addEventListener('astro:after-swap', () => { cleanC?.(); cleanC = initContacto(); });
  (function() {
    function initContacto() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!form) return () => {};

      const whatsappNumber = form.getAttribute('data-whatsapp') || '';
      const badge = document.getElementById('status-badge');
      const textarea = document.getElementById('f-desc') as HTMLTextAreaElement | null;
      const counter = document.getElementById('char-counter');
      const copyBtn = document.getElementById('copy-address');
      const addressText = document.getElementById('address-text')?.textContent || '';
      const copyLabel = document.getElementById('copy-text');
      const copyIconUse = document.getElementById('copy-icon-use');
      const announcement = document.getElementById('copy-announcement');
      const submitBtn = document.getElementById('f-submit') as HTMLButtonElement | null;
      const submitBtnText = document.getElementById('f-submit-text');

      // Business Hours Status Badge Logic
      let statusInterval: ReturnType<typeof setInterval> | null = null;

      const updateStatusBadge = () => {
        if (!badge) return;
        const now = new Date();
        const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
        const day = tucumanTime.getDay();
        const hour = tucumanTime.getHours();

        const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

        if (isOpen) {
          badge.innerHTML = '<span class="relative flex h-2 w-2" aria-hidden="true"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span> Abierto ahora';
          badge.className = 'inline-flex items-center gap-1.5 font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500 bg-emerald-100 text-emerald-800';
        } else {
          badge.textContent = 'Cerrado';
          badge.className = 'inline-flex items-center gap-1.5 font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500 bg-gray-100 text-gray-800';
        }
        badge.classList.remove('hidden');
      };

      updateStatusBadge();
      statusInterval = setInterval(updateStatusBadge, 60000);

      // Character Counter Logic
      const updateCounter = () => {
        if (!textarea || !counter) return;
        const length = textarea.value.length;
        counter.textContent = `${length} / 500`;
        if (length >= 450) {
          counter.classList.add('text-blue-light');
          counter.classList.remove('text-white/40');
        } else {
          counter.classList.remove('text-blue-light');
          counter.classList.add('text-white/40');
        }
      };

      textarea?.addEventListener('input', updateCounter);
      updateCounter();

      // Copy Address Logic
      const handleCopy = () => {
        if (!copyLabel || !copyIconUse || !copyBtn) return;
        const originalText = copyLabel.textContent;
        const originalIcon = copyIconUse.getAttribute('href') || '#icon-copy';

        navigator.clipboard.writeText(addressText).then(() => {
          copyLabel.textContent = '¡Copiado!';
          copyIconUse.setAttribute('href', '#icon-check');
          copyBtn.classList.add('text-blue');
          if (announcement) announcement.textContent = 'Dirección copiada al portapapeles';

          setTimeout(() => {
            copyLabel.textContent = originalText;
            copyIconUse.setAttribute('href', originalIcon);
            copyBtn.classList.remove('text-blue');
            if (announcement) announcement.textContent = '';
          }, 2500);
        });
      };

      copyBtn?.addEventListener('click', handleCopy);

      // Form Submit Logic
      const handleSubmit = (e: Event) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const nombre = (document.getElementById('f-nombre') as HTMLInputElement)?.value.trim() || 'No especificado';
        const tel = (document.getElementById('f-tel') as HTMLInputElement)?.value.trim() || 'No especificado';
        const servicioel = document.getElementById('f-servicio') as HTMLSelectElement | null;
        const servicio = servicioel ? servicioel.options[servicioel.selectedIndex].value : 'Consulta general';
        const desc = (document.getElementById('f-desc') as HTMLTextAreaElement)?.value.trim() || 'Sin detalles adicionales';

        if (submitBtn && submitBtnText) {
          const originalBtnText = submitBtnText.textContent;
          submitBtnText.textContent = 'Redirigiendo...';
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

          const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Detalle:* ${desc}`;
          const encodedMessage = encodeURIComponent(rawMessage);
          const url = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

          window.open(url, '_blank', 'noopener,noreferrer');

          setTimeout(() => {
            submitBtnText.textContent = originalBtnText;
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
        }
      };

      form.addEventListener('submit', handleSubmit);

      return () => {
        if (statusInterval) clearInterval(statusInterval);
        textarea?.removeEventListener('input', updateCounter);
        copyBtn?.removeEventListener('click', handleCopy);
        form.removeEventListener('submit', handleSubmit);
      };
    }

    let cleanup: (() => void) | undefined;
    cleanup = initContacto();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initContacto();
    });
  })();
</script>
