  (function() {
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const btn = document.getElementById('f-submit');
      const descArea = document.getElementById('f-desc');
      const charCounter = document.getElementById('char-counter');
      const copyBtns = document.querySelectorAll('.copy-btn');

      // Click to Copy Logic
      copyBtns.forEach(button => {
        button.addEventListener('click', async () => {
          const textToCopy = button.getAttribute('data-copy');
          if (!textToCopy) return;

          try {
            await navigator.clipboard.writeText(textToCopy);

            // Visual Feedback
            const copyIcon = button.querySelector('.copy-icon');
            const checkIcon = button.querySelector('.check-icon');
            const btnText = button.querySelector('.btn-text');

            if (copyIcon && checkIcon && btnText) {
              const originalText = btnText.textContent;
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              btnText.textContent = '¡Copiado!';
              btnText.classList.add('text-green-600');

              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
                btnText.textContent = originalText;
                btnText.classList.remove('text-green-600');
              }, 2000);
            }
          } catch (err) {
            console.error('Error al copiar:', err);
          }
        });
      });

    document.querySelectorAll('.copy-btn').forEach(button => {
      button.addEventListener('click', () => {
        const text = button.getAttribute('data-copy');
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
          const originalHTML = button.innerHTML;
          button.innerHTML = '<svg class="w-4 h-4"><use href="#icon-check" /></svg><span class="text-[10px] ml-1 font-bold">¡Copiado!</span>';
          button.classList.remove('bg-blue-pale', 'text-blue');
          button.classList.add('bg-green-600', 'text-white', 'px-3');
          setTimeout(() => { button.innerHTML = originalHTML; button.classList.add('bg-blue-pale', 'text-blue'); button.classList.remove('bg-green-600', 'text-white', 'px-3'); }, 2000);
      // Character counter logic
      if (descArea && charCounter) {
        descArea.addEventListener('input', () => {
          const count = descArea.value.length;
          charCounter.textContent = `${count} / 1000`;
          charCounter.classList.toggle('text-blue-light', count >= 900);
          charCounter.classList.toggle('text-white/40', count < 900);
        });
      }

        navigator.clipboard.writeText(text).then(() => {
          const icons = button.querySelectorAll('svg');
          if (icons.length >= 2) {
            icons[0].classList.add('hidden');
            icons[1].classList.remove('hidden');
            button.classList.remove('bg-blue-pale', 'text-blue');
            button.classList.add('bg-green-600', 'text-white');

            setTimeout(() => {
              icons[0].classList.remove('hidden');
              icons[1].classList.add('hidden');
              button.classList.add('bg-blue-pale', 'text-blue');
              button.classList.remove('bg-green-600', 'text-white');
            }, 2000);
          }
      // Form submission
      if (form && btn) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const originalText = btn.innerText;
          btn.innerText = 'Redirigiendo...';
          btn.disabled = true;
          btn.classList.add('opacity-70', 'cursor-not-allowed');

          const nombre = document.getElementById('f-nombre').value.trim() || 'No especificado';
          const tel = document.getElementById('f-tel').value.trim() || 'No especificado';
          const servicioEl = document.getElementById('f-servicio');
          const servicio = servicioEl ? servicioEl.options[servicioEl.selectedIndex].value : 'Consulta general';
          const desc = descArea.value.trim() || 'Sin detalles adicionales';

          const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Detalle:* ${desc}`;
          const encodedMessage = encodeURIComponent(rawMessage);
          const url = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

          window.open(url, '_blank', 'noopener,noreferrer');

          setTimeout(() => {
            btn.innerText = originalText;
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
          }, 2000);
        });
      }
    });
  })();
</script>
