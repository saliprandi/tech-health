---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px]">
      
      <!-- Left Column (Info) -->
      <div>
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
          Estamos aquí para ayudarle
        </h2>
        <p class="font-body font-light text-[16px] text-text-soft mb-10 max-w-[480px]">
          Contáctenos para programar una visita técnica, presupuestar una reparación o realizar consultas sobre nuestros servicios.
        </p>

        <div class="flex flex-col gap-6">
          
          <!-- WhatsApp -->
          <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.075l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
            </div>
          </a>

          <!-- Location -->
          <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" aria-label="Ver en Google Maps" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.direccion}</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.ciudad_completa}</div>
              <div class="font-body font-medium text-[12px] text-blue mt-1 group-hover:underline">Abrir en Google Maps &rarr;</div>
            </div>
          </a>

          <!-- Hours -->
          <div class="flex items-start gap-4 p-4 rounded-[12px] border border-transparent">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
                <span id="status-badge" class="hidden font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full"></span>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Horario de atención</div>
              <div class="font-body text-[14px] text-text-soft flex items-center gap-3">
                {CONFIG.contacto.horario}
                <span id="status-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"></span>
              </div>
              <div class="flex items-center gap-3 mb-1">
                <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
                <span id="status-badge" class="hidden font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500"></span>
              </div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
            </div>
          </div>

          <!-- Email (Conditional) -->
          {CONFIG.contacto.email && (
            <a href={`mailto:${CONFIG.contacto.email}`} class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
              <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <div class="font-heading font-bold text-[16px] text-navy mb-1">Correo Electrónico</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.email}</div>
              </div>
            </a>
          )}

        </div>
      </div>

      <!-- Right Column (Form) -->
      <div>
        <div class="bg-navy rounded-card p-8 md:p-11 shadow-hero-card">
          <h3 class="font-heading font-bold text-[24px] text-white mb-6">Envíenos su consulta</h3>
          
          <form id="contact-form" class="flex flex-col gap-5">
            
            <div class="flex flex-col gap-1.5">
              <label for="f-nombre" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Nombre completo <span class="text-blue-light">*</span>
              </label>
              <label for="f-nombre" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Nombre completo <span class="text-blue-light">*</span></label>
              <input type="text" id="f-nombre" required placeholder="Ej: Dr. Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-tel" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Teléfono / WhatsApp <span class="text-blue-light">*</span>
              </label>
              <label for="f-tel" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Teléfono / WhatsApp <span class="text-blue-light">*</span></label>
              <input type="tel" id="f-tel" required placeholder="Ej: 381 123 4567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
              <div class="relative">
                <select id="f-servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light transition-colors w-full appearance-none pr-10">
                  <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                  <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                  <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                  <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </div>

            <div class="flex flex-col gap-1.5 mb-2">
              <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
              <textarea id="f-desc" rows="3" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
            </div>

            <button type="submit" id="f-submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-colors shadow-sm mt-2 disabled:opacity-70 disabled:cursor-not-allowed">
            <button type="submit" id="f-submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-all shadow-sm mt-2 disabled:opacity-70 disabled:cursor-not-allowed">
              Enviar por WhatsApp
            </button>
            <p class="font-body text-[12px] text-white/40 text-center mt-2">
              Será redirigido a WhatsApp para enviar el mensaje.
            </p>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ whatsappNumber: CONFIG.contacto.whatsapp }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Business Hours Status Badge Logic
    const statusBadge = document.getElementById('status-badge');
    if (statusBadge) {
      const now = new Date();
      // Calculate Tucumán time (UTC-3)
      const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
      const day = tucumanTime.getDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
      const hour = tucumanTime.getHours();

      // Business hours: Monday (1) to Friday (5), 09:00 to 18:00
      const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

      if (isOpen) {
        statusBadge.innerText = 'Abierto ahora';
        statusBadge.classList.add('bg-green-100', 'text-green-700');
      } else {
        statusBadge.innerText = 'Cerrado';
        statusBadge.classList.add('bg-amber-100', 'text-amber-700');
      }
      statusBadge.classList.remove('hidden');
    }

    // 1. Business Hours Status
    const updateStatus = () => {
      const badge = document.getElementById('status-badge');
      if (!badge) return;

      const now = new Date();
      // UTC-3 (Tucumán)
      const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
      const day = tucumanTime.getDay(); // 0 is Sunday, 1-5 is Mon-Fri
      const hour = tucumanTime.getHours();

      const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

      if (isOpen) {
        badge.innerText = 'Abierto ahora';
        badge.classList.remove('hidden', 'bg-gray/10', 'text-gray');
        badge.classList.add('bg-blue-pale', 'text-blue');
      } else {
        badge.innerText = 'Cerrado';
        badge.classList.remove('hidden', 'bg-blue-pale', 'text-blue');
        badge.classList.add('bg-gray/10', 'text-gray');
      }
    };

    updateStatus();

    // 2. Form Handling
    // --- Business Hours Logic ---
    const updateStatusBadge = () => {
      const badge = document.getElementById('status-badge');
      if (!badge) return;

      // Tucumán is UTC-3
      const now = new Date();
      const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));

      const day = tucumanTime.getDay(); // 0 (Sun) to 6 (Sat)
      const hour = tucumanTime.getHours();

      // Mon-Fri (1-5), 9:00 to 18:00
      const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

      badge.textContent = isOpen ? 'Abierto ahora' : 'Cerrado';

      if (isOpen) {
        badge.classList.remove('bg-gray-100', 'text-gray-500');
        badge.classList.add('bg-emerald-100', 'text-emerald-600');
      } else {
        badge.classList.remove('bg-emerald-100', 'text-emerald-600');
        badge.classList.add('bg-gray-100', 'text-gray-500');
      }

      badge.classList.remove('hidden');
    };

    updateStatusBadge();
    // Refresh status every minute
    setInterval(updateStatusBadge, 60000);

    // --- Form Logic ---
    const form = document.getElementById('contact-form');
    const btn = document.getElementById('f-submit');
    
    if (form && btn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const nombre = document.getElementById('f-nombre')?.value.trim() || 'No especificado';
        const tel = document.getElementById('f-tel')?.value.trim() || 'No especificado';
        const servicioel = document.getElementById('f-servicio');
        const servicio = servicioel ? servicioel.options[servicioel.selectedIndex].value : 'Consulta general';
        const desc = document.getElementById('f-desc')?.value.trim() || 'Sin detalles adicionales';

        const originalText = btn.textContent;
        btn.textContent = 'Redirigiendo...';
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');

        const rawMessage = `Hola TechHealth! Me comunico desde su web.
*Nombre:* ${nombre}
*Teléfono:* ${tel}
*Servicio:* ${servicio}
*Detalle:* ${desc}`;
        const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Detalle:* ${desc}`;
        const encodedMessage = encodeURIComponent(rawMessage);
        const url = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

        window.open(url, '_blank', 'noopener,noreferrer');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
        const originalText = btn.textContent;
        btn.textContent = 'Redirigiendo...';
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');

        window.open(url, '_blank', 'noopener,noreferrer');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
        }, 2000);
        }, 2000);
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
        }, 3000);
      });
    }
  });
</script>
