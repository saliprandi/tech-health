---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px]">

      <!-- Left Column: Info -->
      <div>
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">Estamos aquí para ayudarle</h2>
        <p class="font-body font-light text-[16px] text-text-soft mb-10 max-w-[480px]">Contáctenos para programar una visita técnica, presupuestar una reparación o realizar consultas sobre nuestros servicios.</p>

        <div class="flex flex-col gap-6">
          
          <!-- WhatsApp -->
          <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border relative">
          <!-- WhatsApp / Phone -->
          <div class="group flex items-center justify-between p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border relative">
            <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 flex-grow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-lg" aria-label="Abrir chat de WhatsApp">
              <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.075l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
              </div>
            </a>
            <button
              class="copy-btn group/btn flex items-center gap-1.5 text-blue hover:text-navy transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded px-2 py-1"
              data-copy={CONFIG.contacto.whatsapp}
              aria-label="Copiar número de WhatsApp"
            >
              <svg class="w-4 h-4 copy-icon transition-transform group-active/btn:scale-90"><use href="#icon-copy" /></svg>
              <svg class="w-4 h-4 check-icon hidden text-green-600"><use href="#icon-check" /></svg>
              <span class="text-[11px] font-bold uppercase tracking-wider btn-text">Copiar</span>
            </button>
          </div>

          <!-- Location -->
          <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border relative">
            <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 flex-grow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-lg" aria-label="Ver ubicación en Google Maps">
              <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.direccion}</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.ciudad_completa}</div>
                <div class="font-body font-medium text-[12px] text-blue mt-1 group-hover:underline">Abrir en Google Maps &rarr;</div>
              </div>
            </a>
            <button
              class="copy-btn absolute top-4 right-4 p-2 rounded-md bg-blue-pale text-blue hover:bg-blue hover:text-white transition-all opacity-0 group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue"
              data-copy={`${CONFIG.contacto.direccion}, ${CONFIG.contacto.ciudad_completa}`}
              aria-label="Copiar dirección"
            >
              <svg class="w-4 h-4 copy-icon"><use href="#icon-copy" /></svg>
              <svg class="w-4 h-4 check-icon hidden text-green-600"><use href="#icon-check" /></svg>
              <span class="sr-only btn-text">Copiar</span>
            </button>
          </div>

          <!-- Email -->
          {CONFIG.contacto.email && (
            <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border relative">
              <a href={`mailto:${CONFIG.contacto.email}`} class="flex items-start gap-4 flex-grow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-lg" aria-label="Enviar correo electrónico">
                <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <div class="font-heading font-bold text-[16px] text-navy mb-1">Correo Electrónico</div>
                  <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.email}</div>
                </div>
              </a>
              <button
                class="copy-btn absolute top-4 right-4 p-2 rounded-md bg-blue-pale text-blue hover:bg-blue hover:text-white transition-all opacity-0 group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue"
                data-copy={CONFIG.contacto.email}
                aria-label="Copiar correo electrónico"
              >
                <svg class="w-4 h-4 copy-icon"><use href="#icon-copy" /></svg>
                <svg class="w-4 h-4 check-icon hidden text-green-600"><use href="#icon-check" /></svg>
                <span class="sr-only btn-text">Copiar</span>
              </button>
            </div>
          )}

          <!-- Hours -->
          <div class="flex items-start gap-4 p-4 rounded-[12px] border border-transparent">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Horario de atención</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column (Form) -->
        </div>
      </div>

      <!-- Right Column: Form -->
      <div>
        <div class="bg-navy rounded-card p-8 md:p-11 shadow-hero-card">
          <h3 class="font-heading font-bold text-[24px] text-white mb-6">Envíenos su consulta</h3>
          <form id="contact-form" class="flex flex-col gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="f-nombre" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Nombre completo</label>
              <input type="text" id="f-nombre" name="nombre" required maxlength="100" autocomplete="name" placeholder="Ej: Dr. Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 transition-colors w-full" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="f-tel" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Teléfono / WhatsApp</label>
              <input type="tel" id="f-tel" name="telefono" required maxlength="30" autocomplete="tel" placeholder="Ej: 381 123 4567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 transition-colors w-full" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
              <div class="relative">
                <select id="f-servicio" name="servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 transition-colors w-full appearance-none pr-10">
                  <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                  <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                  <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                  <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center">
                <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
                <span id="char-counter" class="font-body text-[10px] text-white/40 tracking-tight" aria-live="polite">0 / 1000</span>
              </div>
              <textarea id="f-desc" name="descripcion" rows="3" maxlength="1000" aria-describedby="char-counter" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 transition-colors w-full resize-none"></textarea>
            </div>
            <button id="f-submit" type="submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 shadow-sm mt-2 active:scale-[0.98]">
              Enviar por WhatsApp
            </button>

            <button id="f-submit" type="submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 shadow-sm mt-2 active:scale-[0.98]">
              Enviar por WhatsApp
            </button>
            <p class="font-body text-[12px] text-white/40 text-center mt-2">Será redirigido a WhatsApp para enviar el mensaje.</p>

            <p class="font-body text-[12px] text-white/40 text-center mt-2">
              Será redirigido a WhatsApp para enviar el mensaje.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ whatsappNumber: CONFIG.contacto.whatsapp }}>
  (function() {
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const btn = document.getElementById('f-submit');
      const textarea = document.getElementById('f-desc');
      const charCounter = document.getElementById('char-counter');

      // Click to Copy Logic
      document.querySelectorAll('.copy-btn').forEach(button => {
      const copyBtns = document.querySelectorAll('.copy-btn');

      // Click to Copy Logic
      copyBtns.forEach(button => {
        let isSuccess = false;
        button.addEventListener('click', async (e) => {
          e.preventDefault();
          if (isSuccess) return;


      // Click to Copy Logic
      document.querySelectorAll('.copy-btn').forEach(button => {
        let isSuccess = false;
        button.addEventListener('click', async (e) => {
          e.preventDefault();
          if (isSuccess) return;

          const textToCopy = button.getAttribute('data-copy');
          if (!textToCopy) return;

          try {
            await navigator.clipboard.writeText(textToCopy);
            isSuccess = true;

            const copyIcon = button.querySelector('.copy-icon');
            const checkIcon = button.querySelector('.check-icon');
            const btnText = button.querySelector('.btn-text');
            const originalAriaLabel = button.getAttribute('aria-label');


            const originalText = btnText ? btnText.textContent : 'Copiar';
            const originalAriaLabel = button.getAttribute('aria-label');

            const originalLabel = button.getAttribute('aria-label');
            const originalAriaLabel = button.getAttribute('aria-label');

            if (copyIcon && checkIcon) {
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              button.classList.add('scale-105');

              if (btnText && btnText.textContent !== 'Copiar') {
                const originalText = btnText.textContent;
                btnText.textContent = '¡Copiado!';
                btnText.classList.add('text-green-600');

                setTimeout(() => {
                  btnText.textContent = originalText;
                  btnText.classList.remove('text-green-600');
                }, 2000);
              }

              button.setAttribute('aria-label', 'Información copiada al portapapeles');

              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
                button.classList.remove('scale-105');
                button.setAttribute('aria-label', originalAriaLabel || '');
                isSuccess = false;
              }, 2000);
            }
            if (copyIcon) copyIcon.classList.add('hidden');
            if (checkIcon) checkIcon.classList.remove('hidden');
            button.classList.add('scale-105');


            if (copyIcon && checkIcon && btnText) {
              const originalText = btnText.textContent;
              const originalLabel = button.getAttribute('aria-label');

              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              btnText.textContent = '¡Copiado!';
              btnText.classList.add('text-green-600');
              button.setAttribute('aria-label', '¡Información copiada!');

              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
                btnText.textContent = originalText;
                btnText.classList.remove('text-green-600');
                button.setAttribute('aria-label', originalLabel || '');
                isSuccess = false;
              }, 2000);
            }
            const originalAriaLabel = button.getAttribute('aria-label');

            copyIcon?.classList.add('hidden');
            checkIcon?.classList.remove('hidden');
            button.classList.add('scale-105');

            const originalText = btnText ? btnText.textContent : 'Copiar';
            const originalAriaLabel = button.getAttribute('aria-label');

            if (copyIcon) copyIcon.classList.add('hidden');
            if (checkIcon) checkIcon.classList.remove('hidden');
            if (btnText) {
              const originalText = btnText.textContent;
              btnText.textContent = '¡Copiado!';
              btnText.classList.add('text-green-600');

              setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
                button.classList.remove('scale-105');
                btnText.textContent = originalText;
                btnText.classList.remove('text-green-600');
                button.setAttribute('aria-label', originalAriaLabel || '');
                isSuccess = false;
              }, 2000);
            } else {
               setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
                button.classList.remove('scale-105');
                isSuccess = false;
              }, 2000);
            }
            button.setAttribute('aria-label', 'Información copiada');

            button.classList.add('scale-105');
            button.setAttribute('aria-label', 'Información copiada al portapapeles');
            button.setAttribute('aria-label', 'Información copiada');
            }
            button.setAttribute('aria-label', 'Información copiada');

            setTimeout(() => {
              copyIcon?.classList.remove('hidden');
              checkIcon?.classList.add('hidden');
              button.classList.remove('scale-105');
              if (copyIcon) copyIcon.classList.remove('hidden');
              if (checkIcon) checkIcon.classList.add('hidden');
              button.classList.remove('scale-105');
              copyIcon?.classList.remove('hidden');
              checkIcon?.classList.add('hidden');
              button.classList.remove('scale-105');
              if (btnText) {
                btnText.textContent = 'Copiar';
                btnText.classList.remove('text-green-600');
              }
              button.classList.remove('scale-105');
              button.setAttribute('aria-label', originalLabel || '');
            button.classList.add('scale-105');
            button.setAttribute('aria-label', 'Información copiada al portapapeles');

            setTimeout(() => {
              if (copyIcon) copyIcon.classList.remove('hidden');
              if (checkIcon) checkIcon.classList.add('hidden');
              if (btnText) {
                btnText.textContent = 'Copiar';
                btnText.classList.remove('text-green-600');
              }
              button.classList.remove('scale-105');
              button.setAttribute('aria-label', originalAriaLabel || '');
              isSuccess = false;
            }, 2000);
          } catch (err) {
            console.error('Error al copiar:', err);
          }
        });
      });

      // Character counter
      if (textarea && charCounter) {
        textarea.addEventListener('input', () => {
          const count = textarea.value.length;
      // Character counter logic
      if (textarea && charCounter) {
        textarea.addEventListener('input', () => {
          const count = textarea.value.length;
          charCounter.textContent = count + ' / 1000';
      // Character counter
      if (textarea instanceof HTMLTextAreaElement && charCounter) {
        textarea.addEventListener('input', () => {
          const count = textarea.value.length;
          charCounter.textContent = `${count} / 1000`;
          charCounter.classList.toggle('text-blue-light', count >= 900);
          charCounter.classList.toggle('text-white/40', count < 900);
        });
      }

      // Form submission
      if (form instanceof HTMLFormElement && btn instanceof HTMLButtonElement) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const originalText = btn.innerText;
          btn.innerText = 'Redirigiendo...';
          btn.disabled = true;
          btn.classList.add('opacity-70', 'cursor-not-allowed');

          const nombre = document.getElementById('f-nombre').value.trim() || 'No especificado';
          const tel = document.getElementById('f-tel').value.trim() || 'No especificado';
          const servicioEl = document.getElementById('f-servicio');
          const servicio = servicioEl ? servicioEl.options[servicioEl.selectedIndex].value : 'Consulta general';
          const desc = textarea ? textarea.value.trim() : 'Sin detalles adicionales';
          const nombreEl = document.getElementById('f-nombre');
          const telEl = document.getElementById('f-tel');
          const servicioEl = document.getElementById('f-servicio');

          const nombre = nombreEl ? nombreEl.value.trim() : 'No especificado';
          const tel = telEl ? telEl.value.trim() : 'No especificado';
          const servicio = servicioEl ? servicioEl.options[servicioEl.selectedIndex].value : 'Consulta general';
          const desc = textarea ? textarea.value.trim() : 'Sin detalles adicionales';
          const nombre = (nombreEl instanceof HTMLInputElement) ? nombreEl.value.trim() : 'No especificado';
          const tel = (telEl instanceof HTMLInputElement) ? telEl.value.trim() : 'No especificado';
          const servicio = (servicioEl instanceof HTMLSelectElement) ? servicioEl.options[servicioEl.selectedIndex].value : 'Consulta general';
          const desc = (textarea instanceof HTMLTextAreaElement) ? textarea.value.trim() : 'Sin detalles adicionales';

          const rawMessage = "Hola TechHealth! Me comunico desde su web.\n*Nombre:* " + nombre + "\n*Teléfono:* " + tel + "\n*Servicio:* " + servicio + "\n*Detalle:* " + desc;
          const url = "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(rawMessage);

          window.open(url, '_blank', 'noopener,noreferrer');

          setTimeout(() => {
            btn.innerText = originalText;
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
          }, 2000);
        });
      }
    });
  })();
</script>
