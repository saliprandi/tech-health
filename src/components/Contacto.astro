---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding content-visibility-auto">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Columna izquierda: Info -->
      <div class="flex flex-col gap-8">
        <div>
          <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
          <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] text-navy mb-6">Estamos aquí para ayudarle</h2>
          <p class="font-body text-[16px] text-text-soft max-w-md">
            Póngase en contacto con nuestro equipo técnico para coordinar mantenimientos, reparaciones o consultas sobre equipamiento electromédico en Tucumán y el NOA.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <!-- WhatsApp Card -->
          <div class="group relative flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border transition-colors">
            <a href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-0 rounded-[12px] outline-none group-focus-visible:ring-2 group-focus-visible:ring-blue group-focus-visible:ring-inset" aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}></a>
            <div class="relative z-10 w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 transition-transform group-hover:scale-110 group-focus-visible:scale-110 pointer-events-none">
              <svg class="w-5 h-5 group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-phone" />
              </svg>
            </div>
            <div class="relative z-10 flex-grow">
              <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
              <div id="phone-text" class="font-body text-[14px] text-text-soft select-text pointer-events-auto">{CONFIG.contacto.whatsapp_display}</div>
              <div class="flex items-center gap-3 mt-2 pointer-events-auto">
                <button type="button" id="copy-phone" class="relative z-20 flex items-center gap-1.5 font-body font-medium text-[12px] text-text-soft hover:text-blue transition-colors cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-blue rounded-sm" aria-label="Copiar teléfono al portapapeles">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" aria-hidden="true"><use id="copy-phone-icon-use" href="#icon-copy" /></svg>
                  <span id="copy-phone-text" class="pointer-events-none">Copiar</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Laboratorio Card -->
          <div class="group relative flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border transition-colors">
            <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-0 rounded-[12px] outline-none group-focus-visible:ring-2 group-focus-visible:ring-blue group-focus-visible:ring-inset" aria-label={`Ver en Google Maps: ${CONFIG.contacto.direccion}, ${CONFIG.contacto.ciudad_completa}`}></a>
            <div class="relative z-10 w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 transition-transform group-hover:scale-110 group-focus-visible:scale-110 pointer-events-none">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-map-pin" />
              </svg>
            </div>
            <div class="relative z-10 flex-grow">
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
              <div id="address-text" class="font-body text-[14px] text-text-soft select-text pointer-events-auto">{CONFIG.contacto.direccion}, {CONFIG.contacto.ciudad_completa}</div>
              <div class="flex items-center gap-3 mt-2 pointer-events-auto">
                <button type="button" id="copy-address" class="relative z-20 flex items-center gap-1.5 font-body font-medium text-[12px] text-text-soft hover:text-blue transition-colors cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-blue rounded-sm" aria-label="Copiar dirección al portapapeles">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" aria-hidden="true"><use id="copy-address-icon-use" href="#icon-copy" /></svg>
                  <span id="copy-address-text" class="pointer-events-none">Copiar</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Horario Card -->
          <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border transition-colors">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 transition-transform group-hover:scale-110 group-focus-visible:scale-110">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-clock" />
              </svg>
            </div>
            <div class="flex-grow">
              <div class="flex items-center gap-2 mb-1">
                <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
                <div id="status-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"></div>
              </div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
            </div>
          </div>
        </div>

        <!-- Shared Announcement for Accessibility -->
        <div id="copy-announcement" class="sr-only" aria-live="polite"></div>
      </div>

      <!-- Right Column: Form -->
      <div class="bg-navy rounded-card p-8 md:p-10 shadow-hero-card">
        <form id="contact-form" class="flex flex-col gap-5" data-whatsapp={CONFIG.contacto.whatsapp}>
          <!-- Honeypot -->
          <div class="hidden" aria-hidden="true">
            <label for="f-website">Website</label>
            <input type="text" name="website" id="f-website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="f-nombre" class="font-body font-medium text-[13px] text-white/80">Nombre completo <span class="text-blue-light" aria-hidden="true">*</span></label>
            <input type="text" id="f-nombre" name="nombre" required maxlength="100" placeholder="Ej: Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full placeholder:text-white/30 focus-visible:ring-2 focus-visible:ring-blue/40 outline-none" />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="f-tel" class="font-body font-medium text-[13px] text-white/80">Teléfono / WhatsApp <span class="text-blue-light" aria-hidden="true">*</span></label>
            <input type="tel" id="f-tel" name="telefono" required maxlength="20" pattern="[0-9+ \-()]*" placeholder="Ej: +54 9 381 1234567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full placeholder:text-white/30 focus-visible:ring-2 focus-visible:ring-blue/40 outline-none" />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
            <div class="relative">
              <select id="f-servicio" name="servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue transition-colors w-full appearance-none pr-10">
                <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="f-desc" class="font-body font-medium text-[13px] text-white/80">Mensaje</label>
            <div class="relative">
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" placeholder="Escriba su consulta aquí..." aria-describedby="char-counter" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full resize-none placeholder:text-white/30 focus-visible:ring-2 focus-visible:ring-blue/40 outline-none"></textarea>
              <div id="char-counter" class="absolute bottom-3 right-3 text-[10px] text-white/40 font-body" aria-hidden="true">0 / 500</div>
            </div>
          </div>

          <p class="font-body text-[12px] text-white/50 text-center">El mensaje le redirigirá a WhatsApp</p>

          <button type="submit" id="f-submit" class="group w-full bg-white text-navy font-heading font-bold py-4 rounded-[8px] transition-all hover:bg-white/90 active:scale-[0.98] flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-blue/40 outline-none">
            <svg class="w-5 h-5 fill-current group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" aria-hidden="true">
              <use href="#icon-whatsapp" />
            </svg>
            <span id="f-submit-text">Enviar por WhatsApp</span>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    function initContacto() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const desc = document.getElementById('f-desc') as HTMLTextAreaElement | null;
      const counter = document.getElementById('char-counter');
      const copyAnnouncement = document.getElementById('copy-announcement');
      const submitBtn = document.getElementById('f-submit') as HTMLButtonElement | null;
      const submitBtnText = document.getElementById('f-submit-text');
      const badge = document.getElementById('status-badge');

      if (!form) return () => {};
      const whatsappNumber = form.dataset.whatsapp || '';

      // --- Business Hours Status (UTC-3 Tucumán) ---
      let statusInterval: ReturnType<typeof setInterval> | null = null;
      const tucumanFormatter = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Argentina/Tucuman',
        hour12: false,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      });

      const updateStatusBadge = () => {
        if (!badge) return;
        const now = new Date();
        let tucumanDate: Date;
        try {
          const parts = tucumanFormatter.formatToParts(now);
          const getPart = (type: string) => parts.find(p => p.type === type)?.value;
          const dateStr = `${getPart('year')}-${getPart('month')}-${getPart('day')}T${getPart('hour')}:${getPart('minute')}:${getPart('second')}`;
          tucumanDate = new Date(dateStr);
        } catch {
          tucumanDate = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
        }

        const day = tucumanDate.getDay();
        const hour = tucumanDate.getHours();
        const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

        badge.classList.remove('hidden');
        if (isOpen) {
          badge.innerHTML = '<span class="relative flex h-2 w-2" aria-hidden="true"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span> Abierto ahora';
          badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        } else {
          badge.textContent = 'Cerrado';
          badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-800';
        }
      };
      updateStatusBadge();
      statusInterval = setInterval(updateStatusBadge, 60000);

      // --- Character Counter ---
      const updateCounter = () => {
        if (!desc || !counter) return;
        const len = desc.value.length;
        counter.textContent = `${len} / 500`;
        counter.classList.toggle('text-blue-light', len >= 450);
        counter.classList.toggle('text-white/40', len < 450);
      };
      desc?.addEventListener('input', updateCounter);
      updateCounter();

      // --- Clipboard Helper ---
      const setupCopy = (btnId: string, textId: string, iconId: string, contentId: string, announcementMsg: string) => {
        const btn = document.getElementById(btnId);
        const text = document.getElementById(textId);
        const iconUse = document.getElementById(iconId);
        const contentEl = document.getElementById(contentId);

        if (!btn || !text || !iconUse || !contentEl) return () => {};

        const handleCopy = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          if (!navigator.clipboard) return;

          const originalText = text.textContent || 'Copiar';
          const originalIcon = iconUse.getAttribute('href') || '#icon-copy';
          const contentToCopy = contentEl.textContent?.trim() || '';

          navigator.clipboard.writeText(contentToCopy).then(() => {
            text.textContent = '¡Copiado!';
            iconUse.setAttribute('href', '#icon-check');
            btn.classList.add('text-blue', 'scale-110');
            if (copyAnnouncement) copyAnnouncement.textContent = announcementMsg;

            setTimeout(() => {
              text.textContent = originalText;
              iconUse.setAttribute('href', originalIcon);
              btn.classList.remove('text-blue', 'scale-110');
              if (copyAnnouncement) copyAnnouncement.textContent = '';
            }, 2500);
          });
        };
        btn.addEventListener('click', handleCopy);
        return () => btn.removeEventListener('click', handleCopy);
      };

      const cleanupCopyPhone = setupCopy('copy-phone', 'copy-phone-text', 'copy-phone-icon-use', 'phone-text', 'Teléfono copiado al portapapeles');
      const cleanupCopyAddress = setupCopy('copy-address', 'copy-address-text', 'copy-address-icon-use', 'address-text', 'Dirección copiada al portapapeles');

      // --- Form Submission ---
      const handleSubmit = (e: Event) => {
        e.preventDefault();
        const formData = new FormData(form);
        const honey = formData.get('website');
        if (honey) return;

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const nombre = (formData.get('nombre') as string || '').trim();
        const tel = (formData.get('telefono') as string || '').trim();
        const servicio = formData.get('servicio') as string || 'Consulta general';
        const mensaje = (formData.get('mensaje') as string || '').trim();

        const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Mensaje:* ${mensaje}`;
        const sanitizedWa = whatsappNumber.replace(/\D/g, '');
        const url = `https://wa.me/${sanitizedWa}?text=${encodeURIComponent(rawMessage)}`;

        if (submitBtn && submitBtnText) {
          const originalBtnText = submitBtnText.textContent;
          submitBtnText.textContent = 'Redirigiendo...';
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

          setTimeout(() => {
            if (submitBtnText) submitBtnText.textContent = originalBtnText;
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
            }
          }, 3000);
        }

        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      };
      form.addEventListener('submit', handleSubmit);

      return () => {
        if (statusInterval) clearInterval(statusInterval);
        desc?.removeEventListener('input', updateCounter);
        cleanupCopyPhone();
        cleanupCopyAddress();
        form.removeEventListener('submit', handleSubmit);
      };
    }

    let cleanup = initContacto();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initContacto();
    });
  })();
</script>
