---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px]">

      <!-- Left Column (Info) -->
      <div>
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
          Estamos aquí para ayudarle
        </h2>
        <p class="font-body font-light text-[16px] text-text-soft mb-10 max-w-[480px]">
          Contáctenos para programar una visita técnica, presupuestar una reparación o realizar consultas sobre nuestros servicios.
        </p>

        <div class="flex flex-col gap-6">

          <!-- WhatsApp -->
          <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-phone" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
            </div>
          </a>

          <!-- Location -->
          <div class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-map-pin" />
              </svg>
            </div>
            <div class="flex-grow">
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
              <div id="address-text" class="font-body text-[14px] text-text-soft">{CONFIG.contacto.direccion}, {CONFIG.contacto.ciudad_completa}</div>

              <div class="flex items-center gap-4 mt-2">
                <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir laboratorio en Google Maps: ${CONFIG.contacto.direccion}`} class="font-body font-medium text-[12px] text-blue hover:underline">
                  Ver mapa &rarr;
                </a>
                <button id="copy-address" class="flex items-center gap-1.5 font-body font-medium text-[12px] text-text-soft hover:text-blue transition-colors group/copy" aria-label="Copiar dirección al portapapeles">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor">
                    <use id="copy-icon-use" href="#icon-copy" />
                  </svg>
                  <span id="copy-text">Copiar</span>
                </button>
                <div id="copy-announcement" class="sr-only" aria-live="polite"></div>
              </div>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4 p-4 rounded-[12px] border border-transparent">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <use href="#icon-clock" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
                <span id="status-badge" class="hidden inline-flex items-center gap-1.5 font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500" aria-live="polite"></span>
              </div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
            </div>
          </div>

          <!-- Email (Conditional) -->
          {CONFIG.contacto.email && (
            <a href={`mailto:${CONFIG.contacto.email}`} class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
              <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-mail" />
                </svg>
              </div>
              <div>
                <div class="font-heading font-bold text-[16px] text-navy mb-1">Correo Electrónico</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.email}</div>
              </div>
            </a>
          )}

        </div>
      </div>

      <!-- Right Column (Form) -->
      <div>
        <div class="bg-navy rounded-card p-8 md:p-11 shadow-hero-card">
          <h3 class="font-heading font-bold text-[24px] text-white mb-6">Envíenos su consulta</h3>

          <form id="contact-form" class="flex flex-col gap-5" data-whatsapp={CONFIG.contacto.whatsapp}>

            <div class="flex flex-col gap-1.5">
              <label for="f-nombre" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Nombre completo <span class="text-blue-light">*</span>
              </label>
              <input type="text" id="f-nombre" name="nombre" required maxlength="100" autocomplete="name" placeholder="Ej: Dr. Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-tel" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Teléfono / WhatsApp <span class="text-blue-light">*</span>
              </label>
              <input type="tel" id="f-tel" name="telefono" required maxlength="30" autocomplete="tel" placeholder="Ej: 381 123 4567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
              <div class="relative">
                <select id="f-servicio" name="servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light transition-colors w-full appearance-none pr-10">
                  <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                  <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                  <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                  <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-chevron-down" />
                </svg>
              </div>
            </div>

            <div class="flex flex-col gap-1.5 mb-2">
              <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" aria-describedby="char-counter" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
              <div id="char-counter" class="font-body text-[11px] text-white/40 text-right mt-1">0 / 500</div>
            </div>

            <button type="submit" id="f-submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-all shadow-sm mt-2 disabled:opacity-70 disabled:cursor-not-allowed">
              <span id="f-submit-text">Enviar por WhatsApp</span>
            </button>
            <p class="font-body text-[12px] text-white/40 text-center mt-2">
              Será redirigido a WhatsApp para enviar el mensaje.
            </p>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initContacto() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return () => {};

    const whatsappNumber = form.getAttribute('data-whatsapp') || '';
    const badge = document.getElementById('status-badge');
    const textarea = document.getElementById('f-desc') as HTMLTextAreaElement | null;
    const counter = document.getElementById('char-counter');
    const copyBtn = document.getElementById('copy-address');
    const addressText = document.getElementById('address-text')?.textContent || '';
    const copyLabel = document.getElementById('copy-text');
    const copyIconUse = document.getElementById('copy-icon-use');
    const submitBtn = document.getElementById('f-submit') as HTMLButtonElement | null;
    const submitBtnText = document.getElementById('f-submit-text');

    const updateStatusBadge = () => {
      if (!badge) return;
      const now = new Date();
      const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
      const day = tucumanTime.getDay();
      const hour = tucumanTime.getHours();
      const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

      if (isOpen) {
        badge.innerHTML = '<span class="relative flex h-2 w-2" aria-hidden="true"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span> Abierto ahora';
        badge.className = 'inline-flex items-center gap-1.5 font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500 bg-emerald-100 text-emerald-800';
      } else {
        badge.textContent = 'Cerrado';
        badge.className = 'inline-flex items-center gap-1.5 font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500 bg-gray-100 text-gray-800';
      }
      badge.classList.remove('hidden');
    };

    updateStatusBadge();
    const statusInterval = setInterval(updateStatusBadge, 60000);

    const updateCounter = () => {
      if (!textarea || !counter) return;
      const length = textarea.value.length;
      counter.textContent = `${length} / 500`;
      if (length >= 450) {
        counter.classList.add('text-blue-light');
        counter.classList.remove('text-white/40');
      } else {
        counter.classList.remove('text-blue-light');
        counter.classList.add('text-white/40');
      }
    };

    textarea?.addEventListener('input', updateCounter);
    updateCounter();

    const handleCopy = () => {
      if (!copyLabel || !copyIconUse || !copyBtn) return;
      const originalText = copyLabel.textContent;
      const originalIcon = copyIconUse.getAttribute('href');

      navigator.clipboard.writeText(addressText).then(() => {
        copyLabel.textContent = '¡Copiado!';
        copyIconUse.setAttribute('href', '#icon-check');
        copyBtn.classList.add('text-blue');
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = originalText;
          if (copyIconUse) copyIconUse.setAttribute('href', originalIcon || '#icon-copy');
          if (copyBtn) copyBtn.classList.remove('text-blue');
        }, 2500);
      });
    };

    copyBtn?.addEventListener('click', handleCopy);

    const handleSubmit = (e: Event) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const nombre = (document.getElementById('f-nombre') as HTMLInputElement)?.value.trim() || 'No especificado';
      const tel = (document.getElementById('f-tel') as HTMLInputElement)?.value.trim() || 'No especificado';
      const servicioel = document.getElementById('f-servicio') as HTMLSelectElement | null;
      const servicio = servicioel ? servicioel.options[servicioel.selectedIndex].value : 'Consulta general';
      const desc = (document.getElementById('f-desc') as HTMLTextAreaElement)?.value.trim() || 'Sin detalles adicionales';

      if (submitBtn && submitBtnText) {
        const originalBtnText = submitBtnText.textContent;
        submitBtnText.textContent = 'Redirigiendo...';
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
        const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Detalle:* ${desc}`;
        const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(rawMessage)}`;
        window.open(url, '_blank', 'noopener,noreferrer');
        setTimeout(() => {
          if (submitBtnText) submitBtnText.textContent = originalBtnText;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }
        }, 3000);
      }
    };

    form.addEventListener('submit', handleSubmit);

    return () => {
      clearInterval(statusInterval);
      textarea?.removeEventListener('input', updateCounter);
      copyBtn?.removeEventListener('click', handleCopy);
      form.removeEventListener('submit', handleSubmit);
    };
  }

  let cleanup: (() => void) | undefined;
  cleanup = initContacto();
  document.addEventListener('astro:after-swap', () => {
    if (cleanup) cleanup();
    cleanup = initContacto();
  });
</script>
