---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <!-- Header centrado -->
      <div class="text-center mb-12">
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] text-navy mb-4">Estamos aquí para ayudarle</h2>
      </div>

      <!-- Info cards centrados -->
      <div class="flex flex-col md:flex-row justify-center gap-4 mb-12 max-w-3xl mx-auto">
        <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border flex-1">
          <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 group-hover:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <use href="#icon-phone" />
            </svg>
          </div>
          <div>
            <div class="font-heading font-bold text-[16px] text-navy mb-0.5">WhatsApp / Teléfono</div>
            <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
          </div>
        </a>
        <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border flex-1">
          <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-map-pin" /></svg>
          </div>
          <div class="flex-grow min-w-0">
            <div class="font-heading font-bold text-[16px] text-navy mb-0.5">Laboratorio</div>
            <div id="address-text" class="font-body text-[14px] text-text-soft truncate">{CONFIG.contacto.direccion}, {CONFIG.contacto.ciudad_completa}</div>
            <div class="flex items-center gap-3 mt-1">
              <span id="copy-address" role="button" tabindex="0" class="flex items-center gap-1.5 font-body font-medium text-[12px] text-text-soft hover:text-blue transition-colors cursor-pointer" aria-label="Copiar dirección al portapapeles">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor"><use id="copy-icon-use" href="#icon-copy" /></svg>
                <span id="copy-text">Copiar</span>
              </span>
              <div id="copy-announcement" class="sr-only" aria-live="polite"></div>
            </div>
          </div>
        </a>
        <div class="group flex items-center gap-4 p-4 rounded-[12px] hover:bg-off-white border border-transparent hover:border-border flex-1">
          <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor"><use href="#icon-clock" /></svg>
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-2 mb-0.5">
              <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
              <div id="status-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"></div>
            </div>
            <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
          </div>
        </div>
      </div>

      <!-- Formulario ancho centrado -->
      <div class="bg-navy rounded-card p-8 md:p-12 shadow-hero-card max-w-2xl mx-auto">
        <form id="contact-form" class="flex flex-col gap-5" data-whatsapp={CONFIG.contacto.whatsapp}>
          <div class="flex flex-col gap-1.5">
            <label for="f-nombre" class="font-body font-medium text-[13px] text-white/80">Nombre completo</label>
            <input type="text" id="f-nombre" name="nombre" required maxlength="100" placeholder="Ej: Juan Pérez" aria-label="Nombre completo" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full placeholder:text-white/30" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-tel" class="font-body font-medium text-[13px] text-white/80">Teléfono / WhatsApp</label>
            <input type="tel" id="f-tel" name="telefono" required maxlength="20" pattern="[0-9+ \-()]*" placeholder="Ej: +54 9 381 1234567" aria-label="Teléfono o WhatsApp" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full placeholder:text-white/30" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
            <div class="relative">
              <select id="f-servicio" name="servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 transition-colors w-full appearance-none pr-10">
                <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-desc" class="font-body font-medium text-[13px] text-white/80">Mensaje</label>
            <div class="relative">
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" placeholder="" aria-label="Mensaje" aria-describedby="char-counter" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full resize-none placeholder:text-white/30"></textarea>
              <div id="char-counter" class="absolute bottom-3 right-3 text-[10px] text-white/40 font-body">0 / 500</div>
            </div>
          </div>
          <p class="font-body text-[12px] text-white/50 text-center">El mensaje te redirigirá a WhatsApp</p>
          <button type="submit" id="f-submit" class="group w-full bg-white text-navy font-heading font-bold py-4 rounded-[8px] transition-all hover:bg-white/90 active:scale-[0.98] flex items-center justify-center gap-2">
            <svg class="w-5 h-5 fill-current group-hover:animate-heartbeat" aria-hidden="true">
              <use href="#icon-whatsapp" />
            </svg>
            <span id="f-submit-text">Enviar por WhatsApp</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initContacto() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const desc = document.getElementById('f-desc') as HTMLTextAreaElement | null;
      const counter = document.getElementById('char-counter');
      const copyBtn = document.getElementById('copy-address');
      const copyText = document.getElementById('copy-text');
      const copyAnnouncement = document.getElementById('copy-announcement');
      const copyIconUse = document.getElementById('copy-icon-use');
      const addressEl = document.getElementById('address-text');
      const submitBtn = document.getElementById('f-submit') as HTMLButtonElement | null;
      const submitBtnText = document.getElementById('f-submit-text');

      if (!form) return () => {};
      const whatsappNumber = form.dataset.whatsapp || '';

      // Business Hours Status Badge (UTC-3 Tucumán)
      const badge = document.getElementById('status-badge');
      let statusInterval: ReturnType<typeof setInterval> | null = null;

      const updateStatusBadge = () => {
        if (!badge) return;
        const now = new Date();
        let tucumanDate: Date;
        try {
          const tucumanTimeStr = now.toLocaleString('en-CA', { timeZone: 'America/Argentina/Tucuman', hour12: false });
          tucumanDate = new Date(tucumanTimeStr);
        } catch {
          tucumanDate = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));
        }
        const day = tucumanDate.getDay();
        const hour = tucumanDate.getHours();
        const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

        if (isOpen) {
          badge.innerHTML = '<span class="relative flex h-2 w-2" aria-hidden="true"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span> Abierto ahora';
          badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        } else {
          badge.textContent = 'Cerrado';
          badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-800';
        }
      };

      updateStatusBadge();
      statusInterval = setInterval(updateStatusBadge, 60000);

      // Character Counter
      const updateCounter = () => {
        if (!desc || !counter) return;
        const len = desc.value.length;
        counter.textContent = `${len} / 500`;
        if (len >= 450) {
          counter.classList.add('text-blue-light');
          counter.classList.remove('text-white/40');
        } else {
          counter.classList.remove('text-blue-light');
          counter.classList.add('text-white/40');
        }
      };
      desc?.addEventListener('input', updateCounter);
      updateCounter();

      // Copy Address
      const handleCopy = () => {
        if (!copyBtn || !copyText || !copyIconUse || !addressEl) return;
        if (!navigator.clipboard) return;

        const originalText = copyText.textContent || 'Copiar';
        const originalIcon = copyIconUse.getAttribute('href') || '#icon-copy';
        navigator.clipboard.writeText(addressEl.textContent || '').then(() => {
          copyText.textContent = '¡Copiado!';
          copyIconUse.setAttribute('href', '#icon-check');
          copyBtn.classList.add('text-blue');
          if (copyAnnouncement) copyAnnouncement.textContent = 'Dirección copiada al portapapeles';
          setTimeout(() => {
            copyText.textContent = originalText;
            copyIconUse.setAttribute('href', originalIcon);
            copyBtn.classList.remove('text-blue');
            if (copyAnnouncement) copyAnnouncement.textContent = '';
          }, 2500);
        }).catch(err => {
          console.error('Error copying to clipboard: ', err);
        });
      };
      copyBtn?.addEventListener('click', handleCopy);

      // Form Submit
      const handleSubmit = (e: Event) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const nombre = (document.getElementById('f-nombre') as HTMLInputElement)?.value.trim() || '';
        const tel = (document.getElementById('f-tel') as HTMLInputElement)?.value.trim() || '';
        const servicioel = document.getElementById('f-servicio') as HTMLSelectElement | null;
        const servicio = servicioel ? servicioel.options[servicioel.selectedIndex].value : 'Consulta general';
        const mensaje = (document.getElementById('f-desc') as HTMLTextAreaElement)?.value.trim() || '';
        const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Mensaje:* ${mensaje}`;
        const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(rawMessage)}`;

        if (submitBtn && submitBtnText) {
          const originalBtnText = submitBtnText.textContent;
          submitBtnText.textContent = 'Redirigiendo...';
          submitBtn.disabled = true;
          submitBtn.setAttribute('aria-busy', 'true');
          submitBtn.setAttribute('aria-disabled', 'true');
          submitBtn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          setTimeout(() => {
            submitBtnText.textContent = originalBtnText;
            submitBtn.disabled = false;
            submitBtn.removeAttribute('aria-busy');
            submitBtn.removeAttribute('aria-disabled');
            submitBtn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          }, 3000);
        }

        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      };
      form.addEventListener('submit', handleSubmit);

      return () => {
        if (statusInterval) clearInterval(statusInterval);
        desc?.removeEventListener('input', updateCounter);
        copyBtn?.removeEventListener('click', handleCopy);
        form.removeEventListener('submit', handleSubmit);
      };
    }

    let cleanup = initContacto();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initContacto();
    });
  })();
</script>
