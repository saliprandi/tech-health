---
import { CONFIG } from '../data/config';
---

<section id="contacto" class="bg-white section-padding">
  <div class="container-custom">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px]">
      
      <!-- Left Column (Info) -->
      <div>
        <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Contacto</div>
        <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
          Estamos aquí para ayudarle
        </h2>
        <p class="font-body font-light text-[16px] text-text-soft mb-10 max-w-[480px]">
          Contáctenos para programar una visita técnica, presupuestar una reparación o realizar consultas sobre nuestros servicios.
        </p>

        <div class="flex flex-col gap-6">
          
          <!-- WhatsApp -->
          <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor">
                <use href="#icon-phone" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">WhatsApp / Teléfono</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.whatsapp_display}</div>
            </div>
          </a>

          <!-- Location -->
          <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" aria-label={`Laboratorio: ${CONFIG.contacto.direccion}. Abrir en Google Maps`} class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor">
                <use href="#icon-map-pin" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-[16px] text-navy mb-1">Laboratorio</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.direccion}</div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.ciudad_completa}</div>
              <div class="font-body font-medium text-[12px] text-blue mt-1 group-hover:underline">Abrir en Google Maps &rarr;</div>
            </div>
          </a>

          <!-- Hours -->
          <div class="flex items-start gap-4 p-4 rounded-[12px] border border-transparent">
            <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor">
                <use href="#icon-clock" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <div class="font-heading font-bold text-[16px] text-navy">Horario de atención</div>
                <span id="status-badge" class="hidden font-body font-bold text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full transition-colors duration-500"></span>
              </div>
              <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.horario}</div>
            </div>
          </div>

          <!-- Email (Conditional) -->
          {CONFIG.contacto.email && (
            <a href={`mailto:${CONFIG.contacto.email}`} class="group flex items-start gap-4 p-4 rounded-[12px] hover:bg-off-white transition-colors border border-transparent hover:border-border">
              <div class="w-10 h-10 rounded-full bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke-width="1.5" stroke="currentColor">
                  <use href="#icon-mail" />
                </svg>
              </div>
              <div>
                <div class="font-heading font-bold text-[16px] text-navy mb-1">Correo Electrónico</div>
                <div class="font-body text-[14px] text-text-soft">{CONFIG.contacto.email}</div>
              </div>
            </a>
          )}

        </div>
      </div>

      <!-- Right Column (Form) -->
      <div>
        <div class="bg-navy rounded-card p-8 md:p-11 shadow-hero-card">
          <h3 class="font-heading font-bold text-[24px] text-white mb-6">Envíenos su consulta</h3>
          
          <form id="contact-form" class="flex flex-col gap-5">
            
            <div class="flex flex-col gap-1.5">
              <label for="f-nombre" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Nombre completo <span class="text-blue-light">*</span>
              </label>
              <input type="text" id="f-nombre" name="nombre" required autocomplete="name" placeholder="Ej: Dr. Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
              <input type="text" id="f-nombre" name="nombre" required maxlength="100" autocomplete="name" placeholder="Ej: Dr. Juan Pérez" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-tel" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">
                Teléfono / WhatsApp <span class="text-blue-light">*</span>
              </label>
              <input type="tel" id="f-tel" name="telefono" required autocomplete="tel" placeholder="Ej: 381 123 4567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
              <input type="tel" id="f-tel" name="telefono" required maxlength="30" autocomplete="tel" placeholder="Ej: 381 123 4567" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="f-servicio" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Tipo de servicio</label>
              <div class="relative">
                <select id="f-servicio" name="servicio" class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white focus:outline-none focus:border-blue-light transition-colors w-full appearance-none pr-10">
                  <option value="Consulta general" class="bg-navy text-white">Consulta general</option>
                  <option value="Mantenimiento preventivo" class="bg-navy text-white">Mantenimiento preventivo</option>
                  <option value="Reparación / Mantenimiento correctivo" class="bg-navy text-white">Reparación / Mantenimiento correctivo</option>
                  <option value="Revisión de placa electrónica" class="bg-navy text-white">Revisión de placa electrónica</option>
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" fill="none" stroke-width="2" stroke="currentColor">
                  <use href="#icon-chevron-down" />
                </svg>
              </div>
            </div>

            <div class="flex flex-col gap-1.5 mb-2">
              <div class="flex justify-between items-end">
                <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
                <span id="char-count-msg" class="font-body text-[10px] text-white/40 mb-0.5">0 / 500</span>
              </div>
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" aria-describedby="char-count-msg" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
                <span id="char-count" class="font-body text-[10px] text-white/40 uppercase tracking-wider mb-0.5" aria-live="polite">0 / 500</span>
              </div>
              <textarea id="f-desc" name="mensaje" aria-describedby="char-count" rows="3" maxlength="500" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
              <div class="flex justify-between items-center">
                <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
                <div id="char-counter" class="font-body text-[10px] text-white/40 tabular-nums">0 / 500</div>
              </div>
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" aria-describedby="char-counter" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
              <div class="flex items-center justify-between">
                <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
                <span id="char-count" class="text-[10px] text-white/40 ml-auto">0 / 500</span>
              </div>
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
              <label for="f-desc" class="font-body font-medium text-[11px] uppercase tracking-wider text-white/60">Detalle del equipo / Falla (Opcional)</label>
              <textarea id="f-desc" name="mensaje" rows="3" maxlength="500" aria-describedby="char-counter" placeholder="Describa el equipo y el problema de manera breve..." class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-[14px] text-white placeholder-white/30 focus:outline-none focus:border-blue-light transition-colors w-full resize-none"></textarea>
              <div id="char-counter" class="font-body text-[11px] text-white/40 text-right mt-1">0 / 500</div>
            </div>

            <button type="submit" id="f-submit" class="w-full bg-white text-navy font-heading font-bold text-[15px] py-4 rounded-[8px] hover:bg-blue-pale transition-all shadow-sm mt-2 disabled:opacity-70 disabled:cursor-not-allowed">
              Enviar por WhatsApp
            </button>
            <p class="font-body text-[12px] text-white/40 text-center mt-2">
              Será redirigido a WhatsApp para enviar el mensaje.
            </p>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline define:vars={{ whatsappNumber: CONFIG.contacto.whatsapp }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Business Hours Status Badge Logic
    const updateStatusBadge = () => {
      const badge = document.getElementById('status-badge');
      if (!badge) return;

      // Tucumán is UTC-3
      const now = new Date();
      const tucumanTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) - (3 * 3600000));

      const day = tucumanTime.getDay(); // 0 (Sun) to 6 (Sat)
      const hour = tucumanTime.getHours();

      // Mon-Fri (1-5), 9:00 to 18:00
      const isOpen = day >= 1 && day <= 5 && hour >= 9 && hour < 18;

      badge.textContent = isOpen ? 'Abierto ahora' : 'Cerrado';

      if (isOpen) {
        badge.classList.remove('bg-gray-100', 'text-gray-500');
        badge.classList.add('bg-emerald-100', 'text-emerald-600');
      } else {
        badge.classList.remove('bg-emerald-100', 'text-emerald-600');
        badge.classList.add('bg-gray-100', 'text-gray-500');
      }

      badge.classList.remove('hidden');
    };

    updateStatusBadge();
    // Refresh status every minute
    setInterval(updateStatusBadge, 60000);

    // Form Logic
    const form = document.getElementById('contact-form');
    const btn = document.getElementById('f-submit');
    const descArea = document.getElementById('f-desc');
    const charCount = document.getElementById('char-count-msg');

    if (descArea && charCount) {
      descArea.addEventListener('input', () => {
        const length = descArea.value.length;
        charCount.textContent = `${length} / 500`;

        if (length >= 450) {
          charCount.classList.remove('text-white/40');
          charCount.classList.add('text-blue-light');
        } else {
          charCount.classList.add('text-white/40');
          charCount.classList.remove('text-blue-light');
        }
      });
    const textarea = document.getElementById('f-desc');
    const charCount = document.getElementById('char-count');

    if (textarea && charCount) {
      textarea.addEventListener('input', () => {
        const length = textarea.value.length;
        charCount.textContent = `${length} / 500`;

        if (length >= 450) {
          charCount.classList.add('text-blue-light');
          charCount.classList.remove('text-white/40');
        } else {
          charCount.classList.remove('text-blue-light');
          charCount.classList.add('text-white/40');
        }
      });
    const charCounter = document.getElementById('char-counter');

    if (textarea && charCounter) {
      const updateCounter = () => {
        const length = textarea.value.length;
        charCounter.textContent = `${length} / 500`;

        if (length >= 500) {
          charCounter.classList.add('text-blue-light');
          charCounter.classList.remove('text-white/40');
        } else {
          charCounter.classList.remove('text-blue-light');
          charCounter.classList.add('text-white/40');
    const descArea = document.getElementById('f-desc');
    const charCount = document.getElementById('char-count');

    if (descArea && charCount) {
      descArea.addEventListener('input', () => {
        charCount.textContent = `${descArea.value.length} / 500`;
      });
    const textarea = document.getElementById('f-desc');
    const counter = document.getElementById('char-counter');

    if (textarea && counter) {
      const updateCounter = () => {
        const length = textarea.value.length;
        counter.textContent = length + " / 500";
        if (length >= 500) {
          counter.classList.add('text-blue-light');
        } else {
          counter.classList.remove('text-blue-light');
        }
      };

      textarea.addEventListener('input', updateCounter);
      // Initialize on load to handle pre-filled content
      // Initialize
      updateCounter();
    }
    
    if (form && btn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const nombre = document.getElementById('f-nombre')?.value.trim() || 'No especificado';
        const tel = document.getElementById('f-tel')?.value.trim() || 'No especificado';
        const servicioel = document.getElementById('f-servicio');
        const servicio = servicioel ? servicioel.options[servicioel.selectedIndex].value : 'Consulta general';
        const desc = document.getElementById('f-desc')?.value.trim() || 'Sin detalles adicionales';

        const originalText = btn.textContent;
        btn.textContent = 'Redirigiendo...';
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');

        const rawMessage = `Hola TechHealth! Me comunico desde su web.\n*Nombre:* ${nombre}\n*Teléfono:* ${tel}\n*Servicio:* ${servicio}\n*Detalle:* ${desc}`;
        const encodedMessage = encodeURIComponent(rawMessage);
        const url = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

        window.open(url, '_blank', 'noopener,noreferrer');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
        }, 2000);
      });
    }
  });
</script>
