---
import { CONFIG } from '../data/config';
---

<section id="cobertura" class="bg-off-white section-padding content-visibility-auto scroll-mt-16">
  <div class="container-custom">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Alcance Logístico</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
        {CONFIG.cobertura.titulo}
      </h2>
      <p class="font-body text-[16px] text-text-soft">
        {CONFIG.cobertura.subtitulo}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {CONFIG.cobertura.zonas.map((zona) => (
        <div class="group bg-white rounded-card p-8 border border-border shadow-sm hover:shadow-card-hover hover:border-blue/30 focus-within:border-blue/30 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-6">
              <div class="w-10 h-10 rounded-xl bg-blue-pale text-blue flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-focus-within:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 group-hover:animate-heartbeat group-focus-within:animate-heartbeat" fill="none" stroke="currentColor" aria-hidden="true">
                  <use href="#icon-map-pin" />
                </svg>
              </div>
              <span class="inline-block bg-navy/10 text-navy font-heading font-bold px-3 py-1 rounded-full text-[12px]">
                {zona.badge}
              </span>
            </div>

            <h3 class="font-heading font-bold text-[18px] text-navy mb-3">{zona.nombre}</h3>

            <p class="font-body font-medium text-[14px] text-blue mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" aria-hidden="true">
                <use href="#icon-clock" />
              </svg>
              <span>{zona.tiempo}</span>
            </p>

            <p class="font-body text-[14px] text-text-soft leading-relaxed">
              {zona.detalles}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Callout CTA for regional inquiry -->
    <div class="bg-navy rounded-card p-8 md:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="font-heading font-bold text-[20px] md:text-[22px]">¿Su institución está ubicada fuera de San Miguel de Tucumán?</h3>
        <p class="font-body text-[14px] text-white/80 max-w-2xl">
          Coordinamos la recepción de placas, traslados programados de instrumental médico y atención técnica in-situ para todo el NOA.
        </p>
      </div>
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Hola TechHealth, quisiera consultar factibilidad técnica para nuestra institución.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-blue text-white font-heading font-bold text-[14px] py-3 px-6 rounded-btn hover:bg-blue-light transition-colors shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
      >
        <span>Consultar Factibilidad</span>
        <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" aria-hidden="true">
          <use href="#icon-external" />
        </svg>
      </a>
    </div>

  </div>
</section>
