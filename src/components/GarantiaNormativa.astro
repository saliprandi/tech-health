---
import { CONFIG } from '../data/config';

const { garantia_normativa, contacto } = CONFIG;
---

<section id="garantia" class="bg-white section-padding border-t border-border/80 content-visibility-auto" aria-labelledby="garantia-heading">
  <div class="container-custom">
    <div class="max-w-2xl mb-12">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" aria-hidden="true">
          <use href="#icon-shield-check" />
        </svg>
        <span>Respaldo Institucional</span>
      </div>
      <h2 id="garantia-heading" class="font-heading font-extrabold text-[clamp(28px,4vw,42px)] leading-[1.2] text-navy mb-4">
        {garantia_normativa.titulo}
      </h2>
      <p class="font-body text-[16px] text-text-soft leading-relaxed">
        {garantia_normativa.subtitulo}
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {garantia_normativa.pilares.map((pilar) => (
        <div class="bg-off-white border border-border/60 rounded-card p-6 flex flex-col justify-between hover:bg-white hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300 group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-blue-pale flex items-center justify-center text-blue mb-5 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" aria-hidden="true">
                <use href={`#icon-${pilar.icono}`} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-[18px] text-navy mb-3 leading-snug">{pilar.titulo}</h3>
            <p class="font-body text-[14px] text-text-soft leading-relaxed">{pilar.descripcion}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Box for Audits -->
    <div class="bg-navy rounded-card p-8 md:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-xl relative z-10">
        <h3 class="font-heading font-extrabold text-[22px] md:text-[26px] mb-2 leading-tight">
          ¿Próxima auditoría sanitaria en su sanatorio o clínica?
        </h3>
        <p class="font-body text-[15px] text-white/80 leading-relaxed">
          Entregamos carpetas técnicas digitalizadas con firma profesional para asegurar el cumplimiento normativo exigido por las autoridades sanitarias.
        </p>
      </div>

      <div class="relative z-10 w-full md:w-auto flex-shrink-0">
        <a
          id="garantia-wa-cta"
          href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent('Hola TechHealth! Quisiera consultar sobre los informes técnicos para auditorías de salud e inspecciones de equipamiento.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-navy font-heading font-bold text-[14px] py-3.5 px-6 rounded-xl hover:bg-off-white hover:scale-[1.02] transition-all duration-300 shadow-md outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy group"
        >
          <svg class="garantia-spinner hidden w-4 h-4 animate-spin text-navy" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <svg class="garantia-wa-icon w-5 h-5 fill-current text-navy group-hover:scale-110 transition-transform" aria-hidden="true">
            <use href="#icon-whatsapp" />
          </svg>
          <span class="garantia-btn-text">Consultar por Informes de Auditoría</span>
        </a>
        <span id="garantia-announcement" class="sr-only" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initGarantia() {
      const cta = document.getElementById('garantia-wa-cta') as HTMLAnchorElement | null;
      const announcement = document.getElementById('garantia-announcement');

      if (!cta) return () => {};

      cta.addEventListener('click', (e) => {
        e.preventDefault();
        const textSpan = cta.querySelector('.garantia-btn-text');
        const spinner = cta.querySelector('.garantia-spinner');
        const icon = cta.querySelector('.garantia-wa-icon');

        if (textSpan && spinner && icon) {
          const origText = textSpan.textContent;
          textSpan.textContent = 'Redirigiendo...';
          spinner.classList.remove('hidden');
          icon.classList.add('hidden');
          cta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

          if (announcement) announcement.textContent = 'Redirigiendo a WhatsApp...';

          const href = cta.getAttribute('href');
          if (href) {
            window.open(href, '_blank', 'noopener,noreferrer');
          }

          setTimeout(() => {
            textSpan.textContent = origText;
            spinner.classList.add('hidden');
            icon.classList.remove('hidden');
            cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
            if (announcement) announcement.textContent = '';
          }, 3000);
        }
      });

      return () => {};
    }

    let cleanup = initGarantia();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initGarantia();
    });
  })();
</script>
