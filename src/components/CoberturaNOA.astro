---
import { CONFIG } from '../data/config';

const { cobertura_noa, contacto } = CONFIG;
---

<section id="cobertura-noa" class="scroll-mt-20 py-20 bg-off-white relative" aria-labelledby="cobertura-heading">
  <div class="container-custom px-[5%]">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block text-blue font-semibold text-sm uppercase tracking-wider mb-2 bg-blue/10 px-3 py-1 rounded-full border border-blue/20">
        Alcance Operativo & Tiempos de Respuesta
      </span>
      <h2 id="cobertura-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy tracking-tight leading-tight">
        {cobertura_noa.titulo}
      </h2>
      <p class="mt-4 font-body text-base sm:text-lg text-text-soft max-w-2xl mx-auto">
        {cobertura_noa.subtitulo}
      </p>
    </div>

    <!-- Interactive Tabs Component -->
    <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-card border border-border p-6 sm:p-10">

      <!-- Tablist -->
      <div
        role="tablist"
        aria-label="Zonas de cobertura de servicio técnico"
        class="flex flex-col sm:flex-row gap-2 bg-off-white p-1.5 rounded-xl border border-border mb-8"
      >
        {cobertura_noa.zonas.map((zona, index) => (
          <button
            role="tab"
            id={`tab-${zona.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-${zona.id}`}
            tabindex={index === 0 ? 0 : -1}
            class={`tab-btn flex-1 py-3 px-4 rounded-lg font-heading font-bold text-sm transition-all duration-200 text-center outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 ${
              index === 0
                ? "bg-navy text-white shadow-sm"
                : "text-text-soft hover:text-navy hover:bg-white/60"
            }`}
          >
            {zona.nombre}
          </button>
        ))}
      </div>

      <!-- Tab Panels -->
      <div class="relative min-h-[300px]">
        {cobertura_noa.zonas.map((zona, index) => (
          <div
            role="tabpanel"
            id={`panel-${zona.id}`}
            aria-labelledby={`tab-${zona.id}`}
            tabindex="0"
            class={`tab-panel transition-all duration-300 ${
              index === 0 ? "block opacity-100 scale-100" : "hidden opacity-0 scale-95"
            } outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 rounded-xl p-2`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

              <!-- Left Details -->
              <div class="lg:col-span-7 space-y-6">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="bg-blue/10 text-navy font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-blue/20">
                    {zona.badge}
                  </span>
                  <span class="text-text-soft text-xs font-medium">
                    SLA: <strong class="text-navy">{zona.sla_urgencia}</strong>
                  </span>
                </div>

                <h3 class="font-heading font-extrabold text-2xl text-navy">
                  {zona.nombre}
                </h3>

                <p class="font-body text-text-soft text-base leading-relaxed">
                  {zona.descripcion}
                </p>

                <div class="bg-off-white border border-border rounded-xl p-4 space-y-2">
                  <div class="text-xs font-semibold uppercase text-text-soft tracking-wider">
                    Modalidad de Servicio
                  </div>
                  <div class="font-body text-sm font-medium text-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <use href="#icon-shield-check" />
                    </svg>
                    <span>{zona.modalidad}</span>
                  </div>
                </div>

                <!-- Localities List -->
                <div>
                  <h4 class="text-xs font-semibold text-text-soft uppercase tracking-wider mb-3">
                    Principales Coberturas e Instituciones Atendidas
                  </h4>
                  <ul class="flex flex-wrap gap-2" role="list">
                    {zona.localidades.map(loc => (
                      <li class="inline-flex items-center gap-1.5 bg-navy/5 text-navy text-xs font-semibold px-3 py-1.5 rounded-lg border border-navy/10">
                        <svg class="w-3.5 h-3.5 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span>{loc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Right Card / Action -->
              <div class="lg:col-span-5 bg-navy text-white rounded-xl p-6 sm:p-8 flex flex-col justify-between space-y-6 shadow-md">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-blue-light">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>

                  <h4 class="font-heading font-bold text-xl text-white">
                    ¿Necesita atención técnica inmediata en esta zona?
                  </h4>

                  <p class="text-sm text-text-muted leading-relaxed">
                    Coordinamos intervenciones de urgencia y traslados seguros para equipamiento electromédico crítico.
                  </p>
                </div>

                <a
                  href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(`Hola TechHealth, requiero consultar la cobertura y asistencia técnica para la zona: ${zona.nombre}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center justify-center gap-2 bg-blue text-white font-heading font-bold text-sm py-3.5 px-5 rounded-lg hover:bg-blue-light hover:text-navy transition-all duration-200 active:scale-95 outline-none focus-visible:ring-2 focus-visible:ring-blue-light focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
                >
                  <span>Coordinar Servicio en {zona.nombre.split(' ')[0]}</span>
                  <svg class="w-4 h-4 text-white/80 group-hover:text-navy group-hover:translate-x-0.5 group-focus-visible:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    function initCoberturaTabs() {
      const tablist = document.querySelector('#cobertura-noa [role="tablist"]');
      if (!tablist) return;

      const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('#cobertura-noa [role="tabpanel"]'));

      if (!tabs.length || !panels.length) return;

      function switchTab(newTab: HTMLButtonElement) {
        tabs.forEach(tab => {
          const isSelected = tab === newTab;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.setAttribute('tabindex', isSelected ? '0' : '-1');

          if (isSelected) {
            tab.classList.add('bg-navy', 'text-white', 'shadow-sm');
            tab.classList.remove('text-text-soft', 'hover:text-navy', 'hover:bg-white/60');
          } else {
            tab.classList.remove('bg-navy', 'text-white', 'shadow-sm');
            tab.classList.add('text-text-soft', 'hover:text-navy', 'hover:bg-white/60');
          }
        });

        const targetPanelId = newTab.getAttribute('aria-controls');
        panels.forEach(panel => {
          if (panel.id === targetPanelId) {
            panel.classList.remove('hidden', 'opacity-0', 'scale-95');
            panel.classList.add('block', 'opacity-100', 'scale-100');
          } else {
            panel.classList.add('hidden', 'opacity-0', 'scale-95');
            panel.classList.remove('block', 'opacity-100', 'scale-100');
          }
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => switchTab(tab));

        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          let targetIndex: number | null = null;

          if (e.key === 'ArrowRight') {
            targetIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft') {
            targetIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (e.key === 'Home') {
            targetIndex = 0;
          } else if (e.key === 'End') {
            targetIndex = tabs.length - 1;
          }

          if (targetIndex !== null) {
            e.preventDefault();
            tabs[targetIndex].focus();
            switchTab(tabs[targetIndex]);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCoberturaTabs);
    } else {
      initCoberturaTabs();
    }

    document.addEventListener('astro:after-swap', initCoberturaTabs);
  })();
</script>
