---
import { CONFIG } from '../data/config';
---

<section id="equipos" class="bg-navy py-[80px] px-[5%]">
  <div class="container-custom">
    
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="font-heading font-bold text-blue-light tracking-wide uppercase text-[12px] mb-3">Equipos</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-white mb-4">
        Amplia cobertura en equipamiento médico
      </h2>
      <p class="font-body text-[16px] text-white/60">
        Nuestra experiencia nos permite abarcar una extensa variedad de instrumentos y dispositivos de alta complejidad utilizados en centros de salud.
      </p>
    </div>

    <!-- Equipment Grid -->
    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" role="list">
      {CONFIG.equipos_atendidos.map(equipo => (
        <li class="group flex items-center gap-4 bg-white/5 border border-white/10 rounded-[12px] p-4 hover:bg-white/10 transition-colors duration-300">
          <svg class="w-[28px] h-[28px] text-blue-light flex-shrink-0 group-hover:animate-heartbeat" aria-hidden="true">
            <use href="#icon-ecg" />
          </svg>
          <span class="font-body font-medium text-[13px] text-white/85 leading-tight">
            {equipo}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
