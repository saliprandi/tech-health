---
import { CONFIG } from '../data/config';
---

<div class="fixed bottom-[28px] right-[28px] z-[200] flex flex-col items-end gap-3 pointer-events-none">
  <!-- Tooltip -->
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] px-4 py-2 rounded-[12px] shadow-card-hover border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2 invisible">
    <span id="wa-tooltip-text">¡Hola! ¿En qué podemos ayudarte?</span>
    <div class="absolute bottom-[-6px] right-[16px] w-3 h-3 bg-white border-r border-b border-border rotate-45"></div>
  </div>

  <!-- Button -->
  <a
    id="wa-float-btn"
    href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group w-[58px] h-[58px] bg-[#25D366] rounded-full flex items-center justify-center text-white hover:scale-[1.08] focus-visible:scale-[1.08] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#25D366] transition-all duration-300 shadow-lg pointer-events-auto outline-none"
    style="box-shadow: 0 4px 20px rgba(37,211,102,0.5);"
    aria-label="Contactar por WhatsApp"
  >
    <svg class="w-[30px] h-[30px] fill-current group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" aria-hidden="true">
      <use href="#icon-whatsapp" />
    </svg>
  </a>
</div>

<script>
  (function() {
    function initWaFloat() {
      const tooltip = document.getElementById('wa-tooltip');
      const tooltipText = document.getElementById('wa-tooltip-text');
      const btn = document.getElementById('wa-float-btn');

      if (!tooltip || !tooltipText || !btn) return () => {};

      let initialTimeout: ReturnType<typeof setTimeout> | null = null;
      let feedbackTimer: ReturnType<typeof setTimeout> | null = null;
      let restoreTimer: ReturnType<typeof setTimeout> | null = null;
      let transitionTimer: ReturnType<typeof setTimeout> | null = null;
      let isRedirecting = false;

      const showTooltip = () => {
        if (transitionTimer) {
          clearTimeout(transitionTimer);
          transitionTimer = null;
        }
        tooltip.classList.remove('opacity-0', 'translate-y-2', 'invisible');
        tooltip.classList.add('opacity-100', 'translate-y-0');
      };

      const hideTooltip = (force = false) => {
        if (isRedirecting && !force) return;

        tooltip.classList.add('opacity-0', 'translate-y-2');
        tooltip.classList.remove('opacity-100', 'translate-y-0');

        if (transitionTimer) clearTimeout(transitionTimer);
        transitionTimer = setTimeout(() => {
          if (tooltip.classList.contains('opacity-0')) {
            tooltip.classList.add('invisible');
          }
          transitionTimer = null;
        }, 500);
      };

      const cancelInitialTimeout = () => {
        if (initialTimeout) {
          clearTimeout(initialTimeout);
          initialTimeout = null;
        }
      };

      const handleInteractionStart = () => {
        cancelInitialTimeout();
        showTooltip();
      };

      const handleInteractionEnd = () => {
        hideTooltip();
      };

      const handleBtnClick = (e: MouseEvent) => {
        e.preventDefault();
        cancelInitialTimeout();
        isRedirecting = true;

        const originalText = tooltipText.textContent || '¡Hola! ¿En qué podemos ayudarte?';
        tooltipText.textContent = '¡Redirigiendo!';
        showTooltip();

        btn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

        const href = btn.getAttribute('href');
        if (href) {
          // Sanitize WhatsApp URL before redirection
          const url = new URL(href);
          const phone = url.pathname.split('/').pop() || '';
          const sanitizedPhone = phone.replace(/\D/g, '');
          const text = url.searchParams.get('text') || '';
          const sanitizedHref = `https://wa.me/${sanitizedPhone}${text ? '?text=' + encodeURIComponent(text) : ''}`;

          const a = document.createElement('a');
          a.href = sanitizedHref;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }

        if (feedbackTimer) clearTimeout(feedbackTimer);
        feedbackTimer = setTimeout(() => {
          isRedirecting = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          hideTooltip(true);

          if (restoreTimer) clearTimeout(restoreTimer);
          restoreTimer = setTimeout(() => {
            tooltipText.textContent = originalText;
          }, 500);
        }, 3000);
      };

      initialTimeout = setTimeout(showTooltip, 5000);

      btn.addEventListener('click', handleBtnClick as EventListener);
      btn.addEventListener('mouseenter', handleInteractionStart);
      btn.addEventListener('mouseleave', handleInteractionEnd);
      btn.addEventListener('focus', handleInteractionStart);
      btn.addEventListener('blur', handleInteractionEnd);

      return () => {
        cancelInitialTimeout();
        if (feedbackTimer) clearTimeout(feedbackTimer);
        if (restoreTimer) clearTimeout(restoreTimer);
        if (transitionTimer) clearTimeout(transitionTimer);

        btn.removeEventListener('click', handleBtnClick as EventListener);
        btn.removeEventListener('mouseenter', handleInteractionStart);
        btn.removeEventListener('mouseleave', handleInteractionEnd);
        btn.removeEventListener('focus', handleInteractionStart);
        btn.removeEventListener('blur', handleInteractionEnd);
      };
    }

    let cleanup = initWaFloat();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initWaFloat();
    });
  })();
</script>
