---
import { CONFIG } from '../data/config';
---

<div class="fixed bottom-[28px] right-[28px] z-[200] flex flex-col items-end gap-3 pointer-events-none">
  <!-- Tooltip -->
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] px-4 py-2 rounded-[12px] shadow-card-hover border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2">
    <span id="wa-tooltip-text">¡Hola! ¿En qué podemos ayudarte?</span>
    <div class="absolute bottom-[-6px] right-[16px] w-3 h-3 bg-white border-r border-b border-border rotate-45"></div>
  </div>

  <!-- Button -->
  <a
    id="wa-float-btn"
    href={`https://wa.me/${CONFIG.contacto.whatsapp}`}
    target="_blank"
    rel="noopener noreferrer"
    class="w-[58px] h-[58px] bg-[#25D366] rounded-full flex items-center justify-center text-white hover:scale-[1.08] transition-transform duration-300 shadow-lg pointer-events-auto"
    style="box-shadow: 0 4px 20px rgba(37,211,102,0.5);"
    aria-label="Contactar por WhatsApp"
  >
    <svg class="w-[30px] h-[30px] fill-current">
      <use href="#icon-whatsapp" />
    </svg>
  </a>
</div>

<script>
  function initWaFloat() {
    const tooltip = document.getElementById('wa-tooltip');
    const tooltipText = document.getElementById('wa-tooltip-text');
    const btn = document.getElementById('wa-float-btn');

    const showTooltip = () => {
      if (tooltip) {
        tooltip.classList.remove('opacity-0', 'translate-y-2');
        tooltip.classList.add('opacity-100', 'translate-y-0');
      }
    };

    // Show tooltip after 5 seconds
    setTimeout(showTooltip, 5000);

    // Feedback on click
    if (btn && tooltipText) {
      btn.addEventListener('click', () => {
        const originalText = tooltipText.textContent;
        tooltipText.textContent = '¡Redirigiendo!';

        // Ensure tooltip is visible
        showTooltip();

        // Disable temporarily to provide visual feedback and prevent multiple clicks
        btn.classList.add('opacity-70', 'cursor-not-allowed');

        setTimeout(() => {
          tooltipText.textContent = originalText;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
        }, 3000);
        setTimeout(() => {
          tooltipText.textContent = '¡Hola! ¿En qué podemos ayudarte?';
        }, 3000);

        setTimeout(() => {
          tooltipText.textContent = originalText;
        }, 3000);
        // Ensure tooltip is visible during redirection
        if (tooltip) {
          tooltip.classList.remove('opacity-0', 'translate-y-2');
          tooltip.classList.add('opacity-100', 'translate-y-0');
        }

        setTimeout(() => {
          tooltipText.textContent = originalText;
        }, 3500);
        // Ensure tooltip is visible if it wasn't yet
        tooltip.classList.remove('opacity-0', 'translate-y-2');
        tooltip.classList.add('opacity-100', 'translate-y-0');

        setTimeout(() => {
          tooltipText.textContent = originalText;
        }, 3000);
        // Hide tooltip after a short while and restore text
        setTimeout(() => {
          if (tooltip) {
            tooltip.classList.add('opacity-0', 'translate-y-2');
            tooltip.classList.remove('opacity-100', 'translate-y-0');
          }
          setTimeout(() => {
            tooltipText.textContent = originalText;
          }, 500);
        }, 2000);
      });
    }
  }

  initWaFloat();
  document.addEventListener('astro:after-swap', initWaFloat);
</script>
