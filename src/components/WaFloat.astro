---
import { CONFIG } from '../data/config';
---

<div id="wa-float-container" class="fixed bottom-[28px] right-[28px] z-[200] flex flex-col items-end gap-3 pointer-events-none">
  <!-- Tooltip -->
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] px-4 py-2 rounded-[12px] shadow-card-hover border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2">
    <span id="wa-tooltip-text">¡Hola! ¿En qué podemos ayudarte?</span>
  <!-- Tooltip -->
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] py-2 px-4 rounded-[12px] shadow-lg border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2">
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] px-4 py-2 rounded-[12px] shadow-card-hover border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2">
<div class="fixed bottom-[28px] right-[28px] z-[200] flex flex-col items-end gap-3 pointer-events-none">
  <!-- Tooltip -->
  <div id="wa-tooltip" class="bg-white text-navy font-body font-medium text-[13px] py-2 px-4 rounded-[12px] shadow-card-hover border border-border opacity-0 translate-y-2 transition-all duration-500 ease-out whitespace-nowrap relative mr-2">
    ¡Hola! ¿En qué podemos ayudarte?
    <div class="absolute bottom-[-6px] right-[16px] w-3 h-3 bg-white border-r border-b border-border rotate-45"></div>
  </div>

  <!-- Button -->
  <a id="wa-float-btn" href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="w-[58px] h-[58px] bg-[#25D366] rounded-full flex items-center justify-center text-white hover:scale-[1.08] transition-transform duration-300 shadow-lg pointer-events-auto" style="box-shadow: 0 4px 20px rgba(37,211,102,0.5);" aria-label="Contactar por WhatsApp">
  <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="pointer-events-auto w-[58px] h-[58px] bg-[#25D366] rounded-full flex items-center justify-center text-white hover:scale-[1.08] transition-transform duration-300" style="box-shadow: 0 4px 20px rgba(37,211,102,0.5);" aria-label="Contactar por WhatsApp">
  <a
    href={`https://wa.me/${CONFIG.contacto.whatsapp}`}
    target="_blank"
    rel="noopener noreferrer"
    class="pointer-events-auto w-[58px] h-[58px] bg-[#25D366] rounded-full flex items-center justify-center text-white hover:scale-[1.08] transition-transform duration-300 shadow-lg"
    style="box-shadow: 0 4px 20px rgba(37,211,102,0.5);"
    aria-label="Contactar por WhatsApp"
  >
    <svg class="w-[30px] h-[30px] fill-current">
      <use href="#icon-whatsapp" />
    </svg>
  </a>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('wa-tooltip');
    const tooltipText = document.getElementById('wa-tooltip-text');
    const btn = document.getElementById('wa-float-btn');

    // Show tooltip after 5 seconds
    setTimeout(() => {
      if (tooltip) {
        tooltip.classList.remove('opacity-0', 'translate-y-2');
        tooltip.classList.add('opacity-100', 'translate-y-0');
      }
    }, 5000);

    // Feedback on click
    if (btn && tooltipText && tooltip) {
      btn.addEventListener('click', () => {
        tooltipText.textContent = '¡Redirigiendo!';
    const tooltip = document.getElementById('wa-tooltip');
    if (tooltip) {
      setTimeout(() => {
        tooltip.classList.remove('opacity-0', 'translate-y-2');
        tooltip.classList.add('opacity-100', 'translate-y-0');
      });
    }
  });
</script>
