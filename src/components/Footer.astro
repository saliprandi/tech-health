---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();

type SocialKey = 'instagram' | 'facebook' | 'linkedin';

const socialLinks = [
  { id: 'instagram', label: 'Seguir en Instagram' },
  { id: 'facebook', label: 'Seguir en Facebook' },
  { id: 'linkedin', label: 'Seguir en LinkedIn' }
] as const;

type SocialKey = typeof socialLinks[number]['id'];

const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.id as keyof typeof CONFIG.redes]);
  { name: 'instagram', label: 'Seguir en Instagram' },
  { name: 'facebook', label: 'Seguir en Facebook' },
  { name: 'linkedin', label: 'Seguir en LinkedIn' }
] as const;

type SocialKey = typeof socialLinks[number]['name'];

const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.name as SocialKey]);
type SocialKey = 'instagram' | 'facebook' | 'linkedin';

const socialLinks: { name: SocialKey; label: string }[] = [
  { name: 'instagram', label: 'Seguir en Instagram' },
  { name: 'facebook', label: 'Seguir en Facebook' },
  { name: 'linkedin', label: 'Seguir en LinkedIn' }
];

const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.name]);
const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.name as keyof typeof CONFIG.redes]);
const socialLabels: Record<SocialKey, string> = {
  instagram: 'Seguir en Instagram',
  facebook: 'Seguir en Facebook',
  linkedin: 'Seguir en LinkedIn'
};

const redes = Object.entries(CONFIG.redes).filter(([_, url]) => url) as [SocialKey, string][];
const hasSocials = redes.length > 0;
const socialLinks = Object.entries(CONFIG.redes).filter(([_, url]) => url) as [SocialKey, string][];
const hasSocials = socialLinks.length > 0;
const activeSocials = (Object.entries(CONFIG.redes).filter(([_, url]) => !!url) as [SocialKey, string][]).map(([platform, url]) => ({
  id: platform,
  url,
  label: socialLabels[platform]
}));

const socialLinks: { id: SocialKey; label: string }[] = [
  { id: 'instagram', label: 'Seguir en Instagram' },
  { id: 'facebook', label: 'Seguir en Facebook' },
  { id: 'linkedin', label: 'Seguir en LinkedIn' }
];

const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.id]);
const socialLinks = [
  { id: 'instagram', label: 'Seguir en Instagram' },
  { id: 'facebook', label: 'Seguir en Facebook' },
  { id: 'linkedin', label: 'Seguir en LinkedIn' }
] as const;

type SocialKey = typeof socialLinks[number]['id'];

const activeSocials = socialLinks.filter(social => !!CONFIG.redes[social.id as SocialKey]);
const hasSocials = activeSocials.length > 0;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    <!-- Brand Logo & Back to top -->
    <div class="mb-8">
      <!-- Brand Logo & Back to top -->
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
      <!-- Interactive 'Back to top' link -->
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
      <!-- Interactive 'Back to top' link -->
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
        <img src="/logo-name.svg" alt={CONFIG.empresa.nombre} width="180" height="44" class="h-11 w-auto brightness-0 invert opacity-70 group-hover:opacity-100 transition-opacity" />
      <!-- Interactive 'Back to top' link -->
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
      <a href="#hero" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-all" aria-label="Volver al inicio">
        <img src="/logo-name.svg" alt={CONFIG.empresa.nombre} width="180" height="44" class="h-11 w-auto brightness-0 invert opacity-70 group-hover:opacity-100 transition-opacity" />
        <img
          src="/logo-name.svg"
          alt={CONFIG.empresa.nombre}
          width="180"
          height="44"
          class="h-11 w-auto brightness-0 invert opacity-70 group-hover:opacity-100 transition-opacity"
        />
      </a>
    </div>

    <div class="font-body font-light text-[13px] text-white/50 mb-6">
      {CONFIG.empresa.ciudad}, {CONFIG.empresa.pais} · {CONFIG.contacto.whatsapp_display}
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {redes.map(([platform, url]) => (
        {activeSocials.map(social => (
          <a
            href={CONFIG.redes[social.name]}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
    {activeSocials.length > 0 && (
      <div class="flex items-center gap-4 mb-6">
        {activeSocials.map(social => (
          <a
            href={CONFIG.redes[social.id as SocialKey]}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white focus-visible:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
            aria-label={social.label}
          >
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
        {activeSocials.map(social => (
          <a
            href={CONFIG.redes[social.id as keyof typeof CONFIG.redes]}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark focus-visible:text-white rounded-full p-1"
            aria-label={social.label}
          >
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
            href={CONFIG.redes[social.name as SocialKey]}
        {socialLinks.map(([platform, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white transition-colors focus-visible:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
            aria-label={socialLabels[platform] || `Seguir en ${platform}`}
          >
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href={`#icon-${platform}`} />
        {activeSocials.map(social => (
          <a
            href={CONFIG.redes[social.name as keyof typeof CONFIG.redes]}
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white focus-visible:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
            href={CONFIG.redes[social.id]}
            href={CONFIG.redes[social.id as SocialKey]}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
            aria-label={social.label}
          >
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href={`#icon-${social.name}`} />
              <use href={`#icon-${social.id}`} />
            </svg>
          </a>
        ))}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/30">
      &copy; {year} {CONFIG.empresa.nombre}. Todos los derechos reservados.
    </div>
  </div>
</footer>
