---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
const whatsappLink = `https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`;
---

<footer class="bg-navy-dark py-12 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 font-body font-light text-[13px] text-white/50 mb-8">
      <span>{CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}</span>
      <span class="hidden md:inline" aria-hidden="true">·</span>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 px-1 -mx-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        <svg class="w-3.5 h-3.5 text-blue-light" fill="none" stroke="currentColor" stroke-width="1.5">
          <use href="#icon-whatsapp" />
        </svg>
        {CONFIG.contacto.whatsapp_display}
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-6 mb-8">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-1 focus-visible:-translate-y-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-1 focus-visible:-translate-y-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-1 focus-visible:-translate-y-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/40 border-t border-white/5 pt-8 w-full max-w-md">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. <br class="sm:hidden" /> Todos los derechos reservados.
    </div>
  </div>
</footer>
