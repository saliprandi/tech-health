---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="font-body font-light text-[13px] text-white/70 mb-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
      <a
        href={CONFIG.contacto.maps_url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none px-1 -mx-1 focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm"
        aria-label={`Ver dirección en Google Maps: ${CONFIG.empresa.ciudad}, ${CONFIG.empresa.pais}`}
      >
        {CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}
      </a>
      <span class="text-white/30" aria-hidden="true">·</span>
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none px-1 -mx-1 focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        {CONFIG.contacto.whatsapp_display}
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none p-1 -m-1 focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none p-1 -m-1 focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none p-1 -m-1 focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/60">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
