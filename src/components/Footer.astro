---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-12 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-x-6 gap-y-3 mb-8">
      <a
        href={CONFIG.contacto.maps_url}
        target="_blank"
        rel="noopener noreferrer"
        class="group font-body font-light text-[13px] text-white/70 hover:text-white transition-all duration-300 outline-none focus-visible:ring-1 focus-visible:ring-white/20 focus-visible:-translate-y-0.5 rounded-sm px-1 -mx-1"
        aria-label={`Ver ubicación en Google Maps: ${CONFIG.empresa.ciudad}, ${CONFIG.empresa.pais}`}
      >
        <span class="group-hover:underline decoration-white/30 underline-offset-4">{CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}</span>
      </a>

      <span class="hidden sm:block w-1 h-1 rounded-full bg-white/20" aria-hidden="true"></span>

      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group font-body font-light text-[13px] text-white/70 hover:text-white transition-all duration-300 outline-none focus-visible:ring-1 focus-visible:ring-white/20 focus-visible:-translate-y-0.5 rounded-sm px-1 -mx-1"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        <span class="group-hover:underline decoration-white/30 underline-offset-4">{CONFIG.contacto.whatsapp_display}</span>
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-5 mb-8">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white hover:-translate-y-1 focus-visible:-translate-y-1 transition-all duration-300 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white hover:-translate-y-1 focus-visible:-translate-y-1 transition-all duration-300 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white hover:-translate-y-1 focus-visible:-translate-y-1 transition-all duration-300 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm p-1" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/40 tracking-wide">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
