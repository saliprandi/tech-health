---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="font-body font-light text-[13px] text-white/50 mb-6 flex items-center justify-center gap-2 flex-wrap">
      <span>{CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}</span>
      <span aria-hidden="true">·</span>
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-white focus-visible:text-white underline-offset-4 hover:underline focus-visible:underline outline-none rounded-sm focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark transition-all group"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        <svg class="w-3.5 h-3.5 fill-current group-hover:animate-heartbeat group-focus-visible:animate-heartbeat" aria-hidden="true">
          <use href="#icon-whatsapp" />
        </svg>
        <span>{CONFIG.contacto.whatsapp_display}</span>
      </a>
      <span aria-hidden="true">·</span>
      <a
        href="/estado"
        class="inline-flex items-center gap-1.5 hover:text-white focus-visible:text-white underline-offset-4 hover:underline focus-visible:underline outline-none rounded-sm focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark transition-all"
        aria-label="Seguimiento de reparaciones"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Seguimiento de reparaciones</span>
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="p-2 text-white/50 hover:text-white hover:bg-white/10 rounded-lg hover:scale-110 focus-visible:scale-110 focus-visible:ring-2 focus-visible:ring-white/40 outline-none transition-all duration-300" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="p-2 text-white/50 hover:text-white hover:bg-white/10 rounded-lg hover:scale-110 focus-visible:scale-110 focus-visible:ring-2 focus-visible:ring-white/40 outline-none transition-all duration-300" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 text-white/50 hover:text-white hover:bg-white/10 rounded-lg hover:scale-110 focus-visible:scale-110 focus-visible:ring-2 focus-visible:ring-white/40 outline-none transition-all duration-300" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/60">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
