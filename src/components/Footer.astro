---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="flex items-center gap-4 mb-4 group">
      <div class="relative w-[48px] h-[48px] flex-shrink-0 text-white">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-90 drop-shadow-sm group-hover:scale-105 transition-transform duration-300">
          <!-- Shield -->
          <path d="M 50 12 L 80 22 L 80 60 L 50 88 L 20 60 L 20 22 Z" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" />
          
          <!-- PCB Unit Area (Right side) -->
          <path d="M 57 55 V 36 H 68 V 55" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M 59 36 V 31 M 62.5 36 V 31 M 66 36 V 31" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          <path d="M 57 41 H 48 M 57 47 H 48" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />

          <!-- Right Arcs -->
          <path d="M 70 34 Q 73.5 34 73.5 37.5 M 69 28 Q 78 28 78 39" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />

          <!-- Left Arcs -->
          <path d="M 38 65 Q 32 65 32 59 M 41 71 Q 25 71 25 58" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />

          <!-- ECG Mask for dark background (#0a2248 is text-navy-dark) -->
          <path d="M 12 55 H 33 L 41 27 L 50 78 L 57 55 H 90" stroke="#0a2248" stroke-width="8" stroke-linejoin="round" stroke-linecap="round" />
          
          <!-- ECG Line -->
          <path d="M 17 55 H 33 L 41 27 L 50 78 L 57 55 H 85" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" />
          
          <!-- Dot -->
          <circle cx="15" cy="55" r="3.5" fill="currentColor" />
        </svg>
      </div>
      <div class="flex flex-col text-left justify-center mt-[-2px]">
        <span class="font-heading font-extrabold text-[24px] text-white leading-none tracking-wide">TechHealth</span>
        <span class="font-body font-medium text-[13px] text-white/70 mt-1.5 leading-none tracking-[0.05em] uppercase">Medical Engineering</span>
      </div>
    </div>
    
    <div class="font-body font-light text-[13px] text-white/50 mb-6">
      {CONFIG.empresa.ciudad}, {CONFIG.empresa.pais} · {CONFIG.contacto.whatsapp_display}
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/30">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
