---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-body font-light text-[13px] text-white/50 mb-6">
      <a href={CONFIG.contacto.maps_url} target="_blank" rel="noopener noreferrer" class="hover:text-white focus-visible:text-white transition-colors outline-none px-1 -mx-1" aria-label={`Ubicación: ${CONFIG.empresa.ciudad}, ${CONFIG.empresa.pais}. Abrir en Google Maps.`}>
        {CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}
      </a>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="hover:text-white focus-visible:text-white transition-colors outline-none px-1 -mx-1" aria-label={`WhatsApp: ${CONFIG.contacto.whatsapp_display}. Contactar ahora.`}>
        {CONFIG.contacto.whatsapp_display}
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="group text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 outline-none p-1" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5 transform group-hover:-translate-y-0.5 group-focus-visible:-translate-y-0.5 transition-transform" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="group text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 outline-none p-1" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5 transform group-hover:-translate-y-0.5 group-focus-visible:-translate-y-0.5 transition-transform" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="group text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 outline-none p-1" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5 transform group-hover:-translate-y-0.5 group-focus-visible:-translate-y-0.5 transition-transform" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/60">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
