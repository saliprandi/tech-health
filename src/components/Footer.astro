---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-x-6 gap-y-3 mb-6 font-body font-light text-[13px] text-white/70">
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-1.5 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 px-1 -mx-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        <svg class="w-3.5 h-3.5 text-blue-light group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2">
          <use href="#icon-whatsapp" />
        </svg>
        <span>{CONFIG.contacto.whatsapp_display}</span>
      </a>

      <span class="hidden sm:block w-1 h-1 rounded-full bg-white/20" aria-hidden="true"></span>

      <a
        href={CONFIG.contacto.maps_url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-1.5 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 px-1 -mx-1 outline-none focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm"
        aria-label={`Ver dirección en Google Maps: ${CONFIG.empresa.ciudad}, ${CONFIG.empresa.pais}`}
      >
        <svg class="w-3.5 h-3.5 text-blue-light group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2">
          <use href="#icon-map-pin" />
        </svg>
        <span>{CONFIG.empresa.ciudad}, {CONFIG.empresa.pais}</span>
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white focus-visible:text-white transition-all duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/60">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
