---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="font-body font-light text-[13px] text-white/50 mb-6 flex flex-wrap justify-center gap-x-2">
      <span>{CONFIG.empresa.ciudad}, {CONFIG.empresa.pais} ·</span>
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white focus-visible:text-white focus-visible:ring-1 focus-visible:ring-white/20 rounded-sm transition-colors outline-none"
        aria-label={`Contactar por WhatsApp: ${CONFIG.contacto.whatsapp_display}`}
      >
        {CONFIG.contacto.whatsapp_display}
      </a>
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {CONFIG.redes.instagram && (
          <a href={CONFIG.redes.instagram} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors" aria-label="Seguir en Instagram">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-instagram" />
            </svg>
          </a>
        )}
        {CONFIG.redes.facebook && (
          <a href={CONFIG.redes.facebook} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors" aria-label="Seguir en Facebook">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-facebook" />
            </svg>
          </a>
        )}
        {CONFIG.redes.linkedin && (
          <a href={CONFIG.redes.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white transition-colors" aria-label="Seguir en LinkedIn">
            <svg class="w-5 h-5" fill="currentColor">
              <use href="#icon-linkedin" />
            </svg>
          </a>
        )}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/60">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
