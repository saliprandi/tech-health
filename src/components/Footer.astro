---
import { CONFIG } from '../data/config';

const year = new Date().getFullYear();
const hasSocials = CONFIG.redes.instagram || CONFIG.redes.facebook || CONFIG.redes.linkedin;
---

<footer class="bg-navy-dark py-10 px-[5%] text-center border-t border-white/5">
  <div class="container-custom flex flex-col items-center">
    
    <div class="mb-8">
      <a href="#hero" class="inline-block group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-lg transition-shadow" aria-label="Volver al inicio">
        <img
          src="/logo-name.svg"
          alt={`${CONFIG.empresa.nombre} ${CONFIG.empresa.subtitulo}`}
          width="180"
          height="44"
          loading="lazy"
          decoding="async"
          class="h-11 w-auto brightness-0 invert opacity-70 group-hover:opacity-100 transition-opacity"
        />
      </a>
    </div>

    <div class="font-body font-light text-[13px] text-white/50 mb-6">
      {CONFIG.empresa.ciudad}, {CONFIG.empresa.pais} · {CONFIG.contacto.whatsapp_display}
    </div>

    {hasSocials && (
      <div class="flex items-center gap-4 mb-6">
        {['instagram', 'facebook', 'linkedin'].map(social => CONFIG.redes[social as keyof typeof CONFIG.redes] && (
          <a
            href={CONFIG.redes[social as keyof typeof CONFIG.redes]}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 hover:text-white focus-visible:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-dark rounded-full p-1"
            aria-label={`Seguir en ${social}`}
          >
            <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <use href={`#icon-${social}`} />
            </svg>
          </a>
        ))}
      </div>
    )}

    <div class="font-body font-light text-[12px] text-white/30">
      &copy; {year} {CONFIG.empresa.nombre} {CONFIG.empresa.subtitulo}. Todos los derechos reservados.
    </div>
  </div>
</footer>
