---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between relative">
    
    <!-- Logo -->
    <a href="#hero" class="flex items-center group" aria-label="TechHealth Home">
      <img src="/logo-name.svg" alt="TechHealth Medical Engineering" width="228" height="56" loading="eager" decoding="async" fetchpriority="high" class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
    </a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Contacto</a></li>
    </ul>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark transition-colors shadow-sm hover:shadow-md">
        Consultar por WhatsApp
      </a>

      <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 z-[101]"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300 pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
      </button>
    </div>

    <!-- Reading Progress Bar Container -->
    <div class="absolute bottom-0 left-0 w-full h-[2px] bg-transparent overflow-hidden">
      <div id="reading-progress" class="h-full bg-blue transition-transform duration-75 ease-out origin-left scale-x-0"></div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99] invisible" role="navigation" aria-label="Menú móvil">
    <a href="#servicios" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Servicios</a>
    <a href="#equipos" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Equipos</a>
    <a href="#nosotros" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Nosotros</a>
    <a href="#contacto" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="mobile-link mt-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px]">
      Consultar por WhatsApp
    </a>
  </div>
</nav>

<style>
  .nav-link-active {
    @apply text-blue !important;
  }
</style>

<script>
  let keyHandler: ((e: KeyboardEvent) => void) | null = null;
  let scrollHandler: (() => void) | null = null;

  function initNav() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const spans = toggle?.querySelectorAll('span');
    const progressBar = document.getElementById('reading-progress');

    let isOpen = false;
    let lastFocusedElement: HTMLElement | null = null;

    const toggleMenu = () => {
      isOpen = !isOpen;
      toggle?.setAttribute('aria-expanded', isOpen.toString());
      toggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

      if (isOpen) {
        lastFocusedElement = document.activeElement as HTMLElement;
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]', 'invisible');
        menu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = 'hidden';
        spans?.forEach((s, i) => {
          if (i === 0) s.classList.add('rotate-45', 'translate-y-[8px]');
          if (i === 1) s.classList.add('opacity-0');
          if (i === 2) s.classList.add('-rotate-45', '-translate-y-[8px]');
        });
        setTimeout(() => (menu?.querySelector('.mobile-link') as HTMLElement)?.focus(), 200);
      } else {
        menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = '';
        spans?.forEach((s, i) => {
          if (i === 0) s.classList.remove('rotate-45', 'translate-y-[8px]');
          if (i === 1) s.classList.remove('opacity-0');
          if (i === 2) s.classList.remove('-rotate-45', '-translate-y-[8px]');
        });
        lastFocusedElement?.focus();
        setTimeout(() => { if (!isOpen) menu?.classList.add('invisible'); }, 300);
      }
    };

    toggle?.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => link.addEventListener('click', () => isOpen && toggleMenu()));

    if (keyHandler) document.removeEventListener('keydown', keyHandler);
    keyHandler = (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key === 'Escape') { toggleMenu(); toggle?.focus(); }
      else if (e.key === 'Tab') {
        const focusables = [toggle, ...Array.from(mobileLinks)] as HTMLElement[];
        if (e.shiftKey && document.activeElement === focusables[0]) {
          e.preventDefault(); focusables[focusables.length - 1].focus();
        } else if (!e.shiftKey && document.activeElement === focusables[focusables.length - 1]) {
          e.preventDefault(); focusables[0].focus();
        }
      }
    };
    document.addEventListener('keydown', keyHandler);

    const updateProgress = () => {
      if (!progressBar) return;
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      progressBar.style.transform = `scale-x(${totalHeight > 0 ? Math.min(scrollY / totalHeight, 1) : 0})`;
    };

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    scrollHandler = updateProgress;
    window.addEventListener('scroll', scrollHandler, { passive: true });
    updateProgress();

    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('nav-link-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      });
    }, { rootMargin: '-30% 0px -70% 0px' });
    sections.forEach(s => observer.observe(s));
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
