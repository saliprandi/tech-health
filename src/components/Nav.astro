<style>
  .nav-link-active {
    @apply text-blue !important;
    position: relative;
  }

  .nav-link-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    @apply bg-blue rounded-full;
  }

  @media (max-width: 767px) {
    .nav-link-active::after {
      display: none;
    }
  }
</style>
