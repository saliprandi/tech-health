---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <a href="/" class="flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 rounded-lg transition-shadow" aria-label="Inicio de TechHealth">
      <img
        src="/logo-name.svg"
        alt="TechHealth Medical Engineering"
        width="228"
        height="56"
        decoding="async"
        fetchpriority="high"
        class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 group-focus-visible:scale-105 transition-transform duration-300"
      />
    </a>

    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm px-1 py-0.5">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm px-1 py-0.5">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm px-1 py-0.5">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm px-1 py-0.5">Contacto</a></li>
    </ul>

    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 transition-colors shadow-sm hover:shadow-md">
        Consultar por WhatsApp
      </a>

      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 rounded-sm transition-shadow z-[101]"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99]" aria-hidden="true">
    <a href="#servicios" class="mobile-link nav-link font-body font-medium text-[16px] text-text-soft hover:text-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm transition-colors">Servicios</a>
    <a href="#equipos" class="mobile-link nav-link font-body font-medium text-[16px] text-text-soft hover:text-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm transition-colors">Equipos</a>
    <a href="#nosotros" class="mobile-link nav-link font-body font-medium text-[16px] text-text-soft hover:text-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm transition-colors">Nosotros</a>
    <a href="#contacto" class="mobile-link nav-link font-body font-medium text-[16px] text-text-soft hover:text-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm transition-colors">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} id="whatsapp-mobile-link" target="_blank" rel="noopener noreferrer" class="mt-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 transition-colors">
      Consultar por WhatsApp
    </a>
  </div>
</nav>

<style>
  .nav-link-active {
    @apply text-blue !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const navLinks = document.querySelectorAll('.nav-link');
    const spans = toggle?.querySelectorAll('span');
    const whatsappMobileLink = document.getElementById('whatsapp-mobile-link');
    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      toggle?.setAttribute('aria-expanded', isOpen.toString());
      menu?.setAttribute('aria-hidden', (!isOpen).toString());
      if (isOpen) {
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        if (spans && spans.length === 3) {
          spans[0].classList.add('rotate-45', 'translate-y-[8px]');
          spans[1].classList.add('opacity-0');
          spans[2].classList.add('-rotate-45', '-translate-y-[8px]');
        }
      } else {
        menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        if (spans && spans.length === 3) {
          spans[0].classList.remove('rotate-45', 'translate-y-[8px]');
          spans[1].classList.remove('opacity-0');
          spans[2].classList.remove('-rotate-45', '-translate-y-[8px]');
        }
      }
    };

    toggle?.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => link.addEventListener('click', () => isOpen && toggleMenu()));

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') { toggleMenu(); toggle?.focus(); }
      if (e.key === 'Tab') {
        if (e.shiftKey && document.activeElement === toggle) { e.preventDefault(); (whatsappMobileLink as HTMLElement)?.focus(); }
        else if (!e.shiftKey && document.activeElement === whatsappMobileLink) { e.preventDefault(); toggle?.focus(); }
      }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('nav-link-active', isActive);
            isActive ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current');
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    ['servicios', 'equipos', 'nosotros', 'contacto'].forEach(id => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  });
</script>
