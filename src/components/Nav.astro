---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <a href="/" class="flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 rounded-lg transition-shadow" aria-label="Inicio">
      <img
        src="/logo-name.svg"
        alt={CONFIG.empresa.nombre}
        width="228"
        height="56"
        class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 transition-transform duration-300"
      />
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {['servicios', 'equipos', 'nosotros', 'contacto'].map(id => (
        <li>
          <a href={`#${id}`} class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 rounded-sm px-1 py-0.5 capitalize">
            {id}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 transition-colors">
        Consultar
      </a>

      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-4 rounded-sm z-[101]"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-all duration-300"></span>
        <span class="block w-6 h-0.5 bg-navy transition-all duration-300"></span>
        <span class="block w-6 h-0.5 bg-navy transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-md opacity-0 pointer-events-none transition-all duration-300 md:hidden z-[99]"
    aria-hidden="true"
  >
    {['servicios', 'equipos', 'nosotros', 'contacto'].map(id => (
      <a href={`#${id}`} class="mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy capitalize focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue rounded-sm px-2">{id}</a>
    ))}
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px]">
      Consultar
    </a>
  </div>
</nav>

<style>
  .nav-link-active { @apply text-blue !important; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const whatsappMobile = menu?.querySelector('a[href^="https://wa.me"]');
    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      toggle?.setAttribute('aria-expanded', isOpen.toString());
      menu?.setAttribute('aria-hidden', (!isOpen).toString());
      menu?.classList.toggle('opacity-0', !isOpen);
      menu?.classList.toggle('pointer-events-none', !isOpen);

      if (isOpen) {
        (mobileLinks[0] as HTMLElement)?.focus();
      } else {
        (toggle as HTMLElement)?.focus();
      }
    };

    toggle?.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    }));

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) toggleMenu();
    });

    // Focus trapping
    document.addEventListener('keydown', (e) => {
      if (!isOpen || e.key !== 'Tab') return;

      const focusable = [toggle, ...Array.from(mobileLinks), whatsappMobile].filter(Boolean) as HTMLElement[];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // ScrollSpy
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('nav-link-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    document.querySelectorAll('section[id]').forEach(section => observer.observe(section));
  });
</script>
