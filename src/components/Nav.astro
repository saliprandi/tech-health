---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#hero" class="flex items-center group outline-none" aria-label="TechHealth Home">
      <img src="/logo-name.svg" alt="TechHealth Medical Engineering" width="228" height="56" loading="eager" decoding="async" fetchpriority="high" class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 group-focus-visible:scale-105 transition-transform duration-300" />
    </a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Contacto</a></li>
    </ul>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" id="nav-cta" class="hidden md:inline-flex items-center gap-2 bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark transition-colors shadow-sm hover:shadow-md outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2">
        <svg class="nav-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="nav-cta-text">Consultar por WhatsApp</span>
        <svg class="nav-cta-icon w-3.5 h-3.5 text-white/50" fill="none" stroke="currentColor" aria-hidden="true">
          <use href="#icon-external" />
        </svg>
      </a>

      <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 z-[101] outline-none focus-visible:ring-2 focus-visible:ring-navy rounded-sm"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300 pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99] invisible" role="navigation" aria-label="Menú móvil">
    <a href="#servicios" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Servicios</a>
    <a href="#equipos" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Equipos</a>
    <a href="#nosotros" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Nosotros</a>
    <a href="#contacto" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn mt-2 flex items-center gap-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px] outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2" id="mobile-nav-cta">
      <svg class="nav-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="nav-cta-text">Consultar por WhatsApp</span>
      <svg class="nav-cta-icon w-3.5 h-3.5 text-white/50" fill="none" stroke="currentColor" aria-hidden="true">
        <use href="#icon-external" />
      </svg>
    </a>
  </div>

  <!-- Redirection Announcement -->
  <div id="nav-redirection-announcement" class="sr-only" aria-live="polite"></div>

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="absolute bottom-0 left-0 w-full h-[3px] bg-blue origin-left scale-x-0 pointer-events-none" aria-hidden="true"></div>
</nav>

<style>
  .nav-link-active {
    @apply text-blue !important;
  }

  #reading-progress {
    will-change: transform;
  }
</style>

<script>
  (function() {
    function initNav() {
      const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
      const menu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');
      const spans = toggle?.querySelectorAll('span');
      const navCta = document.getElementById('nav-cta');
      const mobileNavCta = document.getElementById('mobile-nav-cta');
      const progressBar = document.getElementById('reading-progress');
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-link');
      const redirectionAnnouncement = document.getElementById('nav-redirection-announcement');

      let isOpen = false;
      let isRedirecting = false;
      let lastFocusedElement: HTMLElement | null = null;
      let scrollHeight = 0;
      let ticking = false;

      if (!toggle || !menu || !progressBar) return () => {};

      const updateScrollHeight = () => {
        scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      };

      const toggleMenu = (forceClose = false) => {
        if (isRedirecting && !forceClose) return;
        if (forceClose) isOpen = false;
        else isOpen = !isOpen;

        toggle.setAttribute('aria-expanded', isOpen.toString());
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

        if (isOpen) {
          lastFocusedElement = document.activeElement as HTMLElement;
          menu.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]', 'invisible');
          menu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
          document.body.style.overflow = 'hidden';

          if (spans && spans.length === 3) {
            spans[0].classList.add('rotate-45', 'translate-y-[8px]');
            spans[1].classList.add('opacity-0');
            spans[2].classList.add('-rotate-45', '-translate-y-[8px]');
          }

          setTimeout(() => (menu.querySelector('.nav-link') as HTMLElement)?.focus(), 150);
        } else {
          menu.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
          menu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          document.body.style.overflow = '';

          if (spans && spans.length === 3) {
            spans[0].classList.remove('rotate-45', 'translate-y-[8px]');
            spans[1].classList.remove('opacity-0');
            spans[2].classList.remove('-rotate-45', '-translate-y-[8px]');
          }

          if (lastFocusedElement) lastFocusedElement.focus();
          setTimeout(() => { if (!isOpen) menu.classList.add('invisible'); }, 300);
        }
      };

      const handleKeydown = (e: KeyboardEvent) => {
        if (!isOpen) return;
        if (e.key === 'Escape') {
          toggleMenu(true);
          toggle.focus();
        }
        if (e.key === 'Tab') {
          const focusables = [toggle, ...Array.from(menu.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])') || [])] as HTMLElement[];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      };

      const updateProgress = () => {
        const winScroll = window.scrollY || document.documentElement.scrollTop;
        const scrolled = scrollHeight > 0 ? winScroll / scrollHeight : 0;
        progressBar.style.transform = `scaleX(${scrolled})`;
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateProgress);
          ticking = true;
        }
      };

      const handleLinkClick = () => {
        if (isOpen) toggleMenu();
      };

      const handleToggleClick = () => toggleMenu();

      const handleCtaClick = (e: MouseEvent) => {
        e.preventDefault();
        isRedirecting = true;
        const cta = e.currentTarget as HTMLElement;
        const span = cta.querySelector('.nav-cta-text');
        const spinner = cta.querySelector('.nav-spinner');
        const icon = cta.querySelector('.nav-cta-icon');

        if (!span || !spinner || !icon) return;

        const originalText = span.textContent;
        span.textContent = 'Redirigiendo...';
        spinner.classList.remove('hidden');
        icon.classList.add('hidden');
        cta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

        if (redirectionAnnouncement) {
          redirectionAnnouncement.textContent = 'Redirigiendo a WhatsApp...';
        }

        const href = cta.getAttribute('href');
        if (href) {
          const a = document.createElement('a');
          a.href = href;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }

        setTimeout(() => {
          isRedirecting = false;
          if (span) span.textContent = originalText;
          if (spinner) spinner.classList.add('hidden');
          if (icon) icon.classList.remove('hidden');
          if (cta) cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
          if (redirectionAnnouncement) redirectionAnnouncement.textContent = '';
        }, 3000);
      };

      const linkMap = new Map<string, Element>();
      navLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href) linkMap.set(href, link);
      });

      let currentActiveLink: Element | null = null;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            const targetHref = `#${id}`;
            const activeLink = linkMap.get(targetHref);

            if (activeLink && activeLink !== currentActiveLink) {
              if (currentActiveLink) {
                currentActiveLink.classList.remove('nav-link-active');
                currentActiveLink.removeAttribute('aria-current');
              }
              activeLink.classList.add('nav-link-active');
              activeLink.setAttribute('aria-current', 'location');
              currentActiveLink = activeLink;
            }
          }
        });
      }, { rootMargin: '-30% 0px -70% 0px' });

      toggle.addEventListener('click', handleToggleClick);
      mobileLinks.forEach(link => link.addEventListener('click', handleLinkClick));
      document.addEventListener('keydown', handleKeydown);
      navCta?.addEventListener('click', handleCtaClick as EventListener);
      mobileNavCta?.addEventListener('click', handleCtaClick as EventListener);
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateScrollHeight, { passive: true });
      sections.forEach(section => observer.observe(section));

      updateScrollHeight();
      updateProgress();

      return () => {
        toggle.removeEventListener('click', handleToggleClick);
        mobileLinks.forEach(link => link.removeEventListener('click', handleLinkClick));
        document.removeEventListener('keydown', handleKeydown);
        navCta?.removeEventListener('click', handleCtaClick as EventListener);
        mobileNavCta?.removeEventListener('click', handleCtaClick as EventListener);
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', updateScrollHeight);
        observer.disconnect();
        document.body.style.overflow = '';
      };
    }

    let cleanup = initNav();
    document.addEventListener('astro:after-swap', () => {
      if (cleanup) cleanup();
      cleanup = initNav();
    });
  })();
</script>
