---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#hero" class="flex items-center group" aria-label="TechHealth Home">
      <img src="/logo-name.svg" alt="TechHealth Medical Engineering" width="228" height="56" loading="eager" decoding="async" fetchpriority="high" class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
    </a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Contacto</a></li>
    </ul>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" id="nav-cta" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark transition-colors shadow-sm hover:shadow-md">
        Consultar por WhatsApp
      </a>

      <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 z-[101]"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300 pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
      </button>
    </div>
  </div>

  <!-- Reading Progress Bar -->
  <div class="absolute bottom-0 left-0 w-full h-[3px] bg-blue-pale overflow-hidden pointer-events-none" aria-hidden="true">
    <div id="progress-bar" class="h-full bg-blue-light w-0 transition-all duration-150 ease-out"></div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99] invisible" role="navigation" aria-label="Menú móvil">
    <a href="#servicios" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Servicios</a>
    <a href="#equipos" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Equipos</a>
    <a href="#nosotros" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Nosotros</a>
    <a href="#contacto" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="mobile-link mt-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px]" id="mobile-nav-cta">
      Consultar por WhatsApp
    </a>
  </div>
</nav>

<style>
  .nav-link-active {
    @apply text-blue !important;
  }
</style>

<script>
  let keydownHandler: ((e: KeyboardEvent) => void) | null = null;

  function initNav() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const spans = toggle?.querySelectorAll('span');
    const navCta = document.getElementById('nav-cta');
    const mobileNavCta = document.getElementById('mobile-nav-cta');
    const progressBar = document.getElementById('progress-bar');

    let isOpen = false;
    let lastFocusedElement: HTMLElement | null = null;

    const getFocusableElements = () => {
      if (!menu || !toggle) return [];
      const menuFocusables = Array.from(menu.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])'));
      return [toggle, ...menuFocusables] as HTMLElement[];
    };

    const toggleMenu = () => {
      isOpen = !isOpen;

      toggle?.setAttribute('aria-expanded', isOpen.toString());
      toggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

      if (isOpen) {
        lastFocusedElement = document.activeElement as HTMLElement;
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]', 'invisible');
        menu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = 'hidden';

        if (spans && spans.length === 3) {
          spans[0].classList.add('rotate-45', 'translate-y-[8px]');
          spans[1].classList.add('opacity-0');
          spans[2].classList.add('-rotate-45', '-translate-y-[8px]');
        }

        setTimeout(() => {
          const firstLink = menu?.querySelector('.mobile-link') as HTMLElement;
          firstLink?.focus();
        }, 150);

      } else {
        menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = '';

        if (spans && spans.length === 3) {
          spans[0].classList.remove('rotate-45', 'translate-y-[8px]');
          spans[1].classList.remove('opacity-0');
          spans[2].classList.remove('-rotate-45', '-translate-y-[8px]');
        }

        if (lastFocusedElement) lastFocusedElement.focus();

        setTimeout(() => {
          if (!isOpen) menu?.classList.add('invisible');
        }, 300);
      }
    };

    toggle?.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });

    // Keyboard Management (Focus Trap & Escape)
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler);
    }

    keydownHandler = (e: KeyboardEvent) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        toggleMenu();
        toggle?.focus();
        return;
      }

      if (e.key === 'Tab') {
        const focusables = getFocusableElements();
        if (focusables.length === 0) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    };

    document.addEventListener('keydown', keydownHandler);

    // WhatsApp Redirect Feedback
    const handleCtaClick = (e: MouseEvent) => {
      const cta = e.currentTarget as HTMLElement;
      const originalText = cta.textContent;
      cta.textContent = 'Redirigiendo...';
      cta.classList.add('opacity-70', 'cursor-not-allowed');
      setTimeout(() => {
        cta.textContent = originalText;
        cta.classList.remove('opacity-70', 'cursor-not-allowed');
      }, 3000);
    };

    navCta?.addEventListener('click', handleCtaClick as EventListener);
    mobileNavCta?.addEventListener('click', handleCtaClick as EventListener);

    // ScrollSpy
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -70% 0px',
      threshold: 0
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('nav-link-active');
              link.setAttribute('aria-current', 'location');
            } else {
              link.classList.remove('nav-link-active');
              link.removeAttribute('aria-current');
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach(section => observer.observe(section));

    // Progress Bar Logic
    const updateProgressBar = () => {
      if (!progressBar) return;
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      progressBar.style.width = scrolled + "%";
    };

    window.addEventListener('scroll', updateProgressBar);
    updateProgressBar();

    // Cleanup function for View Transitions
    return () => {
      if (keydownHandler) {
        document.removeEventListener('keydown', keydownHandler);
      }
      window.removeEventListener('scroll', updateProgressBar);
      observer.disconnect();
    };
  }

  let cleanup: (() => void) | undefined;
  document.addEventListener('DOMContentLoaded', () => {
    cleanup = initNav();
  });

  // Re-init on navigation (View Transitions)
  document.addEventListener('astro:after-swap', () => {
    if (cleanup) cleanup();
    cleanup = initNav();
  });
</script>
