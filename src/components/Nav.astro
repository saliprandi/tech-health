---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#hero" class="flex items-center group" aria-label="TechHealth Home">
      <img src="/logo-name.svg" alt="TechHealth Medical Engineering" width="228" height="56" loading="eager" decoding="async" fetchpriority="high" class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
    </a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Contacto</a></li>
    </ul>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" id="nav-cta" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark transition-colors shadow-sm hover:shadow-md">
        Consultar por WhatsApp
      </a>

      <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 z-[101]"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300 pointer-events-none"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center pointer-events-none"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99] invisible" role="navigation" aria-label="Menú móvil">
    <a href="#servicios" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Servicios</a>
    <a href="#equipos" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Equipos</a>
    <a href="#nosotros" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Nosotros</a>
    <a href="#contacto" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="mobile-link mt-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px]" id="mobile-nav-cta">
      Consultar por WhatsApp
    </a>
  </div>

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="absolute bottom-0 left-0 w-full h-[3px] bg-blue origin-left scale-x-0 transition-transform duration-150 ease-out pointer-events-none" aria-hidden="true"></div>
</nav>

<style>
  .nav-link-active {
    color: #2563a8 !important;
  }
</style>

<script>
  function initNav() {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var progress = document.getElementById('reading-progress');
    var mobileLinks = document.querySelectorAll('.mobile-link');
    var navLinks = document.querySelectorAll('.nav-link');
    var sections = document.querySelectorAll('section[id]');
    var navCta = document.getElementById('nav-cta');
    var mobileNavCta = document.getElementById('mobile-nav-cta');

    if (!toggle || !menu || !progress) return function() {};
    var spans = toggle.querySelectorAll('span');

    var isOpen = false;
    var lastFocusedElement = document.activeElement;

    function toggleMenu() {
      if (!toggle || !menu) return;
      isOpen = !isOpen;
      toggle.setAttribute('aria-expanded', isOpen.toString());
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

      if (isOpen) {
        lastFocusedElement = document.activeElement;
        menu.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]', 'invisible');
        menu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = 'hidden';
        if (spans) {
          for (var si = 0; si < spans.length; si++) {
            if (si === 0) { spans[si].classList.add('rotate-45', 'translate-y-[8px]'); }
            if (si === 1) { spans[si].classList.add('opacity-0'); }
            if (si === 2) { spans[si].classList.add('-rotate-45', '-translate-y-[8px]'); }
          }
        }
        setTimeout(function() {
          if (!menu) return;
          var el = menu.querySelector('.mobile-link');
          if (el instanceof HTMLElement) el.focus();
        }, 150);
      } else {
        menu.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        document.body.style.overflow = '';
        if (spans) {
          for (var si = 0; si < spans.length; si++) {
            if (si === 0) { spans[si].classList.remove('rotate-45', 'translate-y-[8px]'); }
            if (si === 1) { spans[si].classList.remove('opacity-0'); }
            if (si === 2) { spans[si].classList.remove('-rotate-45', '-translate-y-[8px]'); }
          }
        }
        if (lastFocusedElement instanceof HTMLElement) lastFocusedElement.focus();
        setTimeout(function() { if (!isOpen && menu) menu.classList.add('invisible'); }, 300);
      }
    }

    function handleKeydown() {
      var e = arguments.length > 0 ? arguments[0] : null;
      if (!e || typeof e.key !== 'string' || typeof e.preventDefault !== 'function') return;
      if (!isOpen) return;
      if (!toggle || !menu) return;
      if (e.key === 'Escape') { toggleMenu(); if (toggle) toggle.focus(); return; }
      if (e.key === 'Tab') {
        if (!toggle || !menu) return;
        var focusables = [];
        focusables.push(toggle);
        var q = menu.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
        for (var fi = 0; fi < q.length; fi++) {
          var item = q[fi];
          if (item && item.tagName !== 'svg' && item.tagName !== 'use') focusables.push(item);
        }
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (first instanceof HTMLElement && last instanceof HTMLElement) {
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }
    }

    function handleCtaClick() {
      var e = arguments.length > 0 ? arguments[0] : null;
      if (!e || typeof e.preventDefault !== 'function' || !e.currentTarget) return;
      var cta = e.currentTarget;
      var text = cta.querySelector('span') || cta;
      var original = text.textContent;
      text.textContent = 'Redirigiendo...';
      cta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
      setTimeout(function() { text.textContent = original; cta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none'); }, 3000);
    }

    function updateProgress() {
      if (!progress) return;
      var h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      progress.style.transform = 'scaleX(' + (h > 0 ? window.scrollY / h : 0) + ')';
    }

    var observer = new IntersectionObserver(function(entries) {
      for (var ei = 0; ei < entries.length; ei++) {
        var entry = entries[ei];
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          for (var ni = 0; ni < navLinks.length; ni++) {
            var link = navLinks[ni];
            if (link.getAttribute('href') === '#' + id) {
              link.classList.add('nav-link-active');
              link.setAttribute('aria-current', 'location');
            } else {
              link.classList.remove('nav-link-active');
              link.removeAttribute('aria-current');
            }
          }
        }
      }
    }, { rootMargin: '-30% 0px -70% 0px' });

    toggle.addEventListener('click', toggleMenu);
    for (var mi = 0; mi < mobileLinks.length; mi++) {
      mobileLinks[mi].addEventListener('click', function() { if (isOpen) toggleMenu(); });
    }
    document.addEventListener('keydown', handleKeydown);
    if (navCta) navCta.addEventListener('click', handleCtaClick);
    if (mobileNavCta) mobileNavCta.addEventListener('click', handleCtaClick);
    window.addEventListener('scroll', updateProgress, { passive: true });
    for (var si2 = 0; si2 < sections.length; si2++) { observer.observe(sections[si2]); }
    updateProgress();

    return function() {
      if (!toggle || !menu || !progress) return;
      toggle.removeEventListener('click', toggleMenu);
      for (var mi2 = 0; mi2 < mobileLinks.length; mi2++) {
        mobileLinks[mi2].removeEventListener('click', toggleMenu);
      }
      document.removeEventListener('keydown', handleKeydown);
      if (navCta) navCta.removeEventListener('click', handleCtaClick);
      if (mobileNavCta) mobileNavCta.removeEventListener('click', handleCtaClick);
      window.removeEventListener('scroll', updateProgress);
      observer.disconnect();
      document.body.style.overflow = '';
    };
  }

  var cleanup = initNav();
  document.addEventListener('astro:after-swap', function() { if (cleanup) cleanup(); cleanup = initNav(); });
</script>
