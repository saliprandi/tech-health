---
import { CONFIG } from '../data/config';
---

<nav class="fixed top-0 left-0 w-full z-[100] h-[68px] bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300">
  <div class="container-custom h-full px-[5%] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#hero" class="flex items-center group" aria-label="TechHealth Home">
      <img src="/logo-name.svg" alt="TechHealth Medical Engineering" width="228" height="56" loading="eager" decoding="async" fetchpriority="high" class="h-[56px] w-auto drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
    </a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      <li><a href="#servicios" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Servicios</a></li>
      <li><a href="#equipos" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Equipos</a></li>
      <li><a href="#nosotros" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Nosotros</a></li>
      <li><a href="#contacto" class="nav-link font-body font-medium text-[14px] text-text-soft hover:text-navy transition-colors">Contacto</a></li>
    </ul>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex bg-navy text-white font-heading font-bold text-[14px] py-[10px] px-[20px] rounded-[8px] hover:bg-navy-dark transition-colors shadow-sm hover:shadow-md">
        Consultar por WhatsApp
      </a>

      <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus:outline-none z-[101]"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center"></span>
        <span class="block w-6 h-0.5 bg-navy transition-opacity duration-300"></span>
        <span class="block w-6 h-0.5 bg-navy transition-transform duration-300 origin-center"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="absolute top-[68px] left-0 w-full bg-white border-b border-border flex flex-col items-center py-6 gap-6 shadow-card-hover opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 ease-in-out md:hidden z-[99] invisible" role="navigation" aria-label="Menú móvil">
    <a href="#servicios" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Servicios</a>
    <a href="#equipos" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Equipos</a>
    <a href="#nosotros" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Nosotros</a>
    <a href="#contacto" class="nav-link mobile-link font-body font-medium text-[16px] text-text-soft hover:text-navy">Contacto</a>
    <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="mt-2 bg-navy text-white font-heading font-bold text-[14px] py-[12px] px-[24px] rounded-[8px]">
      Consultar por WhatsApp
    </a>
  </div>
</nav>

<style>
  .nav-link-active {
    @apply text-blue !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const spans = toggle?.querySelectorAll('span');

    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;

      toggle?.setAttribute('aria-expanded', isOpen.toString());
      toggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

      if (isOpen) {
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]', 'invisible');
        menu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        if (spans) {
          spans[0].classList.add('rotate-45', 'translate-y-[8px]');
          spans[1].classList.add('opacity-0');
          spans[2].classList.add('-rotate-45', '-translate-y-[8px]');
        }
      } else {
        menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        menu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        if (spans) {
          spans[0].classList.remove('rotate-45', 'translate-y-[8px]');
          spans[1].classList.remove('opacity-0');
          spans[2].classList.remove('-rotate-45', '-translate-y-[8px]');
        }
        // Add invisible after transition
        setTimeout(() => {
          if (!isOpen) menu?.classList.add('invisible');
        }, 300);
      }
    };

    toggle?.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });

    // Handle Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu();
        toggle?.focus();
      }
    });

    // ScrollSpy Logic
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -70% 0px',
      threshold: 0
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('nav-link-active');
              link.setAttribute('aria-current', 'location');
            } else {
              link.classList.remove('nav-link-active');
              link.removeAttribute('aria-current');
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach(section => observer.observe(section));
  });
</script>
