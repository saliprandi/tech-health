---
import { CONFIG } from '../data/config';

const { proceso } = CONFIG;
---

<section id="proceso" class="section-padding bg-slate-50 relative overflow-hidden content-visibility-auto scroll-mt-16">
  <!-- Elementos decorativos sutiles de fondo -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-light/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-navy/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-custom relative z-10">
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue/10 text-navy font-heading font-semibold text-xs uppercase tracking-wider mb-4 border border-blue/20">
        <svg class="w-3.5 h-3.5 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {proceso.badge}
      </span>
      <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-navy tracking-tight mb-4">
        {proceso.titulo}
      </h2>
      <p class="font-body text-text-soft text-base sm:text-lg leading-relaxed">
        {proceso.subtitulo}
      </p>
    </div>

    <!-- Grid de Pasos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {proceso.pasos.map((item, index) => (
        <article class="bg-white rounded-xl p-6 shadow-sm border border-border hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Header de Card con Número y Línea de Conexión -->
            <div class="flex items-center justify-between mb-6">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-navy/5 text-navy font-heading font-bold text-xl group-hover:bg-navy group-hover:text-white transition-colors duration-300">
                {item.paso}
              </span>
              <span class="text-xs font-semibold text-blue bg-blue-light/30 px-2.5 py-1 rounded-md border border-blue-light/50">
                Paso {index + 1} de {proceso.pasos.length}
              </span>
            </div>

            <!-- Título y Descripción -->
            <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-blue transition-colors">
              {item.titulo}
            </h3>
            <p class="font-body text-text-soft text-sm leading-relaxed mb-6">
              {item.descripcion}
            </p>
          </div>

          <!-- Highlight/Destacado para B2B -->
          <div class="pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-medium text-navy/80">
            <svg class="w-4 h-4 text-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>{item.destacado}</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Banner B2B Informativo inferior -->
    <div class="mt-12 bg-navy text-white rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-lg">
      <div class="flex items-start gap-4">
        <div class="p-3 bg-white/10 rounded-xl shrink-0 hidden sm:block">
          <svg class="w-6 h-6 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <h4 class="font-heading font-bold text-lg text-white mb-1">
            ¿Necesita auditoría técnica para su institución de salud?
          </h4>
          <p class="font-body text-slate-300 text-sm max-w-2xl">
            Emitimos certificados de calibración e informes detallados del historial de intervención requeridos por los organismos reguladores.
          </p>
        </div>
      </div>
      <a
        href={`https://wa.me/${CONFIG.contacto.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Hola, me comunico de una institución médica y quisiera consultar por informes técnicos para auditoría.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-blue text-white font-heading font-semibold text-sm px-5 py-3 rounded-xl hover:bg-blue-dark transition-colors shrink-0 shadow-md outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
      >
        <span>Solicitar Protocolo</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <use href="#icon-external" />
        </svg>
      </a>
    </div>
  </div>
</section>
