---
import { CONFIG } from '../data/config';
---

<section id="proceso" class="bg-white section-padding content-visibility-auto border-t border-border">
  <div class="container-custom">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="font-heading font-bold text-blue tracking-wide uppercase text-[12px] mb-3">Metodología de Trabajo</div>
      <h2 class="font-heading font-extrabold text-[clamp(28px,4vw,38px)] leading-[1.2] text-navy mb-4">
        Nuestro Proceso de Servicio Técnico
      </h2>
      <p class="font-body text-[16px] text-text-soft">
        Un flujo de trabajo transparente, riguroso y certificado diseñado para minimizar el tiempo fuera de servicio de sus equipos médicos.
      </p>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 list-none p-0" aria-label="Pasos del proceso de servicio técnico">
      {CONFIG.proceso.map((item) => (
        <li class="relative group bg-off-white rounded-card p-8 border border-border/80 shadow-sm hover:shadow-card-hover hover:border-blue/30 focus-within:border-blue/30 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-heading font-black text-[28px] text-blue/30 group-hover:text-blue group-focus-within:text-blue group-focus-visible:text-blue transition-colors duration-300">
                {item.paso}
              </span>
              <div class="w-12 h-12 rounded-xl bg-blue-pale text-blue flex items-center justify-center group-hover:scale-110 group-focus-within:scale-110 group-focus-visible:scale-110 transition-transform">
                <svg class="w-6 h-6 group-hover:animate-heartbeat group-focus-within:animate-heartbeat group-focus-visible:animate-heartbeat" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <use href={`#icon-${item.icono}`} />
                </svg>
              </div>
            </div>
            <h3 class="font-heading font-bold text-[18px] text-navy mb-3">{item.titulo}</h3>
            <p class="font-body font-light text-[14px] text-text-soft leading-relaxed">
              {item.descripcion}
            </p>
          </div>
        </li>
      ))}
    </ol>

    <!-- CTA: Seguimiento de ticket -->
    <div class="mt-12 bg-navy rounded-card p-8 md:p-10 shadow-card-hover">
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-8">
        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-blue-pale text-blue flex items-center justify-center">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <div class="flex-grow text-center md:text-left">
          <h3 class="font-heading font-extrabold text-[20px] text-white mb-1">¿Ya dejó su equipo?</h3>
          <p class="font-body text-[14px] text-white/60">Ingrese su número de ticket y vea el estado de su reparación en tiempo real.</p>
        </div>
        <form id="proceso-estado-form" class="flex flex-col sm:flex-row gap-3 w-full md:w-auto" action="/estado" method="GET">
          <label for="proceso-ticket-input" class="sr-only">Número de ticket</label>
          <input
            type="text"
            id="proceso-ticket-input"
            name="ticket"
            placeholder="Ej: TH-2026-1234"
            class="bg-white/10 border border-white/20 rounded-[8px] px-4 py-3 text-white w-full md:w-[200px] placeholder:text-white/30 focus-visible:ring-2 focus-visible:ring-blue-light outline-none uppercase"
            autocomplete="off"
          />
          <button type="submit" class="group bg-white text-navy font-heading font-bold text-[14px] py-3 px-6 rounded-[8px] hover:bg-white/90 active:scale-[0.98] transition-all flex items-center justify-center gap-2 outline-none focus-visible:ring-2 focus-visible:ring-blue-light whitespace-nowrap">
            <span>Consultar estado</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 group-focus-visible:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
