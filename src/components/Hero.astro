---
import { CONFIG } from '../data/config';

const equiposHero = CONFIG.equipos_atendidos.slice(0, 5);
---

<section id="hero" class="relative min-h-screen bg-off-white flex items-center pt-[68px] overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute -top-[10%] -right-[10%] w-[600px] h-[600px] rounded-full bg-blue-light/5 blur-3xl pointer-events-none"></div>

  <div class="container-custom section-padding relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-[80px] items-center">
    
    <!-- Left Column -->
    <div class="flex flex-col items-start gap-6">
      
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-blue-pale text-blue font-heading font-bold text-[12px] uppercase tracking-wider py-2 px-4 rounded-full" aria-label={`Ubicación: ${CONFIG.empresa.ciudad}, ${CONFIG.empresa.pais}`}>
        <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue"></span>
        </span>
        {CONFIG.empresa.ciudad} · {CONFIG.empresa.pais}
      </div>

      <!-- H1 -->
      <h1 class="font-heading font-extrabold text-[clamp(38px,5vw,60px)] leading-[1.15] text-navy tracking-[-1.5px]">
        Cuidamos los equipos que <br />
        <em class="not-italic text-blue">cuidan vidas</em>
      </h1>

      <!-- Paragraph -->
      <p class="font-body font-light text-[17px] text-text-soft max-w-[540px]">
        {CONFIG.empresa.descripcion}
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap items-center gap-4 mt-2">
        <a id="hero-cta" href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-primary gap-2">
          <svg class="w-5 h-5 fill-current">
            <use href="#icon-whatsapp" />
          </svg>
          <span id="hero-cta-text">Solicitar servicio</span>
        </a>
        <a href="#servicios" class="btn-secondary">
          Ver servicios
        </a>
      </div>

    </div>

    <!-- Right Column (Card) -->
    <div class="hidden lg:block">
      <div class="bg-white rounded-card p-10 shadow-hero-card">
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-6 mb-8 pb-8 border-b border-border">
          {CONFIG.stats.map(stat => (
            <div>
              <div class="font-heading font-extrabold text-[42px] text-navy leading-none mb-1">{stat.numero}</div>
              <div class="font-body font-medium text-[12px] text-text-soft uppercase tracking-wide">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- Equipos List -->
        <div>
          <h4 class="font-heading font-bold text-navy text-[16px] mb-4">Equipos que atendemos:</h4>
          <ul class="flex flex-col gap-3">
            {equiposHero.map(equipo => (
              <li class="flex items-start gap-3 font-body text-text-soft text-[15px]">
                <span class="w-1.5 h-1.5 rounded-full bg-blue mt-2 flex-shrink-0"></span>
                {equipo}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  function initHero() {
    const heroCta = document.getElementById('hero-cta');
    const heroCtaText = document.getElementById('hero-cta-text');

    if (!heroCta || !heroCtaText) return () => {};

    const handleCtaClick = () => {
      const originalText = heroCtaText.textContent;
      heroCtaText.textContent = 'Redirigiendo...';
      heroCta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

      setTimeout(() => {
        if (heroCtaText) heroCtaText.textContent = originalText;
        if (heroCta) heroCta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
      }, 3000);
    };

    heroCta.addEventListener('click', handleCtaClick);

    return () => {
      heroCta.removeEventListener('click', handleCtaClick);
    };
  }

  let cleanup = initHero();
    if (heroCta && heroCtaText) {
      const handleCtaClick = () => {
        const originalText = heroCtaText.textContent;
        heroCtaText.textContent = 'Redirigiendo...';
        heroCta.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');

        setTimeout(() => {
          if (heroCtaText) heroCtaText.textContent = originalText;
          if (heroCta) heroCta.classList.remove('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
        }, 3000);
      };

      heroCta.addEventListener('click', handleCtaClick);

      return () => {
        heroCta.removeEventListener('click', handleCtaClick);
      };
    }
    return () => {};
  }

  let cleanup: (() => void) | undefined;

  document.addEventListener('DOMContentLoaded', () => {
    cleanup = initHero();
  });
  document.addEventListener('DOMContentLoaded', () => { cleanup = initHero(); });
  cleanup = initHero();

  document.addEventListener('astro:after-swap', () => {
    if (cleanup) cleanup();
    cleanup = initHero();
  });

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    cleanup = initHero();
  }
</script>
