---
import { CONFIG } from '../data/config';

const equiposHero = CONFIG.equipos_atendidos.slice(0, 5);
---

<section id="hero" class="relative min-h-screen bg-off-white flex items-center pt-[68px] overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute -top-[10%] -right-[10%] w-[600px] h-[600px] rounded-full bg-blue-light/5 blur-3xl pointer-events-none"></div>

  <div class="container-custom section-padding relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-[80px] items-center">
    
    <!-- Left Column -->
    <div class="flex flex-col items-start gap-6">
      
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-blue-pale text-blue font-heading font-bold text-[12px] uppercase tracking-wider py-2 px-4 rounded-full">
        <span class="w-2 h-2 rounded-full bg-blue"></span>
        {CONFIG.empresa.ciudad} · {CONFIG.empresa.pais}
      </div>

      <!-- H1 -->
      <h1 class="font-heading font-extrabold text-[clamp(38px,5vw,60px)] leading-[1.15] text-navy tracking-[-1.5px]">
        Cuidamos los equipos que <br />
        <em class="not-italic text-blue">cuidan vidas</em>
      </h1>

      <!-- Paragraph -->
      <p class="font-body font-light text-[17px] text-text-soft max-w-[540px]">
        {CONFIG.empresa.descripcion}
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap items-center gap-4 mt-2">
        <a href={`https://wa.me/${CONFIG.contacto.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-primary gap-2">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Solicitar servicio
        </a>
        <a href="#servicios" class="btn-secondary">
          Ver servicios
        </a>
      </div>

    </div>

    <!-- Right Column (Card) -->
    <div class="hidden lg:block">
      <div class="bg-white rounded-card p-10 shadow-hero-card">
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-6 mb-8 pb-8 border-b border-border">
          {CONFIG.stats.map(stat => (
            <div>
              <div class="font-heading font-extrabold text-[42px] text-navy leading-none mb-1">{stat.numero}</div>
              <div class="font-body font-medium text-[12px] text-text-soft uppercase tracking-wide">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- Equipos List -->
        <div>
          <h4 class="font-heading font-bold text-navy text-[16px] mb-4">Equipos que atendemos:</h4>
          <ul class="flex flex-col gap-3">
            {equiposHero.map(equipo => (
              <li class="flex items-start gap-3 font-body text-text-soft text-[15px]">
                <span class="w-1.5 h-1.5 rounded-full bg-blue mt-2 flex-shrink-0"></span>
                {equipo}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

  </div>
</section>
